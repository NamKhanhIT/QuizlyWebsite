@model IEnumerable<QuizlyWebsite.Models.TbLesson>

@{
    ViewData["Title"] = "Quản Lý Bài Học";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var courseId = ViewData["CourseId"] as int?;
    var course = ViewData["Course"] as QuizlyWebsite.Models.TbCourse;
}

<div class="flex justify-between items-center mb-8">
    <div>
        <h2 class="text-3xl font-bold">Quản Lý Bài Học</h2>
        @if (course != null)
        {
            <p class="text-[#4c739a] dark:text-slate-400 mt-2">Khóa học: @course.Title</p>
        }
    </div>
    <a asp-action="Create" asp-route-courseId="@courseId" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition flex items-center gap-2">
        <span class="material-symbols-outlined">add_circle</span>
        Thêm Bài Học
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="px-6 py-4 text-left text-sm font-semibold">ID</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Tiêu Đề</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Khóa Học</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Loại</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Trạng Thái</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Ngày Tạo</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@item.Id</td>
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@item.Title</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@item.Course?.Title</td>
                        <td class="px-6 py-4">
                            @if (item.IsPreview == true)
                            {
                                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">Xem thử miễn phí</span>
                            }
                            else
                            {
                                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200">Yêu cầu thành viên</span>
                            }
                        </td>
                        <td class="px-6 py-4">
                            @if (item.IsApproved == true)
                            {
                                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-success/20 text-success">Đã duyệt</span>
                            }
                            else
                            {
                                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-warning/20 text-warning">Chờ duyệt</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(item.CreatedAt?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                        <td class="px-6 py-4">
                            <div class="flex gap-3">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-blue-500 hover:text-blue-700 p-1 rounded" title="Chi tiết">
                                    <span class="material-symbols-outlined text-xl">info</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary hover:text-primary-dark p-1 rounded" title="Chỉnh sửa">
                                    <span class="material-symbols-outlined text-xl">edit</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger hover:text-red-700 p-1 rounded" title="Xóa">
                                    <span class="material-symbols-outlined text-xl">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">menu_book</span>
        <p class="text-[#4c739a] dark:text-slate-400">Chưa có bài học nào. <a asp-action="Create" asp-route-courseId="@courseId" class="text-primary hover:underline">Tạo bài học mới</a></p>
    </div>
}

