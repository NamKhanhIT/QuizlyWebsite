@model QuizlyWebsite.Models.TbLesson

@{
    ViewData["Title"] = "Chỉnh Sửa Bài Học";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="mb-8">
    <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">Chỉnh Sửa Bài Học</h2>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8 max-w-3xl">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        
        <div class="mb-6">
            <label asp-for="CourseId" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Khóa Học
            </label>
            <select asp-for="CourseId" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" asp-items="ViewBag.CourseId"></select>
            <span asp-validation-for="CourseId" class="text-danger text-sm"></span>

            @if (ViewData["Course"] != null)
            {
                var course = ViewData["Course"] as QuizlyWebsite.Models.TbCourse;
                if (course != null)
                {
                    <div class="mt-2 p-3 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
                        <div class="text-sm text-blue-800 dark:text-blue-200">
                            <strong>Thông tin khóa học:</strong>
                            <span class="ml-2 px-2 py-1 text-xs rounded-full @((course.IsPaid ?? false) ? "bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400" : "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400")">
                                @((course.IsPaid ?? false) ? "Trả Phí" : "Miễn Phí")
                            </span>
                            @if (course.IsPaid ?? false)
                            {
                                <span class="ml-2">• Số bài học preview: @(course.FreeLessonCount ?? 0)</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="mb-6">
            <label asp-for="Title" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Tiêu Đề
            </label>
            <input asp-for="Title" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
            <span asp-validation-for="Title" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Content" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Nội Dung
            </label>
            <textarea asp-for="Content" rows="10" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"></textarea>
            <span asp-validation-for="Content" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label class="flex items-center gap-2">
                <input type="checkbox" name="IsApproved" value="true" @(Model.IsApproved == true ? "checked" : "") class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary" />
                <span class="text-sm font-semibold text-[#0d141b] dark:text-slate-50">Đã duyệt</span>
            </label>
        </div>

        <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Trạng Thái Preview
            </label>
            <div class="p-4 bg-gray-50 dark:bg-gray-700 rounded-lg border border-gray-200 dark:border-gray-600">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">info</span>
                    <span class="text-sm text-gray-700 dark:text-gray-300">
                        Trạng thái preview sẽ được tự động xác định dựa trên loại khóa học và vị trí bài học.
                        @if (ViewData["Course"] != null)
                        {
                            var course = ViewData["Course"] as QuizlyWebsite.Models.TbCourse;
                            if (course != null)
                            {
                                if (!(course.IsPaid ?? false))
                                {
                                    <strong class="text-green-600 dark:text-green-400">Bài học này là preview (khóa học miễn phí).</strong>
                                }
                                else
                                {
                                    var currentPreviewStatus = Model.IsPreview ?? false;
                                    <strong class="@(currentPreviewStatus ? "text-green-600 dark:text-green-400" : "text-orange-600 dark:text-orange-400")">
                                        Bài học này @(currentPreviewStatus ? "là" : "không phải là") preview.
                                    </strong>
                                    <span class="text-xs block mt-1">
                                        Khóa học trả phí với @(course.FreeLessonCount ?? 0) bài học preview được phép.
                                    </span>
                                }
                            }
                        }
                    </span>
                </div>
            </div>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                Cập Nhật
            </button>
            <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
                Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

