@model QuizlyWebsite.Models.TbContact

@{
    ViewData["Title"] = "Chỉnh Sửa Liên Hệ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="mb-8">
    <a asp-action="Index" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">Chỉnh Sửa Liên Hệ</h2>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8 max-w-2xl">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        
        <div class="mb-6">
            <label asp-for="Name" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Họ Tên</label>
            <input asp-for="Name" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
            <span asp-validation-for="Name" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Email" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Email</label>
            <input asp-for="Email" type="email" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
            <span asp-validation-for="Email" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Phone" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Số Điện Thoại</label>
            <input asp-for="Phone" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
            <span asp-validation-for="Phone" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Subject" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Chủ Đề</label>
            <input asp-for="Subject" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
            <span asp-validation-for="Subject" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Message" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Tin Nhắn</label>
            <textarea asp-for="Message" rows="4" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"></textarea>
            <span asp-validation-for="Message" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Response" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Phản Hồi</label>
            <textarea asp-for="Response" rows="4" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"></textarea>
            <span asp-validation-for="Response" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label class="flex items-center gap-2">
                <input type="checkbox" name="IsRead" value="true" @(Model.IsRead == true ? "checked" : "") class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary" />
                <input type="hidden" name="IsRead" value="false" />
                <span class="text-sm font-semibold text-[#0d141b] dark:text-slate-50">Đã đọc</span>
            </label>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                Cập Nhật
            </button>
            <a asp-action="Index" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
                Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

