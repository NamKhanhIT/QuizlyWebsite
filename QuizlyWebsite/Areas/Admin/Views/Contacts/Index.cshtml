@model IEnumerable<QuizlyWebsite.Models.TbContact>

@{
    ViewData["Title"] = "Quản Lý Liên Hệ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var filter = ViewData["Filter"] as string ?? "all";
    var unreadCount = Model.Count(c => c.IsRead != true);
}

<div class="flex justify-between items-center mb-8">
    <div>
        <h2 class="text-3xl font-bold mb-2">Quản Lý Liên Hệ</h2>
        <p class="text-[#4c739a] dark:text-slate-400">Quản lý tin nhắn từ người dùng</p>
    </div>
    @if (unreadCount > 0)
    {
        <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg px-4 py-2 flex items-center gap-2">
            <span class="material-symbols-outlined">mail</span>
            <span class="font-semibold">@unreadCount tin nhắn chưa đọc</span>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Error"]</p>
    </div>
}

<div class="flex gap-3 mb-6">
    <a asp-action="Index" asp-route-filter="all" 
       class="px-4 py-2 rounded-lg font-semibold transition @(filter == "all" ? "bg-primary text-white" : "bg-gray-100 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 hover:bg-gray-200 dark:hover:bg-gray-600")">
        Tất Cả
    </a>
    <a asp-action="Index" asp-route-filter="unread" 
       class="px-4 py-2 rounded-lg font-semibold transition @(filter == "unread" ? "bg-primary text-white" : "bg-gray-100 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 hover:bg-gray-200 dark:hover:bg-gray-600")">
        Chưa Đọc (@unreadCount)
    </a>
    <a asp-action="Index" asp-route-filter="read" 
       class="px-4 py-2 rounded-lg font-semibold transition @(filter == "read" ? "bg-primary text-white" : "bg-gray-100 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 hover:bg-gray-200 dark:hover:bg-gray-600")">
        Đã Đọc
    </a>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Trạng Thái</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Họ Tên</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Email</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Chủ Đề</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Ngày Gửi</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition @(item.IsRead != true ? "bg-blue-50/50 dark:bg-blue-900/10" : "")">
                        <td class="px-6 py-4">
                            @if (item.IsRead == true)
                            {
                                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-success/20 text-success">Đã đọc</span>
                            }
                            else
                            {
                                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-danger/20 text-danger">Chưa đọc</span>
                            }
                        </td>
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@item.Name</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@item.Email</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@item.Subject</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(item.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                        <td class="px-6 py-4">
                            <div class="flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-primary hover:text-primary-dark" title="Chi tiết">
                                    <span class="material-symbols-outlined text-sm">info</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-blue-500 hover:text-blue-700" title="Chỉnh sửa">
                                    <span class="material-symbols-outlined text-sm">edit</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger hover:text-red-700" title="Xóa">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">mail</span>
        <p class="text-[#4c739a] dark:text-slate-400">Chưa có liên hệ nào.</p>
    </div>
}

