@model IEnumerable<QuizlyWebsite.Models.TbCategory>

@{
    ViewData["Title"] = "Quản Lý Danh Mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="flex justify-between items-center mb-8">
    <h2 class="text-3xl font-bold">Danh Sách Danh Mục</h2>
    <a asp-action="Create" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition flex items-center gap-2">
        <span class="material-symbols-outlined">add_circle</span>
        Thêm Danh Mục
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6 animate-fade-in">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined">check_circle</span>
            <p class="text-sm font-semibold">@TempData["Success"]</p>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6 animate-fade-in">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined">error</span>
            <p class="text-sm font-semibold">@TempData["Error"]</p>
        </div>
    </div>
}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    @foreach (var item in Model)
    {
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:shadow-lg transition">
            <div class="flex items-start justify-between mb-3">
                <h3 class="text-lg font-bold text-[#0d141b] dark:text-slate-50">@item.Title</h3>
                <div class="flex gap-2">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary hover:text-primary-dark" title="Chỉnh sửa">
                        <span class="material-symbols-outlined text-sm">edit</span>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="text-blue-500 hover:text-blue-700" title="Chi tiết">
                        <span class="material-symbols-outlined text-sm">info</span>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger hover:text-red-700" title="Xóa">
                        <span class="material-symbols-outlined text-sm">delete</span>
                    </a>
                </div>
            </div>

            <p class="text-[#4c739a] dark:text-slate-400 text-sm mb-4">ID: @item.Id</p>

            <div class="flex items-center justify-between text-xs text-[#4c739a] dark:text-slate-400">
                <span class="material-symbols-outlined text-sm align-middle">calendar_today</span>
                <span>@(item.CreatedAt?.ToString("dd/MM/yyyy") ?? "N/A")</span>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">folder_open</span>
        <p class="text-[#4c739a] dark:text-slate-400">Chưa có danh mục nào. <a asp-action="Create" class="text-primary hover:underline">Tạo danh mục mới</a></p>
    </div>
}

