<!-- Sidebar -->
<aside class="w-64 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 h-screen sticky top-0 overflow-y-auto">
    <div class="p-6">
        <!-- Logo -->
        <a href="/admin" class="flex items-center gap-2 mb-8">
            <span class="material-symbols-outlined text-primary text-2xl">dashboard_customize</span>
            <span class="font-black text-lg text-[#0d141b] dark:text-slate-50">Admin</span>
        </a>

        <!-- Navigation Menu -->
        <nav class="space-y-1">
            <!-- Dashboard -->
            <a href="/admin" class="flex items-center gap-3 px-4 py-3 rounded-lg text-[#0d141b] dark:text-slate-50 hover:bg-primary/10 transition @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "bg-primary/10 border-l-4 border-primary" : "")">
                <span class="material-symbols-outlined">dashboard</span>
                <span class="font-medium">Dashboard</span>
            </a>

            <!-- Quản Lý Đề Thi -->
            <a asp-area="Admin" asp-controller="Exams" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-[#0d141b] dark:text-slate-50 hover:bg-primary/10 transition @(ViewContext.RouteData.Values["controller"]?.ToString() == "Exams" ? "bg-primary/10 border-l-4 border-primary" : "")">
                <span class="material-symbols-outlined">library_books</span>
                <span class="font-medium">Quản Lý Đề Thi</span>
            </a>

            <!-- Quản Lý Khóa Học -->
            <a href="/admin/courses" class="flex items-center gap-3 px-4 py-3 rounded-lg text-[#0d141b] dark:text-slate-50 hover:bg-primary/10 transition @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courses" ? "bg-primary/10 border-l-4 border-primary" : "")">
                <span class="material-symbols-outlined">menu_book</span>
                <span class="font-medium">Quản Lý Khóa Học</span>
            </a>

            <!-- Quản Lý Người Dùng -->
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-[#0d141b] dark:text-slate-50 hover:bg-primary/10 transition @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "bg-primary/10 border-l-4 border-primary" : "")">
                <span class="material-symbols-outlined">people</span>
                <span class="font-medium">Quản Lý Người Dùng</span>
            </a>

            <!-- Thanh Toán -->
            <a asp-area="Admin" asp-controller="Payments" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-[#0d141b] dark:text-slate-50 hover:bg-primary/10 transition @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "bg-primary/10 border-l-4 border-primary" : "")">
                <span class="material-symbols-outlined">attach_money</span>
                <span class="font-medium">Thanh Toán</span>
            </a>

            <!-- Quản Lý Liên Hệ -->
            <a asp-area="Admin" asp-controller="Contacts" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-[#0d141b] dark:text-slate-50 hover:bg-primary/10 transition @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contacts" ? "bg-primary/10 border-l-4 border-primary" : "")">
                <span class="material-symbols-outlined">mail</span>
                <span class="font-medium">Quản Lý Liên Hệ</span>
            </a>

            <!-- Báo Cáo & Thống Kê -->
            <a href="/admin/reports" class="flex items-center gap-3 px-4 py-3 rounded-lg text-[#0d141b] dark:text-slate-50 hover:bg-primary/10 transition @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "bg-primary/10 border-l-4 border-primary" : "")">
                <span class="material-symbols-outlined">bar_chart</span>
                <span class="font-medium">Báo Cáo & Thống Kê</span>
            </a>

            <!-- Quản Lý Menu -->
            <a asp-area="Admin" asp-controller="Menu" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-[#0d141b] dark:text-slate-50 hover:bg-primary/10 transition @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "bg-primary/10 border-l-4 border-primary" : "")">
                <span class="material-symbols-outlined">menu</span>
                <span class="font-medium">Quản Lý Menu</span>
            </a>

            <!-- Trang Chủ -->
            <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-lg text-[#0d141b] dark:text-slate-50 hover:bg-primary/10 transition mt-4">
                <span class="material-symbols-outlined">home</span>
                <span class="font-medium">Trang Chủ</span>
            </a>
        </nav>
    </div>
</aside>
