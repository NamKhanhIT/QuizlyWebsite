<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quizly Admin</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#2b8cee",
                        "primary-dark": "#1a5cbb",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101922",
                        "success": "#22c55e",
                        "danger": "#ef4444",
                        "warning": "#f59e0b"
                    },
                    fontFamily: {
                        "display": ["Lexend", "sans-serif"]
                    }
                }
            }
        }
    </script>

    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>

<body class="bg-background-light dark:bg-background-dark font-display text-[#0d141b] dark:text-slate-50">
    <!-- Flex Container -->
    <div class="flex h-screen overflow-hidden">
        
        <!-- Sidebar -->
        @await Html.PartialAsync("_Sidebar")

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col overflow-hidden">
            
            <!-- Navigation Bar -->
            <nav class="border-b border-solid border-[#e7edf3] dark:border-gray-700 bg-white dark:bg-gray-900 backdrop-blur-sm">
                <div class="px-6 py-4">
                    <div class="flex items-center justify-between">
                        <!-- Logo -->
                        <a href="/admin" class="flex items-center gap-2">
                            <div class="text-primary text-2xl">
                                <span class="material-symbols-outlined">admin_panel_settings</span>
                            </div>
                            <h2 class="text-[#0d141b] dark:text-slate-50 text-lg font-bold">Quizly Admin</h2>
                        </a>

                        <!-- Right Actions -->
                        <div class="flex gap-2 items-center">
                            <div class="relative group">
                                <button class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800">
                                    <span class="material-symbols-outlined text-sm">account_circle</span>
                                    <span class="text-sm font-medium hidden md:inline">@(Context.Session.GetString("Username") ?? "Admin")</span>
                                </button>
                                <div class="hidden group-hover:block absolute right-0 w-48 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 z-50">
                                    <a href="/" class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700">Trang chủ</a>
                                    <a href="/user/profile" class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700">Hồ sơ</a>
                                    <hr class="my-1 border-gray-200 dark:border-gray-700" />
                                    <a href="/logout" class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 text-danger">Đăng xuất</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="flex-1 overflow-y-auto">
                <div class="px-6 py-10">
                    @RenderBody()
                </div>
            </main>

        </div>

    </div>

    <!-- Footer -->
    <footer class="w-full py-4 border-t border-[#cfdbe7] dark:border-gray-700 bg-background-light dark:bg-gray-900 fixed bottom-0 right-0 left-0 z-10">
        <div class="px-6">
            <div class="flex justify-between items-center text-sm text-[#4c739a] dark:text-slate-400">
                <p>© 2024 Quizly Admin. All rights reserved.</p>
                <div class="flex gap-6">
                    <a href="#" class="hover:text-primary">Help</a>
                    <a href="#" class="hover:text-primary">Settings</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
