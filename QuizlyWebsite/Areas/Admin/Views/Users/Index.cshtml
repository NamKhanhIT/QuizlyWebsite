@model IEnumerable<QuizlyWebsite.Models.TbUser>

@{
    ViewData["Title"] = "Quản Lý Người Dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="flex justify-between items-center mb-8">
    <h2 class="text-3xl font-bold">Quản Lý Người Dùng</h2>
    <a asp-action="Create" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition flex items-center gap-2">
        <span class="material-symbols-outlined">add_circle</span>
        Thêm Người Dùng
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="px-6 py-4 text-left text-sm font-semibold">ID</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Tên Đăng Nhập</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Email</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Họ Tên</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Vai Trò</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Ngày Tạo</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@item.Id</td>
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@item.Username</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@item.Email</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(item.FullName ?? "N/A")</td>
                        <td class="px-6 py-4">
                            <span class="text-xs font-semibold px-3 py-1 rounded-full @(item.Role == "Admin" ? "bg-danger/20 text-danger" : "bg-primary/20 text-primary")">
                                @(item.Role ?? "User")
                            </span>
                        </td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(item.CreatedAt?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                        <td class="px-6 py-4">
                            <div class="flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-blue-500 hover:text-blue-700 p-2 rounded hover:bg-blue-50 dark:hover:bg-blue-900/20 transition" title="Xem chi tiết">
                                    <span class="material-symbols-outlined text-lg">info</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary hover:text-primary-dark p-2 rounded hover:bg-primary/10 dark:hover:bg-primary/20 transition" title="Chỉnh sửa">
                                    <span class="material-symbols-outlined text-lg">edit</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger hover:text-red-700 p-2 rounded hover:bg-red-50 dark:hover:bg-red-900/20 transition" title="Xóa">
                                    <span class="material-symbols-outlined text-lg">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">people</span>
        <p class="text-[#4c739a] dark:text-slate-400">Chưa có người dùng nào. <a asp-action="Create" class="text-primary hover:underline">Tạo người dùng mới</a></p>
    </div>
}

