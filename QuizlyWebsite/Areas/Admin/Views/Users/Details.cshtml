@model QuizlyWebsite.Models.TbUser

@{
    ViewData["Title"] = "Chi Tiết Người Dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="mb-8">
    <a asp-action="Index" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">Chi Tiết Người Dùng</h2>
</div>

<!-- Profile Header -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8 mb-8">
    <div class="flex items-center gap-6">
        <div class="w-20 h-20 bg-gradient-to-br from-primary to-primary-dark rounded-full flex items-center justify-center">
            <span class="material-symbols-outlined text-white text-3xl">
                @(Model.Role == "Admin" ? "admin_panel_settings" : "person")
            </span>
        </div>
        <div class="flex-1">
            <h3 class="text-2xl font-bold text-[#0d141b] dark:text-slate-50">@(Model.FullName ?? Model.Username)</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-2">@@Model.Username</p>
            <div class="flex items-center gap-4">
                <span class="text-xs font-semibold px-3 py-1 rounded-full @(Model.Role == "Admin" ? "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200" : "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200")">
                    @(Model.Role ?? "User")
                </span>
                <span class="text-sm text-gray-500 dark:text-gray-400">
                    Tham gia: @(Model.CreatedAt?.ToString("dd/MM/yyyy") ?? "N/A")
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Thông tin cơ bản -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
        <h4 class="text-lg font-semibold mb-4 text-[#0d141b] dark:text-slate-50 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">contact_mail</span>
            Thông Tin Liên Hệ
        </h4>
        <dl class="space-y-3">
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Email</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50">@Model.Email</dd>
            </div>
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Số Điện Thoại</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50">@(Model.PhoneNumber ?? "Chưa cập nhật")</dd>
            </div>
            <div class="flex justify-between items-start">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Địa Chỉ</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50 text-right">@(Model.Address ?? "Chưa cập nhật")</dd>
            </div>
        </dl>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
        <h4 class="text-lg font-semibold mb-4 text-[#0d141b] dark:text-slate-50 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">info</span>
            Thông Tin Tài Khoản
        </h4>
        <dl class="space-y-3">
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">ID Người Dùng</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50 font-mono">@Model.Id</dd>
            </div>
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Tên Đăng Nhập</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50">@@Model.Username</dd>
            </div>
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Vai Trò</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50">
                    <span class="text-xs font-semibold px-2 py-1 rounded @(Model.Role == "Admin" ? "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200" : "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200")">
                        @(Model.Role ?? "User")
                    </span>
                </dd>
            </div>
        </dl>
    </div>
</div>

<!-- Thống kê hoạt động (nếu có thể lấy được) -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <h4 class="text-lg font-semibold mb-4 text-[#0d141b] dark:text-slate-50 flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">analytics</span>
        Hoạt Động Gần Đây
    </h4>
    <div class="text-center py-8 text-gray-500 dark:text-gray-400">
        <span class="material-symbols-outlined text-4xl mb-2">timeline</span>
        <p>Thông tin thống kê chi tiết sẽ được hiển thị ở đây</p>
        <p class="text-sm">Đề thi đã tham gia, điểm số, thanh toán, v.v.</p>
    </div>
</div>

<!-- Action buttons -->
<div class="flex gap-3 mt-8 justify-center">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
        <span class="material-symbols-outlined text-sm mr-1">edit</span>
        Chỉnh Sửa
    </a>
    <a asp-action="Index" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
        <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
        Quay Lại
    </a>
</div>

