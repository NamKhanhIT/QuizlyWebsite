@model List<TbSubject>

@{
    ViewData["Title"] = "Quản Lý Môn Học";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Header -->
<div class="flex justify-between items-center mb-8">
    <h2 class="text-3xl font-bold">Danh Sách Môn Học</h2>
    <a href="/admin/subject-form" class="px-6 py-3 bg-success text-white rounded-lg font-semibold hover:bg-green-600 transition flex items-center gap-2">
        <span class="material-symbols-outlined">add</span>
        Thêm Môn Học
    </a>
</div>

<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6 animate-fade-in">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined">check_circle</span>
            <p class="text-sm font-semibold">@TempData["Success"]</p>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6 animate-fade-in">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined">error</span>
            <p class="text-sm font-semibold">@TempData["Error"]</p>
        </div>
    </div>
}

<!-- Table -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="px-6 py-4 text-left text-sm font-semibold">ID</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Tên Môn Học</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Mô Tả</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subject in Model)
                {
                    <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@subject.Id</td>
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@subject.Title</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@subject.Description</td>
                        <td class="px-6 py-4 text-sm">
                            <div class="flex gap-2">
                                <a href="/admin/subject-form/@subject.Id" class="text-primary hover:text-primary-dark" title="Chỉnh sửa">
                                    <span class="material-symbols-outlined text-sm">edit</span>
                                </a>
                                <button class="text-danger hover:text-red-700" title="Xóa" onclick="deleteSubject(@subject.Id)">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Empty State -->
@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center mt-6">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">school</span>
        <p class="text-[#4c739a] dark:text-slate-400">Không tìm thấy môn học nào.</p>
    </div>
}

<!-- Pagination -->
@{
    var totalPages = (int?)ViewData["TotalPages"] ?? 1;
    var currentPage = (int?)ViewData["CurrentPage"] ?? 1;
}

@if (totalPages > 1)
{
    <div class="flex justify-center gap-2 mt-8">
        @for (int i = 1; i <= totalPages; i++)
        {
            if (i == currentPage)
            {
                <button class="px-4 py-2 bg-primary text-white rounded-lg">@i</button>
            }
            else
            {
                <a href="/admin/subjects?page=@i" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded-lg hover:bg-gray-300">@i</a>
            }
        }
    </div>
}

<script>
function deleteSubject(id) {
    if (confirm('Bạn chắc chắn muốn xóa môn học này?')) {
        fetch('/admin/delete-subject', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: id })
        }).then(r => r.json()).then(d => {
            if (d.success) {
                location.reload();
            } else {
                alert(d.message || 'Lỗi xảy ra');
            }
        });
    }
}
</script>
