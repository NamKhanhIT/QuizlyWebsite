@{
    ViewData["Title"] = "Báo Cáo & Thống Kê";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    
    var totalRevenue = (decimal?)ViewData["TotalRevenue"] ?? 0;
    var totalPayments = (int?)ViewData["TotalPayments"] ?? 0;
    var successfulPayments = (int?)ViewData["SuccessfulPayments"] ?? 0;
    dynamic monthlyRevenue = ViewData["MonthlyRevenue"] ?? new List<dynamic>();
    dynamic topExams = ViewData["TopExams"] ?? new List<dynamic>();
}

<!-- Header -->
<div class="mb-8">
    <h2 class="text-3xl font-bold">@ViewData["Title"]</h2>
    <p class="text-gray-600 dark:text-gray-400">Theo dõi hiệu suất và xu hướng của hệ thống</p>
</div>

<!-- Summary Stats -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    
    <!-- Total Revenue -->
    <div class="bg-gradient-to-br from-blue-400 to-blue-600 text-white rounded-xl p-6 shadow-lg">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-blue-100 text-sm">Tổng Doanh Thu</p>
                <h3 class="text-3xl font-bold mt-2">@(totalRevenue.ToString("N0"))đ</h3>
            </div>
            <span class="material-symbols-outlined text-4xl opacity-50">attach_money</span>
        </div>
    </div>

    <!-- Total Payments -->
    <div class="bg-gradient-to-br from-green-400 to-green-600 text-white rounded-xl p-6 shadow-lg">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-green-100 text-sm">Tổng Giao Dịch</p>
                <h3 class="text-3xl font-bold mt-2">@totalPayments</h3>
                <p class="text-green-100 text-sm">Người Dùng Mới</p>
                <h3 class="text-3xl font-bold mt-2">342</h3>
                <p class="text-green-100 text-xs mt-1">↑ 8% so với tuần trước</p>
            </div>
            <span class="material-symbols-outlined text-4xl opacity-50">person_add</span>
        </div>
    </div>

    <!-- Active Exams -->
    <div class="bg-gradient-to-br from-orange-400 to-orange-600 text-white rounded-xl p-6 shadow-lg">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-orange-100 text-sm">Đề Thi Đang Hoạt Động</p>
                <h3 class="text-3xl font-bold mt-2">1,245</h3>
                <p class="text-orange-100 text-xs mt-1">↑ 23% so với tháng trước</p>
            </div>
            <span class="material-symbols-outlined text-4xl opacity-50">assignment</span>
        </div>
    </div>

    <!-- Total Participants -->
    <div class="bg-gradient-to-br from-purple-400 to-purple-600 text-white rounded-xl p-6 shadow-lg">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-purple-100 text-sm">Tổng Người Tham Gia</p>
                <h3 class="text-3xl font-bold mt-2">12.3K</h3>
                <p class="text-purple-100 text-xs mt-1">↑ 15% so với tuần trước</p>
            </div>
            <span class="material-symbols-outlined text-4xl opacity-50">group</span>
        </div>
    </div>

</div>

<!-- Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    
    <!-- Revenue Chart -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-lg">
        <h3 class="text-xl font-bold text-[#0d141b] dark:text-slate-50 mb-4">
            <span class="material-symbols-outlined align-middle mr-2 text-primary">show_chart</span>
            Doanh Thu Theo Tháng
        </h3>
        
        <div class="h-64 bg-gray-100 dark:bg-gray-700 rounded-lg flex items-center justify-center">
            <div class="text-center text-gray-500 dark:text-gray-400">
                <span class="material-symbols-outlined text-5xl mb-2">bar_chart</span>
                <p class="text-sm">Biểu đồ cột sẽ hiển thị ở đây</p>
                <small>Doanh thu: Tháng 1-12 năm 2024</small>
            </div>
        </div>

        <!-- Sample Data -->
        <div class="mt-4 grid grid-cols-3 gap-2 text-center text-xs text-gray-600 dark:text-gray-400">
            <div>
                <div class="font-bold">Tháng 1</div>
                <div>18.2M</div>
            </div>
            <div>
                <div class="font-bold">Tháng 2</div>
                <div>22.5M</div>
            </div>
            <div>
                <div class="font-bold">Tháng 3</div>
                <div>24.5M</div>
            </div>
        </div>
    </div>

    <!-- User Growth Chart -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-lg">
        <h3 class="text-xl font-bold text-[#0d141b] dark:text-slate-50 mb-4">
            <span class="material-symbols-outlined align-middle mr-2 text-primary">trending_up</span>
            Tăng Trưởng Người Dùng
        </h3>
        
        <div class="h-64 bg-gray-100 dark:bg-gray-700 rounded-lg flex items-center justify-center">
            <div class="text-center text-gray-500 dark:text-gray-400">
                <span class="material-symbols-outlined text-5xl mb-2">line_axis</span>
                <p class="text-sm">Biểu đồ đường sẽ hiển thị ở đây</p>
                <small>Số lượng người dùng mới mỗi tuần</small>
            </div>
        </div>

        <!-- Sample Data -->
        <div class="mt-4 grid grid-cols-4 gap-2 text-center text-xs text-gray-600 dark:text-gray-400">
            <div>
                <div class="font-bold">Tuần 1</div>
                <div>285</div>
            </div>
            <div>
                <div class="font-bold">Tuần 2</div>
                <div>312</div>
            </div>
            <div>
                <div class="font-bold">Tuần 3</div>
                <div>328</div>
            </div>
            <div>
                <div class="font-bold">Tuần 4</div>
                <div>342</div>
            </div>
        </div>
    </div>

</div>

<!-- Secondary Charts -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    
    <!-- Exam Participation -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-lg">
        <h3 class="text-xl font-bold text-[#0d141b] dark:text-slate-50 mb-4">
            <span class="material-symbols-outlined align-middle mr-2 text-primary">assignment</span>
            Tỷ Lệ Tham Gia Đề Thi
        </h3>
        
        <div class="space-y-3">
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-700 dark:text-gray-300">Toán 12 - Ôn tập</span>
                    <span class="font-semibold text-primary">92%</span>
                </div>
                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                    <div class="bg-primary h-2 rounded-full" style="width: 92%"></div>
                </div>
            </div>

            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-700 dark:text-gray-300">Hóa 12 - Các phản ứng</span>
                    <span class="font-semibold text-success">85%</span>
                </div>
                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                    <div class="bg-success h-2 rounded-full" style="width: 85%"></div>
                </div>
            </div>

            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-700 dark:text-gray-300">Anh 12 - Reading</span>
                    <span class="font-semibold text-warning">72%</span>
                </div>
                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                    <div class="bg-warning h-2 rounded-full" style="width: 72%"></div>
                </div>
            </div>

            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-700 dark:text-gray-300">Lý 12 - Năng lượng</span>
                    <span class="font-semibold text-info">68%</span>
                </div>
                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                    <div class="bg-info h-2 rounded-full" style="width: 68%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- User Status Distribution -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-lg">
        <h3 class="text-xl font-bold text-[#0d141b] dark:text-slate-50 mb-4">
            <span class="material-symbols-outlined align-middle mr-2 text-primary">people</span>
            Phân Bố Vai Trò Người Dùng
        </h3>
        
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="w-3 h-3 bg-primary rounded-full mr-2"></div>
                    <span class="text-gray-700 dark:text-gray-300">Người Dùng Thường</span>
                </div>
                <span class="font-semibold text-[#0d141b] dark:text-slate-50">8,543 (65%)</span>
            </div>

            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="w-3 h-3 bg-warning rounded-full mr-2"></div>
                    <span class="text-gray-700 dark:text-gray-300">Người Điều Hành</span>
                </div>
                <span class="font-semibold text-[#0d141b] dark:text-slate-50">3,221 (25%)</span>
            </div>

            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="w-3 h-3 bg-danger rounded-full mr-2"></div>
                    <span class="text-gray-700 dark:text-gray-300">Quản Trị Viên</span>
                </div>
                <span class="font-semibold text-[#0d141b] dark:text-slate-50">1,236 (10%)</span>
            </div>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-700">
            <p class="text-sm text-gray-600 dark:text-gray-400 text-center">
                Tổng cộng: <span class="font-bold text-[#0d141b] dark:text-slate-50">13,000 người dùng</span>
            </p>
        </div>
    </div>

</div>

<!-- Detailed Table -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-lg">
    <h3 class="text-xl font-bold text-[#0d141b] dark:text-slate-50 mb-4">
        <span class="material-symbols-outlined align-middle mr-2 text-primary">table_chart</span>
        Thống Kê Chi Tiết Hàng Ngày
    </h3>

    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-100 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600">
                <tr>
                    <th class="px-4 py-3 text-left font-semibold text-[#0d141b] dark:text-slate-50">Ngày</th>
                    <th class="px-4 py-3 text-left font-semibold text-[#0d141b] dark:text-slate-50">Người Dùng Mới</th>
                    <th class="px-4 py-3 text-left font-semibold text-[#0d141b] dark:text-slate-50">Lần Tham Gia Đề</th>
                    <th class="px-4 py-3 text-left font-semibold text-[#0d141b] dark:text-slate-50">Doanh Thu</th>
                    <th class="px-4 py-3 text-left font-semibold text-[#0d141b] dark:text-slate-50">Gói Được Mua</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                    <td class="px-4 py-3">29/03/2024</td>
                    <td class="px-4 py-3"><span class="bg-success/10 text-success px-2 py-1 rounded text-xs">+28</span></td>
                    <td class="px-4 py-3"><span class="bg-primary/10 text-primary px-2 py-1 rounded text-xs">342</span></td>
                    <td class="px-4 py-3"><span class="font-semibold text-success">2.5M</span></td>
                    <td class="px-4 py-3">12</td>
                </tr>
                <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                    <td class="px-4 py-3">28/03/2024</td>
                    <td class="px-4 py-3"><span class="bg-success/10 text-success px-2 py-1 rounded text-xs">+31</span></td>
                    <td class="px-4 py-3"><span class="bg-primary/10 text-primary px-2 py-1 rounded text-xs">328</span></td>
                    <td class="px-4 py-3"><span class="font-semibold text-success">2.8M</span></td>
                    <td class="px-4 py-3">15</td>
                </tr>
                <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                    <td class="px-4 py-3">27/03/2024</td>
                    <td class="px-4 py-3"><span class="bg-success/10 text-success px-2 py-1 rounded text-xs">+25</span></td>
                    <td class="px-4 py-3"><span class="bg-primary/10 text-primary px-2 py-1 rounded text-xs">315</span></td>
                    <td class="px-4 py-3"><span class="font-semibold text-success">2.2M</span></td>
                    <td class="px-4 py-3">8</td>
                </tr>
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                    <td class="px-4 py-3">26/03/2024</td>
                    <td class="px-4 py-3"><span class="bg-success/10 text-success px-2 py-1 rounded text-xs">+35</span></td>
                    <td class="px-4 py-3"><span class="bg-primary/10 text-primary px-2 py-1 rounded text-xs">356</span></td>
                    <td class="px-4 py-3"><span class="font-semibold text-success">3.1M</span></td>
                    <td class="px-4 py-3">18</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Export Buttons -->
<div class="mt-8 flex gap-3">
    <button class="px-6 py-3 bg-info text-white rounded-lg hover:bg-info-dark transition font-semibold">
        <span class="material-symbols-outlined align-middle mr-2">download</span>
        Tải PDF
    </button>
    <button class="px-6 py-3 bg-success text-white rounded-lg hover:bg-success-dark transition font-semibold">
        <span class="material-symbols-outlined align-middle mr-2">table_chart</span>
        Tải Excel
    </button>
    <button class="px-6 py-3 bg-warning text-white rounded-lg hover:bg-warning-dark transition font-semibold">
        <span class="material-symbols-outlined align-middle mr-2">mail</span>
        Gửi Báo Cáo Email
    </button>
</div>
