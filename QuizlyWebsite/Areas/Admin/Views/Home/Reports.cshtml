@using QuizlyWebsite.Models
@{
    ViewData["Title"] = "Báo Cáo & Thống Kê";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    
    var totalRevenue = (decimal?)ViewData["TotalRevenue"] ?? 0;
    var totalPayments = (int?)ViewData["TotalPayments"] ?? 0;
    var successfulPayments = (int?)ViewData["SuccessfulPayments"] ?? 0;
    var monthlyRevenue = ViewData["MonthlyRevenue"] as List<MonthlyRevenueViewModel> ?? new List<MonthlyRevenueViewModel>();
    var topExams = ViewData["TopExams"] as List<TopExamViewModel> ?? new List<TopExamViewModel>();
    var userGrowth = ViewData["UserGrowth"] as List<UserGrowthViewModel> ?? new List<UserGrowthViewModel>();
    var examParticipation = ViewData["ExamParticipation"] as List<ExamParticipationViewModel> ?? new List<ExamParticipationViewModel>();
    var userRoleDistribution = ViewData["UserRoleDistribution"] as List<UserRoleDistributionViewModel> ?? new List<UserRoleDistributionViewModel>();
}

<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Error"]</p>
    </div>
}

<!-- Header -->
<div class="mb-8">
    <h2 class="text-3xl font-bold">@ViewData["Title"]</h2>
    <p class="text-gray-600 dark:text-gray-400">Theo dõi hiệu suất và xu hướng của hệ thống</p>
</div>

<!-- Summary Stats -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    
    <!-- Total Revenue -->
    <div class="bg-gradient-to-br from-blue-400 to-blue-600 text-white rounded-xl p-6 shadow-lg">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-blue-100 text-sm">Tổng Doanh Thu</p>
                <h3 class="text-3xl font-bold mt-2">@(totalRevenue.ToString("N0"))₫</h3>
            </div>
            <span class="material-symbols-outlined text-4xl opacity-50">attach_money</span>
        </div>
    </div>

    <!-- Total Payments -->
    <div class="bg-gradient-to-br from-green-400 to-green-600 text-white rounded-xl p-6 shadow-lg">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-green-100 text-sm">Tổng Giao Dịch</p>
                <h3 class="text-3xl font-bold mt-2">@totalPayments</h3>
                <p class="text-green-100 text-sm mt-4">Giao Dịch Thành Công</p>
                <h3 class="text-3xl font-bold mt-2">@successfulPayments</h3>
            </div>
            <span class="material-symbols-outlined text-4xl opacity-50">person_add</span>
        </div>
    </div>

    <!-- Active Exams -->
    <div class="bg-gradient-to-br from-orange-400 to-orange-600 text-white rounded-xl p-6 shadow-lg">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-orange-100 text-sm">Đề Thi Đang Hoạt Động</p>
                <h3 class="text-3xl font-bold mt-2">@((ViewData["TotalExams"] as int?) ?? 0)</h3>
            </div>
            <span class="material-symbols-outlined text-4xl opacity-50">assignment</span>
        </div>
    </div>

    <!-- Total Participants -->
    <div class="bg-gradient-to-br from-purple-400 to-purple-600 text-white rounded-xl p-6 shadow-lg">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-purple-100 text-sm">Tổng Người Dùng</p>
                <h3 class="text-3xl font-bold mt-2">@((ViewData["TotalUsers"] as int?) ?? 0)</h3>
            </div>
            <span class="material-symbols-outlined text-4xl opacity-50">group</span>
        </div>
    </div>

</div>

<!-- Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    
    <!-- Revenue Chart -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-lg">
        <h3 class="text-xl font-bold text-[#0d141b] dark:text-slate-50 mb-4">
            <span class="material-symbols-outlined align-middle mr-2 text-primary">show_chart</span>
            Doanh Thu Theo Tháng
        </h3>
        
        <div class="h-48 w-full">
            <canvas id="revenueChart"></canvas>
        </div>

        <!-- Monthly Revenue Data -->
        <div class="mt-4 space-y-2">
            @if (monthlyRevenue != null && monthlyRevenue.Any())
            {
                @foreach (var month in monthlyRevenue)
                {
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-700 dark:text-gray-300">@month.Month</span>
                        <span class="font-semibold text-primary">@month.Revenue.ToString("N0")₫</span>
                        <span class="text-gray-500 dark:text-gray-400">(@month.Count giao dịch)</span>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-gray-500 dark:text-gray-400 text-sm">Chưa có dữ liệu doanh thu theo tháng</p>
            }
        </div>
    </div>

    <!-- User Growth Chart -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-lg">
        <h3 class="text-xl font-bold text-[#0d141b] dark:text-slate-50 mb-4">
            <span class="material-symbols-outlined align-middle mr-2 text-primary">trending_up</span>
            Tăng Trưởng Người Dùng
        </h3>
        
        <div class="h-48 w-full">
            <canvas id="userGrowthChart"></canvas>
        </div>

        <!-- User Growth Data -->
        <div class="mt-4 space-y-2">
            @if (userGrowth != null && userGrowth.Any())
            {
                @foreach (var month in userGrowth.Take(12))
                {
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-700 dark:text-gray-300">@month.Month</span>
                        <span class="font-semibold text-primary">+@month.Count người dùng</span>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-gray-500 dark:text-gray-400 text-sm">Chưa có dữ liệu tăng trưởng người dùng</p>
            }
        </div>
    </div>

</div>

<!-- Secondary Charts -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    
    <!-- Exam Participation -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-lg">
        <h3 class="text-xl font-bold text-[#0d141b] dark:text-slate-50 mb-4">
            <span class="material-symbols-outlined align-middle mr-2 text-primary">assignment</span>
            Tỷ Lệ Tham Gia Đề Thi
        </h3>
        
        <div class="space-y-3">
            @if (examParticipation != null && examParticipation.Any())
            {
                @foreach (var exam in examParticipation)
                {
                    var rate = exam.ParticipationRate;
                    var colorClass = rate >= 80 ? "primary" : rate >= 50 ? "success" : rate >= 30 ? "warning" : "info";
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-700 dark:text-gray-300">@exam.ExamTitle</span>
                            <span class="font-semibold text-@colorClass">@rate.ToString("F1")%</span>
                        </div>
                        <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                            <div class="bg-@colorClass h-2 rounded-full" style="width: @(Math.Min(rate, 100))%"></div>
                        </div>
                        <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">@exam.TotalAttempts lượt làm</div>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-gray-500 dark:text-gray-400 text-sm">Chưa có dữ liệu tham gia đề thi</p>
            }
        </div>
    </div>

    <!-- User Status Distribution -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-lg">
        <h3 class="text-xl font-bold text-[#0d141b] dark:text-slate-50 mb-4">
            <span class="material-symbols-outlined align-middle mr-2 text-primary">people</span>
            Phân Bố Vai Trò Người Dùng
        </h3>
        
        <div class="space-y-3">
            @if (userRoleDistribution != null && userRoleDistribution.Any())
            {
                var totalUsers = (int)(ViewData["TotalUsers"] ?? 0);
                @foreach (var role in userRoleDistribution)
                {
                    var count = role.Count;
                    var percentage = totalUsers > 0 ? (count * 100.0 / totalUsers) : 0;
                    var colorClass = role.Role == "Admin" ? "danger" : role.Role == "Moderator" ? "warning" : "primary";
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="w-3 h-3 bg-@colorClass rounded-full mr-2"></div>
                            <span class="text-gray-700 dark:text-gray-300">@(role.Role == "Admin" ? "Quản Trị Viên" : role.Role == "Moderator" ? "Người Điều Hành" : "Người Dùng Thường")</span>
                        </div>
                        <span class="font-semibold text-[#0d141b] dark:text-slate-50">@count (@percentage.ToString("F1")%)</span>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-gray-500 dark:text-gray-400 text-sm">Chưa có dữ liệu phân bố vai trò</p>
            }
        </div>

        <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-700">
            <p class="text-sm text-gray-600 dark:text-gray-400 text-center">
                Tổng cộng: <span class="font-bold text-[#0d141b] dark:text-slate-50">@((ViewData["TotalUsers"] as int?) ?? 0) người dùng</span>
            </p>
        </div>
    </div>

</div>

<!-- Detailed Table -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-lg">
    <h3 class="text-xl font-bold text-[#0d141b] dark:text-slate-50 mb-4">
        <span class="material-symbols-outlined align-middle mr-2 text-primary">table_chart</span>
        Thống Kê Chi Tiết Theo Tháng
    </h3>

    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-100 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600">
                <tr>
                    <th class="px-4 py-3 text-left font-semibold text-[#0d141b] dark:text-slate-50">Tháng</th>
                    <th class="px-4 py-3 text-left font-semibold text-[#0d141b] dark:text-slate-50">Người Dùng Mới</th>
                    <th class="px-4 py-3 text-left font-semibold text-[#0d141b] dark:text-slate-50">Giao Dịch</th>
                    <th class="px-4 py-3 text-left font-semibold text-[#0d141b] dark:text-slate-50">Doanh Thu</th>
                    <th class="px-4 py-3 text-left font-semibold text-[#0d141b] dark:text-slate-50">Số Lượng</th>
                </tr>
            </thead>
            <tbody>
                @if (monthlyRevenue != null && monthlyRevenue.Any())
                {
                    @foreach (var month in monthlyRevenue.Take(10))
                    {
                        var userCount = userGrowth?.FirstOrDefault(u => u.Month == month.Month)?.Count ?? 0;
                        <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                            <td class="px-4 py-3">@month.Month</td>
                            <td class="px-4 py-3">
                                @if (userCount > 0)
                                {
                                    <span class="bg-success/10 text-success px-2 py-1 rounded text-xs">+@userCount</span>
                                }
                                else
                                {
                                    <span class="text-gray-400">0</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <span class="bg-primary/10 text-primary px-2 py-1 rounded text-xs">@month.Count</span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="font-semibold text-success">@month.Revenue.ToString("N0")₫</span>
                            </td>
                            <td class="px-4 py-3">@month.Count</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
                            Chưa có dữ liệu thống kê chi tiết
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Export and Email Section -->
<div class="mt-8 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <h3 class="text-xl font-bold text-[#0d141b] dark:text-slate-50 mb-4">Xuất Báo Cáo & Gửi Email</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Export Excel -->
        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
            <h4 class="font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Xuất Báo Cáo Excel</h4>
            <p class="text-sm text-[#4c739a] dark:text-slate-400 mb-4">Tải báo cáo thống kê dưới dạng file Excel (.xlsx)</p>
            <a href="/admin/reports/export-excel" class="inline-flex items-center gap-2 px-6 py-3 bg-success text-white rounded-lg hover:bg-green-700 transition font-semibold">
                <span class="material-symbols-outlined">download</span>
                Tải Excel
            </a>
        </div>

        <!-- Send Email -->
        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
            <h4 class="font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Gửi Báo Cáo Qua Email</h4>
            <p class="text-sm text-[#4c739a] dark:text-slate-400 mb-4">Gửi báo cáo thống kê đến email</p>
            
            <form id="emailReportForm" class="space-y-3">
                <div>
                    <label class="flex items-center gap-2 mb-2">
                        <input type="checkbox" id="useCurrentEmail" name="useCurrentEmail" class="rounded">
                        <span class="text-sm text-[#0d141b] dark:text-slate-50">Sử dụng email hiện tại</span>
                    </label>
                </div>
                <div id="emailInputContainer">
                    <input type="email" id="reportEmail" name="email" placeholder="Nhập email nhận báo cáo" 
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50">
                </div>
                <button type="submit" class="w-full px-6 py-3 bg-primary text-white rounded-lg hover:bg-blue-700 transition font-semibold">
                    <span class="material-symbols-outlined align-middle mr-2">email</span>
                    Gửi Email
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Revenue Chart Data
        @{
            var revenueLabels = monthlyRevenue != null && monthlyRevenue.Any() 
                ? string.Join(",", monthlyRevenue.Select(m => $"\"{m.Month}\""))
                : "[]";
            var revenueData = monthlyRevenue != null && monthlyRevenue.Any()
                ? string.Join(",", monthlyRevenue.Select(m => ((decimal)m.Revenue).ToString("F0")))
                : "[]";
        }

        // User Growth Chart Data
        @{
            var growthLabels = userGrowth != null && userGrowth.Any()
                ? string.Join(",", userGrowth.Take(12).Select(m => $"\"{m.Month}\""))
                : "[]";
            var growthData = userGrowth != null && userGrowth.Any()
                ? string.Join(",", userGrowth.Take(12).Select(m => m.Count.ToString()))
                : "[]";
        }

        // Revenue Chart (Bar Chart)
        const revenueCtx = document.getElementById('revenueChart');
        if (revenueCtx) {
            const revenueLabelsArray = [@Html.Raw(revenueLabels)];
            const revenueDataArray = [@Html.Raw(revenueData)];
            
            if (revenueLabelsArray.length > 0 && revenueDataArray.length > 0) {
                new Chart(revenueCtx, {
                    type: 'bar',
                    data: {
                        labels: revenueLabelsArray,
                        datasets: [{
                            label: 'Doanh Thu',
                            data: revenueDataArray,
                            backgroundColor: 'rgba(59, 130, 246, 0.6)',
                            borderColor: 'rgba(59, 130, 246, 1)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                enabled: true
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    font: {
                                        size: 10
                                    }
                                }
                            },
                            x: {
                                ticks: {
                                    font: {
                                        size: 10
                                    }
                                }
                            }
                        }
                    }
                });
            }
        }

        // User Growth Chart (Line Chart)
        const userGrowthCtx = document.getElementById('userGrowthChart');
        if (userGrowthCtx) {
            const growthLabelsArray = [@Html.Raw(growthLabels)];
            const growthDataArray = [@Html.Raw(growthData)];
            
            if (growthLabelsArray.length > 0 && growthDataArray.length > 0) {
                new Chart(userGrowthCtx, {
                    type: 'line',
                    data: {
                        labels: growthLabelsArray,
                        datasets: [{
                            label: 'Người Dùng Mới',
                            data: growthDataArray,
                            borderColor: 'rgba(34, 197, 94, 1)',
                            backgroundColor: 'rgba(34, 197, 94, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                enabled: true
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    font: {
                                        size: 10
                                    },
                                    stepSize: 1
                                }
                            },
                            x: {
                                ticks: {
                                    font: {
                                        size: 10
                                    }
                                }
                            }
                        }
                    }
                });
            }
        }

        // Handle email form
        document.getElementById('useCurrentEmail')?.addEventListener('change', function() {
            const emailInput = document.getElementById('reportEmail');
            if (this.checked) {
                emailInput.disabled = true;
                emailInput.value = '';
            } else {
                emailInput.disabled = false;
                emailInput.focus();
            }
        });

        document.getElementById('emailReportForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const useCurrentEmail = document.getElementById('useCurrentEmail').checked;
            const email = document.getElementById('reportEmail').value;
            
            if (!useCurrentEmail && !email) {
                alert('Vui lòng nhập email hoặc chọn sử dụng email hiện tại');
                return;
            }

            try {
                const formData = new FormData();
                formData.append('email', email);
                formData.append('useCurrentEmail', useCurrentEmail);

                const response = await fetch('/admin/reports/send-email', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();
                if (data.success) {
                    alert(data.message);
                    document.getElementById('emailReportForm').reset();
                    document.getElementById('useCurrentEmail').checked = false;
                } else {
                    alert('Lỗi: ' + data.message);
                }
            } catch (error) {
                alert('Lỗi khi gửi email: ' + error.message);
            }
        });
    </script>
}
