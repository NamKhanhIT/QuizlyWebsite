@model QuizlyWebsite.Models.TbQuestion

@{
    ViewData["Title"] = Model?.Id > 0 ? "Chỉnh Sửa Câu Hỏi" : "Thêm Câu Hỏi Mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var queryExamId = ViewContext.HttpContext.Request.Query["examId"].ToString();
    var submitAction = Model?.Id > 0
        ? $"/admin/question-form/{Model.Id}?examId={queryExamId}"
        : "/admin/question-form";
    var hiddenExamId = ViewData["ExamId"]?.ToString() ?? queryExamId;
}

<!-- Header -->
<div class="mb-8">
    <a href="/admin/questions?examId=@hiddenExamId" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">@ViewData["Title"]</h2>
</div>

<!-- Form -->
<form method="post" action="@submitAction" class="max-w-4xl">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8">

        <!-- Success Message -->
        @if (TempData["Success"] != null)
        {
            <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
                <p class="text-sm font-semibold">@TempData["Success"]</p>
            </div>
        }

        <!-- Error Messages -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
                <p class="text-sm font-semibold mb-2">Vui lòng sửa các lỗi sau:</p>
                <ul class="list-disc list-inside space-y-1">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li class="text-sm">@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <input type="hidden" name="examId" value="@hiddenExamId" />

        <!-- Question Content -->
        <div class="mb-6">
            <label class="block text-sm font-semibold mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">help</span>
                Nội Dung Câu Hỏi
            </label>
            <textarea name="content" rows="4" required
                class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition @(ViewData.ModelState["content"]?.Errors.Count > 0 ? "border-danger" : "")">@Model?.Content</textarea>
            @if (ViewData.ModelState["content"]?.Errors.Count > 0)
            {
                <p class="text-danger text-xs mt-1">@ViewData.ModelState["content"].Errors[0].ErrorMessage</p>
            }
        </div>

        <!-- Marks -->
        <div class="mb-6">
            <label class="block text-sm font-semibold mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">category</span>
                Điểm (Marks)
            </label>
            <input type="number" name="marks" placeholder="1" min="0" step="0.5"
                value="@(Model?.Marks ?? 1)"
                class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition @(ViewData.ModelState["marks"]?.Errors.Count > 0 ? "border-danger" : "")" />
            @if (ViewData.ModelState["marks"]?.Errors.Count > 0)
            {
                <p class="text-danger text-xs mt-1">@ViewData.ModelState["marks"].Errors[0].ErrorMessage</p>
            }
        </div>

        <!-- Answer Options -->
        <div class="mb-6">
            <label class="block text-sm font-semibold mb-3">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">list</span>
                Các Lựa Chọn
            </label>
            <div class="space-y-3">
                <div class="flex gap-2">
                    <span class="w-12 px-3 py-3 bg-gray-100 dark:bg-gray-700 rounded-lg font-semibold text-center flex items-center justify-center">A</span>
                    <div class="flex-1">
                        <input type="text" name="optionA" value="@Model?.OptionA" required
                            class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition @(ViewData.ModelState["optionA"]?.Errors.Count > 0 ? "border-danger" : "")" />
                        @if (ViewData.ModelState["optionA"]?.Errors.Count > 0)
                        {
                            <p class="text-danger text-xs mt-1">@ViewData.ModelState["optionA"].Errors[0].ErrorMessage</p>
                        }
                    </div>
                </div>
                <div class="flex gap-2">
                    <span class="w-12 px-3 py-3 bg-gray-100 dark:bg-gray-700 rounded-lg font-semibold text-center flex items-center justify-center">B</span>
                    <div class="flex-1">
                        <input type="text" name="optionB" value="@Model?.OptionB" required
                            class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition @(ViewData.ModelState["optionB"]?.Errors.Count > 0 ? "border-danger" : "")" />
                        @if (ViewData.ModelState["optionB"]?.Errors.Count > 0)
                        {
                            <p class="text-danger text-xs mt-1">@ViewData.ModelState["optionB"].Errors[0].ErrorMessage</p>
                        }
                    </div>
                </div>
                <div class="flex gap-2">
                    <span class="w-12 px-3 py-3 bg-gray-100 dark:bg-gray-700 rounded-lg font-semibold text-center flex items-center justify-center">C</span>
                    <div class="flex-1">
                        <input type="text" name="optionC" value="@Model?.OptionC" required
                            class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition @(ViewData.ModelState["optionC"]?.Errors.Count > 0 ? "border-danger" : "")" />
                        @if (ViewData.ModelState["optionC"]?.Errors.Count > 0)
                        {
                            <p class="text-danger text-xs mt-1">@ViewData.ModelState["optionC"].Errors[0].ErrorMessage</p>
                        }
                    </div>
                </div>
                <div class="flex gap-2">
                    <span class="w-12 px-3 py-3 bg-gray-100 dark:bg-gray-700 rounded-lg font-semibold text-center flex items-center justify-center">D</span>
                    <div class="flex-1">
                        <input type="text" name="optionD" value="@Model?.OptionD" required
                            class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition @(ViewData.ModelState["optionD"]?.Errors.Count > 0 ? "border-danger" : "")" />
                        @if (ViewData.ModelState["optionD"]?.Errors.Count > 0)
                        {
                            <p class="text-danger text-xs mt-1">@ViewData.ModelState["optionD"].Errors[0].ErrorMessage</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Correct Answer -->
        <div class="mb-6">
            <label class="block text-sm font-semibold mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">check_circle</span>
                Đáp Án Đúng
            </label>
            <select name="correctOption" required
                class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary transition @(ViewData.ModelState["correctOption"]?.Errors.Count > 0 ? "border-danger" : "")">
                <option value="">-- Chọn Đáp Án Đúng --</option>
                @foreach (var opt in new[] { "A", "B", "C", "D" })
                {
                    var isSelected = Model?.CorrectOption?.ToUpper() == opt.ToUpper();
                    <option value="@opt" selected="@isSelected">
                        @opt
                    </option>
                }
            </select>
            @if (ViewData.ModelState["correctOption"]?.Errors.Count > 0)
            {
                <p class="text-danger text-xs mt-1">@ViewData.ModelState["correctOption"].Errors[0].ErrorMessage</p>
            }
        </div>


        <!-- Buttons -->
        <div class="flex gap-3">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">save</span>
                @(Model?.Id > 0 ? "Cập Nhật" : "Tạo Mới")
            </button>
            <a href="/admin/questions?examId=@hiddenExamId"
               class="px-6 py-3 bg-gray-200 text-black rounded-lg hover:bg-gray-300 transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">close</span>
                Hủy
            </a>
        </div>
    </div>
</form>