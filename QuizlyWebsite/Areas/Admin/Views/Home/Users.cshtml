@model List<QuizlyWebsite.Models.TbUser>

@{
    ViewData["Title"] = "Quản Lý Người Dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Error"]</p>
    </div>
}

<!-- Header -->
<div class="flex justify-between items-center mb-8">
    <h2 class="text-3xl font-bold">Danh Sách Người Dùng</h2>
    <div class="flex gap-3">
        <input type="text" id="searchInput" placeholder="Tìm kiếm người dùng..." 
            class="px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50">
        <a href="/admin/user-form" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-blue-700 transition flex items-center gap-2">
            <span class="material-symbols-outlined">add</span>
            Thêm Người Dùng
        </a>
        <a href="/admin/user-permissions" class="px-6 py-3 bg-warning text-white rounded-lg font-semibold hover:bg-orange-600 transition flex items-center gap-2">
            <span class="material-symbols-outlined">admin_panel_settings</span>
            Phân Quyền
        </a>
    </div>
</div>

<!-- Table -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Tên Đăng Nhập</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Email</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Họ Tên</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Vai Trò</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Trạng Thái</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Ngày Tạo</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@user.Username</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@user.Email</td>
                        <td class="px-6 py-4 text-[#0d141b] dark:text-slate-50">@user.FullName</td>
                        <td class="px-6 py-4">
                            <span class="text-xs font-semibold px-3 py-1 rounded-full @(user.Role == "Admin" ? "bg-danger/20 text-danger" : "bg-primary/20 text-primary")">
                                @(user.Role ?? "User")
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-success/20 text-success">
                                Hoạt Động
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm text-[#4c739a] dark:text-slate-400">@(user.CreatedAt?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                        <td class="px-6 py-4 text-sm">
                            <div class="flex gap-2">
                                <button class="text-primary hover:text-primary-dark" title="Chỉnh sửa" onclick="editUser(@user.Id)">
                                    <span class="material-symbols-outlined text-sm">edit</span>
                                </button>
                                <button class="text-warning hover:text-orange-600" title="Đổi vai trò" onclick="changeRole(@user.Id)">
                                    <span class="material-symbols-outlined text-sm">admin_panel_settings</span>
                                </button>
                                <button class="text-danger hover:text-red-700" title="Xóa" onclick="deleteUser(@user.Id)">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Empty State -->
@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center mt-6">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">person_search</span>
        <p class="text-[#4c739a] dark:text-slate-400">Không tìm thấy người dùng nào.</p>
    </div>
}

@section Scripts {
    <script>
        function editUser(id) {
            console.log('Edit user:', id);
        }
        function changeRole(id) {
            console.log('Change role for user:', id);
        }
        function deleteUser(id) {
            const reason = prompt('Vui lòng nhập lý do xóa người dùng này:');
            if (reason && reason.trim()) {
                fetch('/admin/delete-user', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: id, reason: reason.trim() })
                }).then(r => r.json()).then(d => {
                    if (d.success) {
                        alert(d.message);
                        location.reload();
                    } else {
                        alert(d.message || 'Lỗi xảy ra');
                    }
                });
            }
        }
        
        function editUser(id) {
            window.location.href = '/admin/user-form/' + id;
        }
        
        function changeRole(id) {
            window.location.href = '/admin/user-permissions';
        }
        
        // Search functionality
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const filter = this.value.toLowerCase();
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
