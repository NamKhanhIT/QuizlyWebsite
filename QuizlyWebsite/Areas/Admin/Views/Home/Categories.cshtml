@model List<QuizlyWebsite.Models.TbCategory>

@{
    ViewData["Title"] = "Quản Lý Danh Mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Header -->
<div class="flex justify-between items-center mb-8">
    <h2 class="text-3xl font-bold">Danh Sách Danh Mục</h2>
    <a href="/admin/category-form" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition flex items-center gap-2">
        <span class="material-symbols-outlined">add_circle</span>
        Thêm Danh Mục
    </a>
</div>

<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6 animate-fade-in">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined">check_circle</span>
            <p class="text-sm font-semibold">@TempData["Success"]</p>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6 animate-fade-in">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined">error</span>
            <p class="text-sm font-semibold">@TempData["Error"]</p>
        </div>
    </div>
}

<!-- Grid View -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    @foreach (var category in Model)
    {
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:shadow-lg transition">
            <div class="flex items-start justify-between mb-3">
                <h3 class="text-lg font-bold text-[#0d141b] dark:text-slate-50">@category.Title</h3>
                <div class="flex gap-2">
                    <a href="/admin/category-form/@category.Id" class="text-primary hover:text-primary-dark" title="Chỉnh sửa">
                        <span class="material-symbols-outlined text-sm">edit</span>
                    </a>
                    <button class="text-danger hover:text-red-700" title="Xóa" onclick="deleteCategory(@category.Id)">
                        <span class="material-symbols-outlined text-sm">delete</span>
                    </button>
                </div>
            </div>

            <p class="text-[#4c739a] dark:text-slate-400 text-sm mb-4">@(string.IsNullOrEmpty(category.Title) ? "Danh mục không có mô tả" : category.Title)</p>

            <div class="flex items-center justify-between text-xs text-[#4c739a] dark:text-slate-400">
                <span class="material-symbols-outlined text-sm align-middle">calendar_today</span>
                <span>@category.CreatedAt?.ToString("dd/MM/yyyy") ?? "N/A"</span>
            </div>
        </div>
    }
</div>

<!-- Empty State -->
@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">folder_open</span>
        <p class="text-[#4c739a] dark:text-slate-400">Chưa có danh mục nào. <a href="/admin/category-form" class="text-primary hover:underline">Tạo danh mục mới</a></p>
    </div>
}

@section Scripts {
    <script>
        async function deleteCategory(id) {
            if (!confirm('Bạn có chắc chắn muốn xóa danh mục này?')) return;

            try {
                const response = await fetch('/admin/delete-category', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ id: id })
                });

                const data = await response.json();
                if (data.success) {
                    alert('Danh mục đã được xóa thành công');
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            } catch (error) {
                alert('Lỗi: ' + error.message);
            }
        }
    </script>
}
