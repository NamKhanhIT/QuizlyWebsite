@model QuizlyWebsite.Models.TbExam

@{
    ViewData["Title"] = Model?.Id > 0 ? "Chỉnh Sửa Đề Thi" : "Thêm Đề Thi Mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Error"]</p>
    </div>
}
<div asp-validation-summary="All"></div>
<!-- Header -->

<div class="mb-8">
    <a href="/admin/exams" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">@ViewData["Title"]</h2>
</div>

<!-- Form -->
<form method="post" action="@(Model?.Id > 0 ? $"/admin/exam-form/{Model.Id}" : "/admin/exam-form")" enctype="multipart/form-data" class="max-w-4xl">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8">

        <!-- Error Messages -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="text-sm">@error.ErrorMessage</p>
                }
            </div>
        }

        <!-- Title -->
        <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">edit</span>
                Tên Đề Thi
            </label>
            <input type="text" name="title" value="@Model?.Title" placeholder="Nhập tên đề thi"
                   class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                   required>
        </div>

        <!-- Subject & Category -->
        <div class="grid grid-cols-2 gap-6 mb-6">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50">
                        <span class="material-symbols-outlined align-middle mr-1 text-primary">school</span>
                        Môn Học
                    </label>
                    <label class="flex items-center gap-2 text-xs">
                        <input type="checkbox" id="useNewSubject" name="useNewSubject" value="true" onchange="toggleSubjectInput()">
                        <span>Tạo mới</span>
                    </label>
                </div>
                <div id="subjectSelect">
                    <select name="subjectId" id="subjectId"
                            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition">
                        <option value="">-- Chọn Môn Học --</option>
                        @foreach (var subject in ViewData["Subjects"] as List<QuizlyWebsite.Models.TbSubject> ?? new List<QuizlyWebsite.Models.TbSubject>())
                        {
                            <option value="@subject.Id" selected="@(Model?.SubjectId == subject.Id)">@subject.Title</option>
                        }
                    </select>
                </div>
                <div id="subjectInput" class="hidden">
                    <input type="text" name="newSubjectTitle" id="newSubjectTitle" placeholder="Tên môn học mới"
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition mb-3">
                    @* <select name="newSubjectCategoryId" id="newSubjectCategoryId"
                            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition">
                        <option value="">-- Chọn Danh Mục --</option>
                        @foreach (var category in ViewData["Categories"] as List<QuizlyWebsite.Models.TbCategory> ?? new List<QuizlyWebsite.Models.TbCategory>())
                        {
                            <option value="@category.Id">@category.Title</option>
                        }
                    </select> *@
                </div>
            </div>

            <div>
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50">
                        <span class="material-symbols-outlined align-middle mr-1 text-primary">category</span>
                        Danh Mục
                    </label>
                    <label class="flex items-center gap-2 text-xs">
                        <input type="checkbox" id="useNewCategory" name="useNewCategory" value="true" onchange="toggleCategoryInput()">
                        <span>Tạo mới</span>
                    </label>
                </div>
                <div id="categorySelect">
                    <select name="categoryId" id="categoryId"
                            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition">
                        <option value="">-- Chọn Danh Mục --</option>
                        @foreach (var category in ViewData["Categories"] as List<QuizlyWebsite.Models.TbCategory> ?? new List<QuizlyWebsite.Models.TbCategory>())
                        {
                            <option value="@category.Id">@category.Title</option>
                        }
                    </select>
                </div>
                <div id="categoryInput" class="hidden">
                    <input type="text" name="newCategoryTitle" id="newCategoryTitle" placeholder="Tên danh mục mới"
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition">
                </div>
            </div>
        </div>

        <!-- Questions & Duration -->
        <div class="grid grid-cols-2 gap-6 mb-6">
            <div>
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">help</span>
                    Số Câu Hỏi
                </label>
                <input type="number" name="questionCount" value="@Model?.QuestionCount" placeholder="0" min="1"
                       class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                       required>
            </div>

            <div>
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">schedule</span>
                    Thời Gian (phút)
                </label>
                <input type="number" name="duration" value="@Model?.Duration" placeholder="0" min="1"
                       class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                       required>
            </div>
        </div>

        <!-- Image Upload -->
        <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">image</span>
                Ảnh Đề Thi (tùy chọn)
            </label>
            <input type="file" name="imageFile" id="imageFile" accept="image/*"
                   class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-primary-dark">
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Chọn ảnh từ máy tính (JPG, PNG, GIF - tối đa 5MB)</p>
            
            <!-- Preview uploaded image -->
            <div id="imagePreview" class="mt-3 hidden">
                <p class="text-xs text-gray-600 dark:text-gray-400 mb-2">Ảnh đã chọn:</p>
                <img id="previewImg" src="" alt="Preview" class="w-48 h-32 object-cover rounded-lg border border-gray-300 dark:border-gray-600">
            </div>

            <!-- Current image if exists -->
            @if (!string.IsNullOrEmpty(Model?.ImageUrl))
            {
                <div class="mt-3">
                    <p class="text-xs text-gray-600 dark:text-gray-400 mb-2">Ảnh hiện tại:</p>
                    <img src="@Model.ImageUrl" alt="Current" class="w-48 h-32 object-cover rounded-lg border border-gray-300 dark:border-gray-600">
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Chọn ảnh mới để thay thế</p>
                </div>
            }
        </div>

        <!-- Difficulty -->
        <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">speed</span>
                Độ Khó
            </label>
            <div class="flex gap-4">
                @foreach (var difficulty in new[] { "Dễ", "Trung bình", "Khó" })
                {
                    <label class="flex items-center gap-2">
                        <input type="radio" name="difficulty" value="@difficulty" @(Model?.Difficulty == difficulty ? "checked" : "") required>
                        <span>@difficulty</span>
                    </label>
                }
            </div>
        </div>

        <div class="grid grid-cols-2 gap-6 mb-6">
            <!-- Loại Đề -->
            <div>
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">card_membership</span>
                    Loại Đề
                </label>
                <div class="flex gap-4">
                    <label class="flex items-center gap-2">
                        <input type="radio" name="isPremium" value="false"
                               @(Model?.IsPremium != true ? "checked" : "")
                               onchange="document.getElementById('priceSection').classList.add('hidden')">
                        <span class="text-[#0d141b] dark:text-slate-50">Miễn Phí</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="radio" name="isPremium" value="true"
                               @(Model?.IsPremium == true ? "checked" : "")
                               onchange="document.getElementById('priceSection').classList.remove('hidden')">
                        <span class="text-[#0d141b] dark:text-slate-50">Premium</span>
                    </label>
                </div>
            </div>

            <!-- Giá -->
            <div id="priceSection" class="@(Model?.IsPremium == true ? "" : "hidden")">
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">attach_money</span>
                    Giá (₫)
                </label>
                <input type="number" name="price" value="@Model?.Price" min="0" step="1000"
                       class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" 
                       placeholder="0" />
            </div>
        </div>


        <!-- Status -->
        <div class="mb-6">
            <label class="flex items-center gap-2">
                <input type="checkbox" name="active">
                <span class="text-sm font-semibold text-[#0d141b] dark:text-slate-50">Kích Hoạt Đề Thi</span>
            </label>
        </div>

        <!-- Buttons -->
        <div class="flex gap-3">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">save</span>
                @(Model?.Id > 0 ? "Cập Nhật" : "Tạo Mới")
            </button>
            <a href="/admin/exams" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">close</span>
                Hủy
            </a>
        </div>

    </div>
</form>

<script>
    // Preview image before upload
    document.getElementById('imageFile')?.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.getElementById('imagePreview');
                const img = document.getElementById('previewImg');
                img.src = e.target.result;
                preview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        } else {
            document.getElementById('imagePreview').classList.add('hidden');
        }
    });

    // Toggle subject input
    function toggleSubjectInput() {
        const useNew = document.getElementById('useNewSubject').checked;
        const selectDiv = document.getElementById('subjectSelect');
        const inputDiv = document.getElementById('subjectInput');
        const select = document.getElementById('subjectId');
        const input = document.getElementById('newSubjectTitle');
        const categorySelect = document.getElementById('newSubjectCategoryId');
        
        if (useNew) {
            // Khi tick "Tạo mới": Ẩn dropdown, hiện input, bỏ required khỏi dropdown
            selectDiv.classList.add('hidden');
            inputDiv.classList.remove('hidden');
            select.removeAttribute('required');
            select.value = ''; // Xóa giá trị đã chọn
            input.setAttribute('required', 'required'); // Input là bắt buộc
            if (categorySelect) {
                categorySelect.removeAttribute('required');
            }
        } else {
            selectDiv.classList.remove('hidden');
            inputDiv.classList.add('hidden');
            select.setAttribute('required', 'required');
            input.removeAttribute('required');
            input.value = ''; // Xóa giá trị input
            if (categorySelect) {
                categorySelect.removeAttribute('required');
            }
        }
    }
    
    // Khởi tạo trạng thái ban đầu khi trang load
    document.addEventListener('DOMContentLoaded', function() {
        toggleSubjectInput();
    });

    // Toggle category input
    function toggleCategoryInput() {
        const useNew = document.getElementById('useNewCategory').checked;
        const selectDiv = document.getElementById('categorySelect');
        const inputDiv = document.getElementById('categoryInput');
        const select = document.getElementById('categoryId');
        const input = document.getElementById('newCategoryTitle');
        
        if (useNew) {
            selectDiv.classList.add('hidden');
            inputDiv.classList.remove('hidden');
            select.removeAttribute('required');
            select.value = ''; // Xóa giá trị đã chọn
            input.setAttribute('required', 'required'); // Input là bắt buộc
        } else {
            // Khi không tick: Hiện dropdown, ẩn input, dropdown là bắt buộc
            selectDiv.classList.remove('hidden');
            inputDiv.classList.add('hidden');
            select.setAttribute('required', 'required');
            input.removeAttribute('required');
            input.value = ''; // Xóa giá trị input
        }
    }
    
    // Khởi tạo trạng thái ban đầu cho category
    document.addEventListener('DOMContentLoaded', function() {
        toggleCategoryInput();
    });
</script>
