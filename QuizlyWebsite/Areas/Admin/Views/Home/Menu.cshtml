@model List<QuizlyWebsite.Models.TbMenu>

@{
    ViewData["Title"] = "Quản Lý Menu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Header -->
<div class="mb-8">
    <h2 class="text-3xl font-bold">Quản Lý Menu</h2>
    <p class="text-[#4c739a] dark:text-slate-400 mt-2">Cấu hình menu điều hướng của website</p>
</div>

<!-- Success Message -->
@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}

<!-- Menu Configuration Form -->
<form method="post" action="/admin/menu" class="max-w-4xl">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8">

        <div class="mb-6">
            <h3 class="text-xl font-bold mb-4">Menu Chính</h3>
            
            <div class="space-y-4" id="menuItemsContainer">
                @if (Model != null && Model.Any())
                {
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var menu = Model[i];
                        <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                                <div>
                                    <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Tên Menu</label>
                                    <input type="text" name="menuItems[@i].Title" value="@menu.Title" 
                                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">URL</label>
                                    <input type="text" name="menuItems[@i].Url" value="@menu.Url" 
                                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Thứ Tự</label>
                                    <input type="number" name="menuItems[@i].Order" value="@(menu.Order ?? (i + 1))" min="1" 
                                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50" required>
                                </div>
                                <div class="flex items-end">
                                    <button type="button" onclick="removeMenuItem(this)" class="w-full px-4 py-2 bg-danger text-white rounded-lg hover:bg-red-700 transition text-sm">
                                        <span class="material-symbols-outlined align-middle">delete</span> Xóa
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-[#4c739a] dark:text-slate-400 text-center py-8">Chưa có menu item nào. Vui lòng thêm menu item mới.</p>
                }
            </div>

            <button type="button" onclick="addMenuItem()" class="mt-4 px-4 py-2 bg-primary text-white rounded-lg hover:bg-blue-700 transition text-sm font-semibold">
                <span class="material-symbols-outlined align-middle mr-1">add</span>
                Thêm Menu Item
            </button>
        </div>

        <!-- Buttons -->
        <div class="flex gap-3 mt-6">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">save</span>
                Lưu Thay Đổi
            </button>
            <button type="button" onclick="window.location.reload()" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">refresh</span>
                Làm Mới
            </button>
        </div>

    </div>
</form>

@section Scripts {
    <script>
        let menuItemIndex = @(Model?.Count ?? 0); // Start from current count

        function addMenuItem() {
            const container = document.getElementById('menuItemsContainer');
            const newItem = document.createElement('div');
            newItem.className = 'border border-gray-200 dark:border-gray-700 rounded-lg p-4';
            newItem.innerHTML = `
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Tên Menu</label>
                        <input type="text" name="menuItems[${menuItemIndex}].Title" placeholder="Nhập tên menu" 
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50" required>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">URL</label>
                        <input type="text" name="menuItems[${menuItemIndex}].Url" placeholder="/url" 
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50" required>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Thứ Tự</label>
                        <input type="number" name="menuItems[${menuItemIndex}].Order" value="${menuItemIndex + 1}" min="1" 
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50" required>
                    </div>
                    <div class="flex items-end">
                        <button type="button" onclick="removeMenuItem(this)" class="w-full px-4 py-2 bg-danger text-white rounded-lg hover:bg-red-700 transition text-sm">
                            <span class="material-symbols-outlined align-middle">delete</span> Xóa
                        </button>
                    </div>
                </div>
            `;
            container.appendChild(newItem);
            menuItemIndex++;
        }

        function removeMenuItem(button) {
            if (confirm('Bạn có chắc chắn muốn xóa menu item này?')) {
                button.closest('.border').remove();
            }
        }
    </script>
}
