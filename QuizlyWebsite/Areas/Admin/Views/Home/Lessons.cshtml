@model List<QuizlyWebsite.Models.TbLesson>

@{
    var course = ViewData["Course"] as QuizlyWebsite.Models.TbCourse;
    ViewData["Title"] = $"Quản Lý Bài Học - {course?.Title}";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Error"]</p>
    </div>
}

<div class="mb-8">
    <a href="/admin/courses" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-3xl font-bold">Quản Lý Bài Học</h2>
            <p class="text-[#4c739a] dark:text-slate-400 mt-2">Khóa học: @course?.Title</p>
        </div>
        <a href="/admin/lesson-form?courseId=@course?.Id" class="px-6 py-2 bg-primary text-white rounded-lg font-semibold hover:bg-blue-700 transition flex items-center gap-2">
            <span class="material-symbols-outlined">add</span> Thêm Bài Học
        </a>
    </div>
</div>

<!-- Table -->
<div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
    <table class="w-full">
        <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
            <tr>
                <th class="px-6 py-3 text-left text-sm font-semibold">STT</th>
                <th class="px-6 py-3 text-left text-sm font-semibold">Tên Bài Học</th>
                <th class="px-6 py-3 text-left text-sm font-semibold">Preview</th>
                <th class="px-6 py-3 text-left text-sm font-semibold">Trạng Thái</th>
                <th class="px-6 py-3 text-left text-sm font-semibold">Ngày Tạo</th>
                <th class="px-6 py-3 text-left text-sm font-semibold">Hành Động</th>
            </tr>
        </thead>
        <tbody>
            @{ int index = 1; }
            @foreach (var lesson in Model)
            {
                <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                    <td class="px-6 py-4">@index</td>
                    <td class="px-6 py-4 font-semibold">@lesson.Title</td>
                    <td class="px-6 py-4">
                        <span class="text-xs font-semibold px-3 py-1 rounded-full @(lesson.IsPreview == true ? "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400" : "bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400")">
                            @(lesson.IsPreview == true ? "Preview" : "Bình thường")
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        <span class="text-xs font-semibold px-3 py-1 rounded-full @(lesson.IsApproved == true ? "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400" : "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400")">
                            @(lesson.IsApproved == true ? "Đã Duyệt" : "Chờ Duyệt")
                        </span>
                    </td>
                    <td class="px-6 py-4 text-sm">@lesson.CreatedAt?.ToString("dd/MM/yyyy")</td>
                    <td class="px-6 py-4 text-sm">
                        <div class="flex gap-2">
                            <a href="/admin/lesson-form/@lesson.Id" class="text-primary hover:underline">Sửa</a>
                            <button onclick="deleteLesson(@lesson.Id, @course.Id)" class="text-danger hover:underline">Xóa</button>
                        </div>
                    </td>
                </tr>
                index++;
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center mt-6">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">menu_book</span>
        <p class="text-[#4c739a] dark:text-slate-400">Khóa học này chưa có bài học nào.</p>
    </div>
}

@section Scripts {
    <script>
        async function deleteLesson(id, courseId) {
            if (!confirm('Bạn có chắc chắn muốn xóa bài học này?')) return;

            try {
                const response = await fetch('/admin/delete-lesson', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ id: id })
                });

                const data = await response.json();
                if (data.success) {
                    alert('Bài học đã được xóa thành công');
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            } catch (error) {
                alert('Lỗi: ' + error.message);
            }
        }
    </script>
}

