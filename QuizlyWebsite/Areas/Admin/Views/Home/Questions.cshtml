@model List<QuizlyWebsite.Models.TbQuestion>

@{
    ViewData["Title"] = "Quản Lý Câu Hỏi";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Header -->
<div class="mb-8">
    <h2 class="text-3xl font-bold">Quản Lý Câu Hỏi</h2>
    <p class="text-[#4c739a] dark:text-slate-400 mt-2">Chọn đề thi để xem và quản lý câu hỏi</p>
</div>

@{
    var exam = ViewData["Exam"] as dynamic;
    var hasExam = exam != null;
}

@if (hasExam)
{
    <!-- Exam Header - Always show when exam is selected -->
    <div class="bg-gradient-to-r from-primary to-blue-600 rounded-xl p-6 mb-8 text-white">
        <div class="flex justify-between items-start">
            <div>
                <h3 class="text-2xl font-bold mb-2">@exam?.Title</h3>
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <p class="text-blue-100 text-sm">Tổng Câu Hỏi</p>
                        <p class="text-2xl font-bold">@(ViewData["TotalQuestions"] ?? 0)</p>
                    </div>
                    <div>
                        <p class="text-blue-100 text-sm">Độ Khó</p>
                        <p class="text-2xl font-bold">@exam?.Difficulty</p>
                    </div>
                    <div>
                        <p class="text-blue-100 text-sm">Thời Gian</p>
                        <p class="text-2xl font-bold">@exam?.Duration phút</p>
                    </div>
                </div>
            </div>
            <div class="flex gap-3">
                <a href="/admin/question-form?examId=@exam?.Id" class="px-6 py-3 bg-white text-primary rounded-lg font-semibold hover:bg-gray-100 transition flex items-center gap-2">
                    <span class="material-symbols-outlined">add</span>
                    Thêm Câu Hỏi
                </a>
                <button onclick="showImportModal()" class="px-6 py-3 bg-white text-primary rounded-lg font-semibold hover:bg-gray-100 transition flex items-center gap-2">
                    <span class="material-symbols-outlined">upload_file</span>
                    Import Câu Hỏi
                </button>
                <button onclick="normalizeMarks(@exam?.Id)" class="px-6 py-3 bg-white text-warning rounded-lg font-semibold hover:bg-yellow-100 transition flex items-center gap-2" title="Chuẩn hóa điểm số để tổng = 10 điểm">
                    <span class="material-symbols-outlined">calculate</span>
                    Chuẩn Hóa Điểm
                </button>
            </div>
        </div>
    </div>

    @if (Model?.Count > 0)
    {
        <!-- Questions Table -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                        <tr>
                            <th class="px-6 py-4 text-left text-sm font-semibold">STT</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold">Nội Dung Câu</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold">Điểm</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold">Đáp Án Đúng</th>
                            <th class="px-6 py-4 text-center text-sm font-semibold">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 1;
                        }
                        @foreach (var question in Model)
                        {
                            <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                                <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@(index)</td>
                                <td class="px-6 py-4 text-[#0d141b] dark:text-slate-50 max-w-md" title="@question.Content">
                                    @(question.Content?.Length > 60 ? question.Content.Substring(0, 60) + "..." : question.Content)
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-xs font-semibold px-3 py-1 rounded-full bg-success/20 text-success">
                                        @(question.Marks ?? 0) điểm
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-[#0d141b] dark:text-slate-50 font-bold text-lg">@(question.CorrectOption ?? "N/A")</td>
                                <td class="px-6 py-4 text-sm">
                                    <div class="flex gap-3 justify-center">
                                        <a href="/admin/question-form/@question.Id?examId=@exam?.Id" class="text-primary hover:text-blue-700 font-semibold" title="Chỉnh sửa">
                                            <span class="material-symbols-outlined text-lg">edit</span>
                                        </a>
                                        <button class="text-danger hover:text-red-700 font-semibold" title="Xóa" onclick="deleteQuestion(@question.Id)">
                                            <span class="material-symbols-outlined text-lg">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            @{
                var totalPages = (int)(ViewData["TotalPages"] ?? 1);
                var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
                var totalQuestions = (int)(ViewData["TotalQuestions"] ?? 0);
            }
            @if (totalPages > 1)
            {
                <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-between items-center">
                    <div class="text-sm text-[#4c739a] dark:text-slate-400">
                        Hiển thị @((currentPage - 1) * 10 + 1) - @(Math.Min(currentPage * 10, totalQuestions)) trong tổng số @totalQuestions câu hỏi
                    </div>
                    <div class="flex gap-2">
                        @if (currentPage > 1)
                        {
                            <a href="/admin/questions?examId=@exam?.Id&page=@(currentPage - 1)" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition">
                                Trước
                            </a>
                        }
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <a href="/admin/questions?examId=@exam?.Id&page=@i" class="px-4 py-2 @(i == currentPage ? "bg-primary text-white" : "bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50") rounded-lg hover:bg-primary hover:text-white transition">
                                @i
                            </a>
                        }
                        @if (currentPage < totalPages)
                        {
                            <a href="/admin/questions?examId=@exam?.Id&page=@(currentPage + 1)" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition">
                                Sau
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State - No questions yet -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
            <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">quiz</span>
            <p class="text-[#4c739a] dark:text-slate-400 text-lg mb-4">Đề thi này chưa có câu hỏi nào</p>
        </div>
    }
}
else
{
    <!-- Exams List to Select From -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @{
            var exams = (List<TbExam>)ViewData["Exams"] ?? new List<TbExam>();
        }
        @foreach (var examItem in exams)
        {
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:shadow-lg transition cursor-pointer" onclick="location.href='/admin/questions?examId=@examItem.Id'">
                <div class="flex items-start justify-between mb-4">
                    <h3 class="text-lg font-bold text-[#0d141b] dark:text-slate-50 flex-1">@examItem.Title</h3>
                    <span class="text-xs font-semibold px-2 py-1 rounded-full bg-primary/20 text-primary">
                        @(examItem.QuestionCount) câu
                    </span>
                </div>
                <p class="text-[#4c739a] dark:text-slate-400 text-sm mb-4">Môn: @examItem.Subject?.Title</p>
                <div class="grid grid-cols-2 gap-2 text-sm">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-warning">schedule</span>
                        <span>@examItem.Duration phút</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-info">difficulty</span>
                        <span>@examItem.Difficulty</span>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (exams.Count == 0)
    {
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
            <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">assignment_question_mark</span>
            <p class="text-[#4c739a] dark:text-slate-400">Không có đề thi nào. Vui lòng <a href="/admin/exams" class="text-primary hover:underline">tạo đề thi</a> trước.</p>
        </div>
    }
}

<link rel="stylesheet" href="~/css/site.css" />

<!-- Success Message -->
@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="text-sm font-semibold">@TempData["Success"]</p>
    </div>
}

<!-- Error Message -->
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
        <p class="text-sm font-semibold">@TempData["Error"]</p>
    </div>
}

<!-- Import Modal -->
<div id="importModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50" style="display: none;">
    <div class="bg-white dark:bg-gray-800 rounded-xl p-8 max-w-4xl w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-2xl font-bold">Import Câu Hỏi</h3>
            <button onclick="hideImportModal()" class="text-gray-500 hover:text-gray-700">
                <span class="material-symbols-outlined text-2xl">close</span>
            </button>
        </div>

        <div class="mb-4">
            <div class="flex gap-3 border-b border-gray-200 dark:border-gray-700">
                <button onclick="showImportTab('word')" id="btnWordTab" class="px-4 py-2 font-semibold border-b-2 border-primary text-primary">
                    📄 File Word
                </button>
                <button onclick="showImportTab('text')" id="btnTextTab" class="px-4 py-2 font-semibold border-b-2 border-transparent text-gray-500 hover:text-primary">
                    📝 Văn Bản
                </button>
            </div>
        </div>

        <!-- Word Import -->
        <div id="wordImportTab" style="display: none;">
            <input type="file" id="wordFileInput" accept=".docx" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg mb-4">
            <button onclick="importFromWordAdmin(@exam?.Id)" class="w-full px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition">
                ⬆️ Import từ file Word
            </button>
        </div>

        <!-- Text Import -->
        <div id="textImportTab">
            <textarea id="textImportInput" rows="15" placeholder="Dán nội dung đề thi theo định dạng:
                Câu hỏi: React là gì?

                A. Một ngôn ngữ lập trình
                *B. Một thư viện JavaScript
                C. Một framework backend
                D. Một cơ sở dữ liệu

                Câu hỏi: JavaScript là gì?

                A. Một framework
                *B. Một ngôn ngữ lập trình
                C. Một thư viện CSS
                D. Một database" 
            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg font-mono text-sm mb-4"></textarea>
            <button onclick="importFromTextAdmin(@exam?.Id)" class="w-full px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition">
                Import từ văn bản
            </button>
        </div>

        <!-- Import Status -->
        <div id="importStatus" class="mt-4" style="display: none;"></div>
    </div>
</div>

<div id="messageBox"> 
    @section Scripts {
    <script>
        async function deleteQuestion(id) {
            if (!confirm('Bạn có chắc chắn muốn xóa câu hỏi này?')) return;

            try {
                const response = await fetch('/admin/delete-question', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ id: id })
                });

                const data = await response.json();
                if (data.success) {
                    alert('Câu hỏi đã được xóa thành công');
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            } catch (error) {
                alert('Lỗi: ' + error.message);
            }
        }

        function showImportModal() {
            document.getElementById('importModal').style.display = 'flex';
            showImportTab('text');
        }

        function hideImportModal() {
            document.getElementById('importModal').style.display = 'none';
            document.getElementById('importStatus').style.display = 'none';
            document.getElementById('textImportInput').value = '';
            document.getElementById('wordFileInput').value = '';
        }

        function showImportTab(tab) {
            const wordTab = document.getElementById('wordImportTab');
            const textTab = document.getElementById('textImportTab');
            const btnWord = document.getElementById('btnWordTab');
            const btnText = document.getElementById('btnTextTab');
            
            if (tab === 'word') {
                wordTab.style.display = 'block';
                textTab.style.display = 'none';
                btnWord.classList.add('border-primary', 'text-primary');
                btnWord.classList.remove('border-transparent', 'text-gray-500');
                btnText.classList.add('border-transparent', 'text-gray-500');
                btnText.classList.remove('border-primary', 'text-primary');
            } else {
                wordTab.style.display = 'none';
                textTab.style.display = 'block';
                btnText.classList.add('border-primary', 'text-primary');
                btnText.classList.remove('border-transparent', 'text-gray-500');
                btnWord.classList.add('border-transparent', 'text-gray-500');
                btnWord.classList.remove('border-primary', 'text-primary');
            }
        }

        async function importFromTextAdmin(examId) {
            const textInput = document.getElementById('textImportInput');
            const text = textInput.value.trim();
            const statusDiv = document.getElementById('importStatus');
            
            if (!text) {
                statusDiv.innerHTML = '<div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4">⚠️ Vui lòng nhập hoặc dán nội dung đề thi</div>';
                statusDiv.style.display = 'block';
                return;
            }
            
            statusDiv.innerHTML = '<div class="bg-info/10 border border-info/30 text-info rounded-lg p-4">⏳ Đang xử lý văn bản...</div>';
            statusDiv.style.display = 'block';
            
            try {
                const response = await fetch('/admin/import-questions', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ examId: examId, text: text })
                });
                
                const result = await response.json();
                handleImportResultAdmin(result);
            } catch (error) {
                statusDiv.innerHTML = `<div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4">❌ Lỗi: ${error.message}</div>`;
            }
        }

        async function importFromWordAdmin(examId) {
            const fileInput = document.getElementById('wordFileInput');
            const file = fileInput.files[0];
            const statusDiv = document.getElementById('importStatus');
            
            if (!file) {
                statusDiv.innerHTML = '<div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4">⚠️ Vui lòng chọn file Word (.docx)</div>';
                statusDiv.style.display = 'block';
                return;
            }
            
            statusDiv.innerHTML = '<div class="bg-info/10 border border-info/30 text-info rounded-lg p-4">⏳ Đang xử lý file...</div>';
            statusDiv.style.display = 'block';
            
            try {
                const formData = new FormData();
                formData.append('file', file);
                
                const response = await fetch(`/admin/import-questions-word?examId=${examId}`, {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                handleImportResultAdmin(result);
            } catch (error) {
                statusDiv.innerHTML = `<div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4">❌ Lỗi: ${error.message}</div>`;
            }
        }

        function handleImportResultAdmin(result) {
            const statusDiv = document.getElementById('importStatus');
            
            if (result.success) {
                let statusHtml = `<div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-2">
                    <strong>✅ ${result.message}</strong><br>
                    - Tổng số câu hỏi: ${result.report.totalQuestions}<br>
                    - Câu hỏi hợp lệ: ${result.report.validCount}<br>
                    - Đã lưu: ${result.report.savedCount}<br>
                    - Câu hỏi lỗi: ${result.report.errorCount}
                </div>`;
                
                if (result.report.errorCount > 0 && result.report.errors.length > 0) {
                    statusHtml += `<div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4">
                        <strong>⚠️ Lỗi:</strong><br>
                        ${result.report.errors.map(e => `Câu ${e.questionNumber}: ${e.errorReason}`).join('<br>')}
                    </div>`;
                }
                
                statusDiv.innerHTML = statusHtml;
                
                // Reload page after 2 seconds
                setTimeout(() => {
                    window.location.reload();
                }, 2000);
            } else {
                statusDiv.innerHTML = `<div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4">❌ ${result.message}</div>`;
            }
        }

        // Close modal when clicking outside
        document.getElementById('importModal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                hideImportModal();
            }
        });

        async function normalizeMarks(examId) {
            if (!confirm('Bạn có chắc chắn muốn chuẩn hóa điểm số? Tất cả điểm số sẽ được điều chỉnh để tổng = 10 điểm.')) return;

            try {
                const response = await fetch(`/admin/normalize-exam-marks/${examId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await response.json();
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            } catch (error) {
                alert('Lỗi: ' + error.message);
            }
        }
    </script>
    </div>
}
