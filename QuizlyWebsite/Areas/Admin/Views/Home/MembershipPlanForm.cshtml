@model QuizlyWebsite.Models.TbMembershipPlan

@{
    ViewData["Title"] = Model?.Id > 0 ? "Chỉnh Sửa Gói Hội Viên" : "Thêm Gói Hội Viên Mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Header -->
<div class="mb-8">
    <a href="/admin/membership-plans" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">@ViewData["Title"]</h2>
</div>

<!-- Form -->
<form method="post" action="@(Model?.Id > 0 ? $"/admin/membership-plan-form/{Model.Id}" : "/admin/membership-plan-form")" class="max-w-2xl">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8">
        
        <!-- Error Messages -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="text-sm">@error.ErrorMessage</p>
                }
            </div>
        }

        <!-- Plan Name -->
        <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">card_membership</span>
                Tên Gói
            </label>
            <input type="text" name="title" value="@Model?.Title" placeholder="VD: Gói Premium 1 tháng" 
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                required>
        </div>

        <!-- Description -->
        <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">description</span>
                Mô Tả (Tùy Chọn)
            </label>
            <textarea name="description" placeholder="Mô tả gói hội viên" rows="3"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"></textarea>
        </div>

        <!-- Price & Duration -->
        <div class="grid grid-cols-2 gap-6 mb-6">
            <div>
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">attach_money</span>
                    Giá (đ)
                </label>
                <input type="number" name="price" value="@Model?.Price" placeholder="0" min="0" step="1000"
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                    required>
            </div>

            <div>
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">calendar_month</span>
                    Thời Hạn (ngày)
                </label>
                <input type="number" name="durationDays" value="@Model?.DurationDays" placeholder="30" min="1"
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                    required>
            </div>
        </div>

        <!-- Features -->
        <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">check_circle</span>
                Tính Năng (Tùy Chọn - cách nhau bằng dấu phẩy)
            </label>
            <textarea name="features" placeholder="VD: Truy cập đề thi, Luyện tập không giới hạn, Xem giải thích chi tiết" rows="4"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"></textarea>
        </div>

        <!-- Buttons -->
        <div class="flex gap-3">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">save</span>
                @(Model?.Id > 0 ? "Cập Nhật" : "Tạo Mới")
            </button>
            <a href="/admin/membership-plans" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">close</span>
                Hủy
            </a>
        </div>

    </div>
</form>
