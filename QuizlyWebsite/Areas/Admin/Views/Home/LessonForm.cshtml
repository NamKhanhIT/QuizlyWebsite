@model QuizlyWebsite.Models.TbLesson

@{
    ViewData["Title"] = Model?.Id > 0 ? "Chỉnh Sửa Bài Học" : "Thêm Bài Học Mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var courses = ViewData["Courses"] as List<QuizlyWebsite.Models.TbCourse> ?? new List<QuizlyWebsite.Models.TbCourse>();
}

<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Error"]</p>
    </div>
}
<div asp-validation-summary="All"></div>
<!-- Header -->
<div class="mb-8">
    <a href="@(Model?.CourseId > 0 ? $"/admin/courses/{Model.CourseId}/lessons" : "/admin/courses")" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">@ViewData["Title"]</h2>
</div>

<!-- Form -->
<form method="post" action="@(Model?.Id > 0 ? $"/admin/lesson-form/{Model.Id}" : "/admin/lesson-form")" class="max-w-4xl">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8">

        <!-- Error Messages -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="text-sm">@error.ErrorMessage</p>
                }
            </div>
        }

        <!-- Course Selection -->
        <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">menu_book</span>
                Khóa Học *
            </label>
            <select name="courseId" required
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                    @(Model?.Id > 0 ? "disabled" : "")>
                <option value="">-- Chọn Khóa Học --</option>
                @foreach (var course in courses)
                {
                    <option value="@course.Id" selected="@(Model?.CourseId == course.Id)">@course.Title</option>
                }
            </select>
            @if (Model?.Id > 0)
            {
                <input type="hidden" name="courseId" value="@Model.CourseId">
            }
        </div>

        <!-- Title -->
        <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">edit</span>
                Tên Bài Học *
            </label>
            <input type="text" name="title" value="@Model?.Title" placeholder="Nhập tên bài học"
                   class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                   required>
        </div>

        <!-- Content -->
        <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                <span class="material-symbols-outlined align-middle mr-1 text-primary">description</span>
                Nội Dung Bài Học *
            </label>
            <textarea name="content" rows="15" placeholder="Nhập nội dung bài học (HTML được hỗ trợ)"
                      class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition font-mono text-sm"
                      required>@Model?.Content</textarea>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Bạn có thể sử dụng HTML để định dạng nội dung</p>
        </div>

        <!-- Preview -->
        <div class="mb-6">
            <label class="flex items-center gap-2">
                <input type="checkbox" name="isPreview" value="true" checked="@(Model?.IsPreview == true)">
                <span class="text-sm font-semibold text-[#0d141b] dark:text-slate-50">Bài học Preview (miễn phí)</span>
            </label>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 ml-6">Bài học preview sẽ được hiển thị miễn phí cho người dùng chưa đăng ký gói</p>
        </div>

        <!-- Buttons -->
        <div class="flex gap-3">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">save</span>
                @(Model?.Id > 0 ? "Cập Nhật" : "Tạo Mới")
            </button>
            <a href="@(Model?.CourseId > 0 ? $"/admin/courses/{Model.CourseId}/lessons" : "/admin/courses")" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">close</span>
                Hủy
            </a>
        </div>

    </div>
</form>

