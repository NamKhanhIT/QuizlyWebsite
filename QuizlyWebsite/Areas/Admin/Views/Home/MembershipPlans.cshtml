@model List<QuizlyWebsite.Models.TbMembershipPlan>

@{
    ViewData["Title"] = "Quản Lý Gói Hội Viên";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Header -->
<div class="flex justify-between items-center mb-8">
    <h2 class="text-3xl font-bold">Quản Lý Gói Hội Viên</h2>
    <a href="/admin/membership-plan-form" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition flex items-center gap-2">
        <span class="material-symbols-outlined">add_circle</span>
        Thêm Gói Mới
    </a>
</div>

<!-- Grid View -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    @foreach (var plan in Model)
    {
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:shadow-lg transition">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <h3 class="text-lg font-bold text-[#0d141b] dark:text-slate-50">@plan.Title</h3>
                    <p class="text-[#4c739a] dark:text-slate-400 text-sm">@(plan.DurationDays) ngày</p>
                </div>
                <div class="flex gap-2">
                    <a href="/admin/membership-plan-form/@plan.Id" class="text-primary hover:text-primary-dark" title="Chỉnh sửa">
                        <span class="material-symbols-outlined text-sm">edit</span>
                    </a>
                    <button class="text-danger hover:text-red-700" title="Xóa" onclick="deletePlan(@plan.Id)">
                        <span class="material-symbols-outlined text-sm">delete</span>
                    </button>
                </div>
            </div>

            <div class="mb-4">
                <p class="text-3xl font-black text-primary">@(plan.Price?.ToString("N0") ?? "0")đ</p>
            </div>
        </div>
    }
</div>

<!-- Empty State -->
@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">card_membership</span>
        <p class="text-[#4c739a] dark:text-slate-400">Chưa có gói hội viên nào. <a href="/admin/membership-plan-form" class="text-primary hover:underline">Tạo gói mới</a></p>
    </div>
}

@section Scripts {
    <script>
        async function deletePlan(id) {
            if (!confirm('Bạn có chắc chắn muốn xóa gói này?')) return;

            try {
                const response = await fetch('/admin/delete-membership-plan', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ id: id })
                });

                const data = await response.json();
                if (data.success) {
                    alert('Gói hội viên đã được xóa thành công');
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            } catch (error) {
                alert('Lỗi: ' + error.message);
            }
        }
    </script>
}
