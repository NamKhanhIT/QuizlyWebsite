@model List<QuizlyWebsite.Models.TbPayment>

@{
    ViewData["Title"] = "Quản Lý Thanh Toán";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Header -->
<div class="mb-8">
    <h2 class="text-3xl font-bold mb-2">Thanh Toán & Doanh Thu</h2>
    <p class="text-[#4c739a] dark:text-slate-400">Quản lý tất cả các giao dịch thanh toán của hệ thống</p>
</div>

<!-- Revenue Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Total Revenue -->
    <div class="bg-gradient-to-br from-primary/10 to-blue-50 dark:from-primary/20 dark:to-blue-900/20 rounded-xl border border-primary/30 p-6">
        <div class="flex items-center justify-between mb-3">
            <p class="text-[#4c739a] dark:text-slate-400 text-sm font-medium">Tổng Doanh Thu</p>
            <span class="material-symbols-outlined text-primary text-2xl">attach_money</span>
        </div>
        <p class="text-4xl font-black text-primary">@(((decimal?)ViewData["TotalRevenue"] ?? 0).ToString("N0"))đ</p>
    </div>

    <!-- Completed Payments -->
    <div class="bg-gradient-to-br from-success/10 to-green-50 dark:from-success/20 dark:to-green-900/20 rounded-xl border border-success/30 p-6">
        <div class="flex items-center justify-between mb-3">
            <p class="text-[#4c739a] dark:text-slate-400 text-sm font-medium">Giao Dịch Thành Công</p>
            <span class="material-symbols-outlined text-success text-2xl">check_circle</span>
        </div>
        <p class="text-4xl font-black text-success">@Model.Count(p => p.Status == "Completed")</p>
    </div>

    <!-- Pending Payments -->
    <div class="bg-gradient-to-br from-warning/10 to-orange-50 dark:from-warning/20 dark:to-orange-900/20 rounded-xl border border-warning/30 p-6">
        <div class="flex items-center justify-between mb-3">
            <p class="text-[#4c739a] dark:text-slate-400 text-sm font-medium">Chờ Xử Lý</p>
            <span class="material-symbols-outlined text-warning text-2xl">schedule</span>
        </div>
        <p class="text-4xl font-black text-warning">@Model.Count(p => p.Status == "Pending")</p>
    </div>
</div>

<!-- Payments Table -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="px-6 py-4 text-left text-sm font-semibold">ID</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Người Dùng</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Email</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Sản Phẩm</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Số Tiền</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Trạng Thái</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Ngày Giao Dịch</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model)
                {
                    <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">#@payment.Id</td>
                        <td class="px-6 py-4 text-[#0d141b] dark:text-slate-50 font-medium">@payment.User?.FullName ?? "N/A"</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@payment.User?.Email ?? "N/A"</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(payment.Exam?.Title ?? "Gói hội viên")</td>
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@(payment.Amount?.ToString("N0") ?? "0")đ</td>
                        <td class="px-6 py-4">
                            <span class="text-xs font-semibold px-3 py-1 rounded-full @(payment.Status == "Completed" ? "bg-success/20 text-success" : payment.Status == "Pending" ? "bg-warning/20 text-warning" : "bg-danger/20 text-danger")">
                                @(payment.Status switch
                                {
                                    "Completed" => "✓ Thành Công",
                                    "Pending" => "⏳ Chờ",
                                    "Failed" => "✗ Thất Bại",
                                    _ => payment.Status
                                })
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm text-[#4c739a] dark:text-slate-400">@payment.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A"</td>
                        <td class="px-6 py-4 text-sm">
                            <div class="flex gap-2">
                                <button class="text-primary hover:text-primary-dark" title="Xem chi tiết" onclick="viewPaymentDetails(@payment.Id)">
                                    <span class="material-symbols-outlined text-sm">visibility</span>
                                </button>
                                @if (payment.Status == "Pending")
                                {
                                    <button class="text-success hover:text-green-700" title="Xác nhận" onclick="confirmPayment(@payment.Id)">
                                        <span class="material-symbols-outlined text-sm">check_circle</span>
                                    </button>
                                    <button class="text-danger hover:text-red-700" title="Từ chối" onclick="rejectPayment(@payment.Id)">
                                        <span class="material-symbols-outlined text-sm">cancel</span>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Empty State -->
@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center mt-6">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">payment</span>
        <p class="text-[#4c739a] dark:text-slate-400">Không có giao dịch thanh toán nào.</p>
    </div>
}

@section Scripts {
    <script>
        function viewPaymentDetails(paymentId) {
            alert('Chi tiết giao dịch #' + paymentId);
        }
        
        function confirmPayment(paymentId) {
            if (confirm('Xác nhận giao dịch này?')) {
                fetch('/admin/update-payment-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: paymentId, status: 'Completed' })
                }).then(r => r.json()).then(d => {
                    if (d.success) {
                        alert(d.message);
                        location.reload();
                    } else {
                        alert(d.message || 'Lỗi xảy ra');
                    }
                });
            }
        }
        
        function rejectPayment(paymentId) {
            if (confirm('Bạn có chắc chắn muốn từ chối giao dịch này?')) {
                fetch('/admin/update-payment-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: paymentId, status: 'Failed' })
                }).then(r => r.json()).then(d => {
                    if (d.success) {
                        alert(d.message);
                        location.reload();
                    } else {
                        alert(d.message || 'Lỗi xảy ra');
                    }
                });
            }
        }
    </script>
}
