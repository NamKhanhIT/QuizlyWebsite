@model QuizlyWebsite.Models.TbUser

@{
    ViewData["Title"] = Model?.Id > 0 ? "Chỉnh Sửa Người Dùng" : "Thêm Người Dùng Mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Success Message -->
@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}

<!-- Header -->
<div class="mb-8">
    <a href="/admin/users" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">@ViewData["Title"]</h2>
</div>

<!-- Form -->
<form method="post" action="@(Model?.Id > 0 ? $"/admin/user-form/{Model.Id}" : "/admin/user-form")" class="max-w-4xl">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8">

        <!-- Error Messages -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="text-sm">@error.ErrorMessage</p>
                }
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Username -->
            <div>
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">person</span>
                    Tên Đăng Nhập *
                </label>
                <input type="text" name="username" value="@Model?.Username" placeholder="Nhập tên đăng nhập"
                       class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                       required @(Model?.Id > 0 ? "readonly" : "")>
            </div>

            <!-- Email -->
            <div>
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">email</span>
                    Email *
                </label>
                <input type="email" name="email" value="@Model?.Email" placeholder="Nhập email"
                       class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                       required>
            </div>

            <!-- Full Name -->
            <div>
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">badge</span>
                    Họ Tên
                </label>
                <input type="text" name="fullName" value="@Model?.FullName" placeholder="Nhập họ tên"
                       class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition">
            </div>

            <!-- Phone Number -->
            <div>
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">phone</span>
                    Số Điện Thoại
                </label>
                <input type="tel" name="phoneNumber" value="@Model?.PhoneNumber" placeholder="Nhập số điện thoại"
                       class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition">
            </div>

            <!-- Address -->
            <div class="md:col-span-2">
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">home</span>
                    Địa Chỉ
                </label>
                <input type="text" name="address" value="@Model?.Address" placeholder="Nhập địa chỉ"
                       class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition">
            </div>

            <!-- Avatar URL -->
            <div class="md:col-span-2">
                <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    <span class="material-symbols-outlined align-middle mr-1 text-primary">image</span>
                    Avatar URL
                </label>
                <input type="text" name="avatarUrl" value="@Model?.AvatarUrl" placeholder="Nhập URL ảnh đại diện"
                       class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition">
            </div>

            <!-- Password (only for new users) -->
            @if (Model?.Id == null || Model.Id == 0)
            {
                <div>
                    <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                        <span class="material-symbols-outlined align-middle mr-1 text-primary">lock</span>
                        Mật Khẩu *
                    </label>
                    <input type="password" name="password" placeholder="Nhập mật khẩu" required
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition">
                </div>
            }
        </div>

        <!-- Buttons -->
        <div class="flex gap-3 mt-6">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">save</span>
                @(Model?.Id > 0 ? "Cập Nhật" : "Tạo Mới")
            </button>
            <a href="/admin/users" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
                <span class="material-symbols-outlined align-middle mr-2">close</span>
                Hủy
            </a>
        </div>

    </div>
</form>
