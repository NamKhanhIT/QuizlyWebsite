@model TbUser

<div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-2xl font-bold mb-6">@(Model?.Id > 0 ? "Chỉnh sửa người dùng" : "Thêm người dùng mới")</h2>

    <form method="post" class="space-y-4">
        <div>
            <label class="block text-sm font-medium mb-2">Tên đăng nhập</label>
            <input type="text" name="username" value="@Model?.Username" required class="w-full px-4 py-2 border rounded-lg" />
        </div>

        <div>
            <label class="block text-sm font-medium mb-2">Email</label>
            <input type="email" name="email" value="@Model?.Email" required class="w-full px-4 py-2 border rounded-lg" />
        </div>

        <div>
            <label class="block text-sm font-medium mb-2">Họ tên</label>
            <input type="text" name="fullName" value="@Model?.FullName" class="w-full px-4 py-2 border rounded-lg" />
        </div>

        <div>
            <label class="block text-sm font-medium mb-2">Avatar URL</label>
            <input type="text" name="avatarUrl" value="@Model?.AvatarUrl" class="w-full px-4 py-2 border rounded-lg" />
        </div>

        <div class="flex gap-2">
            <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                @(Model?.Id > 0 ? "Cập nhật" : "Tạo mới")
            </button>
            <a href="/Admin/Home/Users" class="px-6 py-2 bg-gray-400 text-white rounded-lg hover:bg-gray-500">Hủy</a>
        </div>
    </form>
</div>
