@model IEnumerable<QuizlyWebsite.Models.TbSubject>

@{
    ViewData["Title"] = "Quản Lý Môn Học";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="flex justify-between items-center mb-8">
    <h2 class="text-3xl font-bold">Danh Sách Môn Học</h2>
    <a asp-action="Create" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition flex items-center gap-2">
        <span class="material-symbols-outlined">add_circle</span>
        Thêm Môn Học
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6 animate-fade-in">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined">check_circle</span>
            <p class="text-sm font-semibold">@TempData["Success"]</p>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6 animate-fade-in">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined">error</span>
            <p class="text-sm font-semibold">@TempData["Error"]</p>
        </div>
    </div>
}

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="px-6 py-4 text-left text-sm font-semibold">ID</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Tên Môn Học</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Danh Mục</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Mô Tả</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@item.Id</td>
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@item.Title</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@item.Category?.Title</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(item.Description ?? "N/A")</td>
                        <td class="px-6 py-4">
                            <div class="flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary hover:text-primary-dark" title="Chỉnh sửa">
                                    <span class="material-symbols-outlined text-sm">edit</span>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-blue-500 hover:text-blue-700" title="Chi tiết">
                                    <span class="material-symbols-outlined text-sm">info</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger hover:text-red-700" title="Xóa">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">school</span>
        <p class="text-[#4c739a] dark:text-slate-400">Chưa có môn học nào. <a asp-action="Create" class="text-primary hover:underline">Tạo môn học mới</a></p>
    </div>
}

