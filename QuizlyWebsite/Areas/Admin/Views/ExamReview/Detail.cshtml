@model TbExam
@{
    ViewData["Title"] = "Review Exam Details";
}

<style>
    .detail-container {
        max-width: 1000px;
        margin: 40px auto;
        padding: 20px;
    }

    .detail-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 40px 30px;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .detail-header h1 {
        margin: 0 0 10px 0;
        font-size: 2rem;
    }

    .detail-header p {
        margin: 5px 0;
        opacity: 0.9;
    }

    .info-section {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 20px;
    }

    .info-section h3 {
        margin-top: 0;
        margin-bottom: 20px;
        color: #333;
        font-size: 1.2rem;
        border-bottom: 2px solid #667eea;
        padding-bottom: 10px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        font-weight: 600;
        color: #667eea;
        font-size: 0.9rem;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .info-value {
        color: #333;
        font-size: 1rem;
    }

    .description-box {
        background: #f9fafb;
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #667eea;
    }

    .questions-list {
        margin-top: 15px;
    }

    .question-item {
        background: #f9fafb;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 12px;
        border-left: 4px solid #667eea;
    }

    .question-title {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .question-options {
        margin-left: 15px;
        font-size: 0.9rem;
    }

    .option-item {
        margin: 5px 0;
        color: #666;
    }

    .correct-answer {
        color: #059669;
        font-weight: 600;
    }

    .action-section {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 25px;
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn {
        padding: 12px 30px;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-approve {
        background: #059669;
        color: white;
    }

    .btn-approve:hover {
        background: #047857;
    }

    .btn-reject {
        background: #dc2626;
        color: white;
    }

    .btn-reject:hover {
        background: #b91c1c;
    }

    .btn-back {
        background: #6b7280;
        color: white;
    }

    .btn-back:hover {
        background: #4b5563;
    }

    .reject-modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
    }

    .reject-modal.active {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-content {
        background: white;
        padding: 30px;
        border-radius: 10px;
        max-width: 500px;
        width: 90%;
    }

    .modal-header {
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 20px;
        color: #333;
    }

    .modal-body {
        margin-bottom: 20px;
    }

    .modal-body label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
    }

    .modal-body textarea {
        width: 100%;
        min-height: 120px;
        padding: 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-family: inherit;
        resize: vertical;
    }

    .modal-footer {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .modal-footer button {
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-cancel {
        background: #e5e7eb;
        color: #333;
    }

    .btn-cancel:hover {
        background: #d1d5db;
    }

    .btn-confirm {
        background: #dc2626;
        color: white;
    }

    .btn-confirm:hover {
        background: #b91c1c;
    }

    @@media (max-width: 768px) {
        .detail-container {
            padding: 10px;
        }

        .detail-header {
            padding: 20px 15px;
        }

        .detail-header h1 {
            font-size: 1.5rem;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .action-section {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="detail-container">
    @if (ViewBag.SuccessMessage != null)
    {
        <div style="background: #d1fae5; border: 1px solid #6ee7b7; color: #065f46; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
            @ViewBag.SuccessMessage
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div style="background: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="detail-header">
        <h1>📋 @Model.Title</h1>
        <p>Created by: <strong>@(Model.CreatedByNavigation?.FullName ?? "Unknown")</strong></p>
        <p>Submitted: <strong>@Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</strong></p>
    </div>

    <!-- Exam Information -->
    <div class="info-section">
        <h3>📝 Exam Information</h3>
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Subject</span>
                <span class="info-value">@(Model.Subject?.Title ?? "N/A")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Duration</span>
                <span class="info-value">@Model.Duration minutes</span>
            </div>
            <div class="info-item">
                <span class="info-label">Total Questions</span>
                <span class="info-value">@(Model.QuestionCount ?? 0)</span>
            </div>
            <div class="info-item">
                <span class="info-label">Difficulty</span>
                <span class="info-value">@(Model.Difficulty ?? "Not Set")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Status</span>
                <span class="info-value">
                    @if (Model.IsApproved == true)
                    {
                        <span style="background: #d1fae5; color: #065f46; padding: 4px 8px; border-radius: 4px;">✓ Approved</span>
                    }
                    else if (!string.IsNullOrEmpty(Model.RejectionReason))
                    {
                        <span style="background: #fee2e2; color: #991b1b; padding: 4px 8px; border-radius: 4px;">✕ Rejected</span>
                    }
                    else
                    {
                        <span style="background: #fef3c7; color: #92400e; padding: 4px 8px; border-radius: 4px;">⏳ Pending</span>
                    }
                </span>
            </div>
        </div>
    </div>

    <!-- Questions Preview -->
    @if (Model.TbQuestions != null && Model.TbQuestions.Count > 0)
    {
        <div class="info-section">
            <h3>❓ Questions (@Model.TbQuestions.Count)</h3>
            <div class="questions-list">
                @foreach (var question in Model.TbQuestions.Take(5))
                {
                    <div class="question-item">
                        <div class="question-title">@question.Content</div>
                        <div class="question-options">
                            @if (!string.IsNullOrEmpty(question.OptionA))
                            {
                                <div class="option-item">
                                    A) @question.OptionA
                                    @if (question.CorrectOption?.ToUpper() == "A")
                                    {
                                        <span class="correct-answer"> ✓ CORRECT</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(question.OptionB))
                            {
                                <div class="option-item">
                                    B) @question.OptionB
                                    @if (question.CorrectOption?.ToUpper() == "B")
                                    {
                                        <span class="correct-answer"> ✓ CORRECT</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(question.OptionC))
                            {
                                <div class="option-item">
                                    C) @question.OptionC
                                    @if (question.CorrectOption?.ToUpper() == "C")
                                    {
                                        <span class="correct-answer"> ✓ CORRECT</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(question.OptionD))
                            {
                                <div class="option-item">
                                    D) @question.OptionD
                                    @if (question.CorrectOption?.ToUpper() == "D")
                                    {
                                        <span class="correct-answer"> ✓ CORRECT</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (Model.TbQuestions.Count > 5)
                {
                    <div style="text-align: center; color: #6b7280; padding: 15px;">
                        ... and @(Model.TbQuestions.Count - 5) more questions
                    </div>
                }
            </div>
        </div>
    }

    <!-- Rejection Reason (if rejected) -->
    @if (!string.IsNullOrEmpty(Model.RejectionReason))
    {
        <div class="info-section" style="background: #fee2e2; border-color: #fca5a5;">
            <h3 style="color: #991b1b;">⚠️ Rejection Reason</h3>
            <div class="description-box" style="background: white; border-color: #fca5a5;">
                @Model.RejectionReason
            </div>
        </div>
    }

    <!-- Action Buttons -->
    <div class="action-section">
        <a href="@Url.Action("Index", "ExamReview", new { area = "Admin" })" class="btn btn-back">
            ← Back to List
        </a>
        
        @if (Model.IsApproved != true)
        {
            <form method="post" action="@Url.Action("Approve", "ExamReview", new { area = "Admin", id = Model.Id })" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-approve" onclick="return confirm('Approve this exam?')">
                    ✓ Approve Exam
                </button>
            </form>

            <button type="button" class="btn btn-reject" onclick="showRejectModal()">
                ✕ Reject Exam
            </button>
        }
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="reject-modal">
    <div class="modal-content">
        <div class="modal-header">Reject This Exam?</div>
        <div class="modal-body">
            <label for="rejectionReason">Reason for Rejection:</label>
            <textarea id="rejectionReason" placeholder="Explain why this exam doesn't meet our standards..."></textarea>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-cancel" onclick="closeRejectModal()">Cancel</button>
            <button type="button" class="btn-confirm" onclick="submitReject()">Reject</button>
        </div>
    </div>
</div>

<script>
    function showRejectModal() {
        document.getElementById('rejectModal').classList.add('active');
        document.getElementById('rejectionReason').value = '';
        document.getElementById('rejectionReason').focus();
    }

    function closeRejectModal() {
        document.getElementById('rejectModal').classList.remove('active');
    }

    function submitReject() {
        const reason = document.getElementById('rejectionReason').value.trim();
        if (!reason) {
            alert('Please provide a rejection reason');
            document.getElementById('rejectionReason').focus();
            return;
        }

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("Reject", "ExamReview", new { area = "Admin", id = Model.Id })';

        const reasonInput = document.createElement('input');
        reasonInput.type = 'hidden';
        reasonInput.name = 'reason';
        reasonInput.value = reason;
        form.appendChild(reasonInput);

        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '__RequestVerificationToken';
        tokenInput.value = document.querySelector('[name="__RequestVerificationToken"]')?.value || '';
        form.appendChild(tokenInput);

        document.body.appendChild(form);
        form.submit();
    }

    window.onclick = function(event) {
        const modal = document.getElementById('rejectModal');
        if (event.target == modal) {
            closeRejectModal();
        }
    }

    // Close modal on Escape key
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeRejectModal();
        }
    });
</script>
