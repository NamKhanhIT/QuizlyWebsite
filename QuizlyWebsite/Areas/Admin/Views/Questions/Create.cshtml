@model QuizlyWebsite.Models.TbQuestion

@{
    ViewData["Title"] = "Thêm Câu Hỏi Mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var examId = Model?.ExamId ?? 0;
}

<style>
    .import-section {
        background: #f8f9fa;
        border-left: 4px solid #667eea;
        padding: 15px;
        border-radius: 6px;
        margin-bottom: 20px;
    }

    .import-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
    }

    .import-tab-btn {
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s;
    }

    .import-tab-content {
        display: none;
    }

    .import-status {
        margin-top: 10px;
        padding: 8px;
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .import-status.success {
        background: #e8f5e9;
        border: 1px solid #4caf50;
        color: #2e7d32;
    }

    .import-status.error {
        background: #ffebee;
        border: 1px solid #f44336;
        color: #c62828;
    }

    .import-status.info {
        background: #e3f2fd;
        border: 1px solid #2196f3;
        color: #1565c0;
    }
</style>

<div class="mb-8">
    <a asp-action="Index" asp-route-examId="@examId" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">Thêm Câu Hỏi Mới</h2>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8 max-w-3xl">
    <form asp-action="Create" asp-area="Admin" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-4"></div>
        
        <input type="hidden" asp-for="ExamId" />
        <div class="mb-6">
            <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Đề Thi
            </label>
            <div class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-gray-100 dark:bg-gray-600 rounded-lg dark:text-slate-50">
                @(ViewBag.ExamTitle as string ?? "Đề thi #" + examId)
            </div>
        </div>

        <div class="mb-6">
            <label asp-for="Content" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Nội Dung Câu Hỏi
            </label>
            <textarea asp-for="Content" rows="4" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"></textarea>
            <span asp-validation-for="Content" class="text-danger text-sm"></span>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-6">
            <div>
                <label asp-for="OptionA" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    Đáp Án A
                </label>
                <input asp-for="OptionA" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
                <span asp-validation-for="OptionA" class="text-danger text-sm"></span>
            </div>
            <div>
                <label asp-for="OptionB" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    Đáp Án B
                </label>
                <input asp-for="OptionB" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
                <span asp-validation-for="OptionB" class="text-danger text-sm"></span>
            </div>
            <div>
                <label asp-for="OptionC" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    Đáp Án C
                </label>
                <input asp-for="OptionC" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
                <span asp-validation-for="OptionC" class="text-danger text-sm"></span>
            </div>
            <div>
                <label asp-for="OptionD" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    Đáp Án D
                </label>
                <input asp-for="OptionD" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
                <span asp-validation-for="OptionD" class="text-danger text-sm"></span>
            </div>
        </div>

        <div class="mb-6">
            <label asp-for="CorrectOption" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Đáp Án Đúng
            </label>
            <select asp-for="CorrectOption" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" required>
                <option value="">-- Chọn đáp án đúng --</option>
                <option value="A">A</option>
                <option value="B">B</option>
                <option value="C">C</option>
                <option value="D">D</option>
            </select>
            <span asp-validation-for="CorrectOption" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-3">
                <p class="text-sm text-blue-800 dark:text-blue-200">
                    <strong>Lưu ý:</strong> Điểm số sẽ tự động được phân bổ đều để tổng điểm của đề thi là 10 điểm. Bạn không cần nhập điểm số.
                </p>
            </div>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                Tạo Mới
            </button>
            <a asp-action="Index" asp-route-examId="@examId" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
                Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

