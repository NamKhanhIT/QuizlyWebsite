@model QuizlyWebsite.Models.TbQuestion

@{
    ViewData["Title"] = "Chỉnh Sửa Câu Hỏi";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="mb-8">
    <a asp-action="Index" asp-route-examId="@Model.ExamId" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">Chỉnh Sửa Câu Hỏi</h2>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8 max-w-3xl">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="mb-6">
            <label asp-for="ExamId" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Đề Thi
            </label>
            <select asp-for="ExamId" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" asp-items="ViewBag.ExamId"></select>
            <span asp-validation-for="ExamId" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Content" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Nội Dung Câu Hỏi
            </label>
            <textarea asp-for="Content" rows="4" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"></textarea>
            <span asp-validation-for="Content" class="text-danger text-sm"></span>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-6">
            <div>
                <label asp-for="OptionA" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    Đáp Án A
                </label>
                <input asp-for="OptionA" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
                <span asp-validation-for="OptionA" class="text-danger text-sm"></span>
            </div>
            <div>
                <label asp-for="OptionB" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    Đáp Án B
                </label>
                <input asp-for="OptionB" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
                <span asp-validation-for="OptionB" class="text-danger text-sm"></span>
            </div>
            <div>
                <label asp-for="OptionC" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    Đáp Án C
                </label>
                <input asp-for="OptionC" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
                <span asp-validation-for="OptionC" class="text-danger text-sm"></span>
            </div>
            <div>
                <label asp-for="OptionD" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                    Đáp Án D
                </label>
                <input asp-for="OptionD" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
                <span asp-validation-for="OptionD" class="text-danger text-sm"></span>
            </div>
        </div>

        <div class="mb-6">
            <label asp-for="CorrectOption" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Đáp Án Đúng
            </label>
            <select asp-for="CorrectOption" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition">
                <option value="">-- Chọn đáp án đúng --</option>
                <option value="A">A</option>
                <option value="B">B</option>
                <option value="C">C</option>
                <option value="D">D</option>
            </select>
            <span asp-validation-for="CorrectOption" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Marks" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Điểm
            </label>
            <input asp-for="Marks" type="number" step="0.01" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
            <span asp-validation-for="Marks" class="text-danger text-sm"></span>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                Cập Nhật
            </button>
            <a asp-action="Index" asp-route-examId="@Model.ExamId" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
                Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

