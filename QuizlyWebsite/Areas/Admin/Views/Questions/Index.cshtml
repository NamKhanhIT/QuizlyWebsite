@model IEnumerable<QuizlyWebsite.Models.TbQuestion>

@{
    ViewData["Title"] = "Quản Lý Câu Hỏi";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var examId = ViewData["ExamId"] as int?;
    var exam = ViewData["Exam"] as QuizlyWebsite.Models.TbExam;
}

<div class="flex justify-between items-center mb-8">
    <div>
        <h2 class="text-3xl font-bold">Quản Lý Câu Hỏi</h2>
        @if (exam != null)
        {
            <p class="text-[#4c739a] dark:text-slate-400 mt-2">Đề thi: @exam.Title</p>
        }
    </div>
    <a asp-action="Create" asp-route-examId="@examId" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition flex items-center gap-2">
        <span class="material-symbols-outlined">add_circle</span>
        Thêm Câu Hỏi
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="px-6 py-4 text-left text-sm font-semibold">ID</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Nội Dung</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Đáp Án Đúng</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Điểm</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderBy(q => q.Id))
                {
                    <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@item.Id</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(item.Content?.Length > 50 ? item.Content.Substring(0, 50) + "..." : item.Content)</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(item.CorrectOption ?? "N/A")</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(item.Marks?.ToString("F2") ?? "0")</td>
                        <td class="px-6 py-4">
                            <div class="flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-blue-500 hover:text-blue-700" title="Chi tiết">
                                    <span class="material-symbols-outlined text-sm">info</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary hover:text-primary-dark" title="Chỉnh sửa">
                                    <span class="material-symbols-outlined text-sm">edit</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger hover:text-red-700" title="Xóa">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">help</span>
        <p class="text-[#4c739a] dark:text-slate-400">Chưa có câu hỏi nào. <a asp-action="Create" asp-route-examId="@examId" class="text-primary hover:underline">Tạo câu hỏi mới</a></p>
    </div>
}

