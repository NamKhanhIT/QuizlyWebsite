@model IEnumerable<QuizlyWebsite.Models.TbQuestion>

@{
    ViewData["Title"] = "Quản Lý Câu Hỏi";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var examId = ViewData["ExamId"] as int?;
    var exam = ViewData["Exam"] as QuizlyWebsite.Models.TbExam;
}

<div class="flex justify-between items-center mb-8">
    <div>
        <h2 class="text-3xl font-bold">Quản Lý Câu Hỏi</h2>
        @if (exam != null)
        {
            <p class="text-[#4c739a] dark:text-slate-400 mt-2">Đề thi: @exam.Title</p>
        }
    </div>
    <div class="flex gap-3">
        <button type="button" onclick="showImportModal()" class="px-6 py-3 bg-green-500 text-white rounded-lg font-semibold hover:bg-green-600 transition flex items-center gap-2">
            <span class="material-symbols-outlined">upload_file</span>
            Import Câu Hỏi
        </button>
        <a asp-action="Create" asp-route-examId="@examId" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition flex items-center gap-2">
            <span class="material-symbols-outlined">add_circle</span>
            Thêm Câu Hỏi
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
        <p class="font-semibold">@TempData["Success"]</p>
    </div>
}

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="px-6 py-4 text-left text-sm font-semibold">ID</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Nội Dung</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Đáp Án Đúng</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Điểm</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderBy(q => q.Id))
                {
                    <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                        <td class="px-6 py-4 font-semibold text-[#0d141b] dark:text-slate-50">@item.Id</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(item.Content?.Length > 50 ? item.Content.Substring(0, 50) + "..." : item.Content)</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(item.CorrectOption ?? "N/A")</td>
                        <td class="px-6 py-4 text-[#4c739a] dark:text-slate-400">@(item.Marks?.ToString("F2") ?? "0")</td>
                        <td class="px-6 py-4">
                            <div class="flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-blue-500 hover:text-blue-700" title="Chi tiết">
                                    <span class="material-symbols-outlined text-sm">info</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary hover:text-primary-dark" title="Chỉnh sửa">
                                    <span class="material-symbols-outlined text-sm">edit</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger hover:text-red-700" title="Xóa">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-gray-300 dark:text-gray-700 mb-4 block">help</span>
        <p class="text-[#4c739a] dark:text-slate-400">Chưa có câu hỏi nào. 
            <button type="button" onclick="showImportModal()" class="text-green-500 hover:underline">Import câu hỏi</button> 
            hoặc 
            <a asp-action="Create" asp-route-examId="@examId" class="text-primary hover:underline">Tạo câu hỏi mới</a>
        </p>
    </div>
}

<!-- Import Modal -->
<div id="importModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center" style="display: none;">
    <div class="bg-white dark:bg-gray-800 rounded-xl p-8 max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-2xl font-bold">Import Câu Hỏi</h3>
            <button type="button" onclick="closeImportModal()" class="text-gray-500 hover:text-gray-700">
                <span class="material-symbols-outlined text-2xl">close</span>
            </button>
        </div>

        <div class="mb-4">
            <div class="flex gap-3 mb-4">
                <button type="button" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition" onclick="showImportTab('word')" id="btnWordTab">
                    Tải file Word
                </button>
                <button type="button" class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition" onclick="showImportTab('text')" id="btnTextTab">
                    Dán văn bản
                </button>
            </div>

            <!-- Word Import -->
            <div id="wordImportTab" style="display: none;">
                <input type="file" id="wordFileInput" accept=".docx" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg text-sm mb-2">
                <button type="button" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition w-full" onclick="importFromWord()">
                    Import từ file Word
                </button>
            </div>

            <!-- Text Import -->
            <div id="textImportTab" style="display: none;">
                <textarea id="textImportInput" rows="10" placeholder="Dán nội dung câu hỏi theo định dạng:

Câu hỏi: React là gì?

A. Một ngôn ngữ lập trình
*B. Một thư viện JavaScript
C. Một framework backend
D. Một cơ sở dữ liệu

Câu hỏi: JavaScript là gì?

A. Một framework
*B. Một ngôn ngữ lập trình
C. Một thư viện CSS
D. Một database" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg text-sm font-mono mb-2"></textarea>
                <button type="button" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition w-full" onclick="importFromText()">
                    Import từ văn bản
                </button>
            </div>

            <!-- Import Status -->
            <div id="importStatus" style="display: none; margin-top: 15px; padding: 10px; border-radius: 6px;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const examId = @(examId ?? 0);

        function showImportModal() {
            document.getElementById('importModal').style.display = 'flex';
            showImportTab('text');
        }

        function closeImportModal() {
            document.getElementById('importModal').style.display = 'none';
            document.getElementById('importStatus').style.display = 'none';
            document.getElementById('textImportInput').value = '';
            document.getElementById('wordFileInput').value = '';
        }

        function showImportTab(tab) {
            const wordTab = document.getElementById('wordImportTab');
            const textTab = document.getElementById('textImportTab');
            const btnWord = document.getElementById('btnWordTab');
            const btnText = document.getElementById('btnTextTab');

            btnWord.className = 'px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition';
            btnText.className = 'px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition';

            wordTab.style.display = 'none';
            textTab.style.display = 'none';

            if (tab === 'word') {
                wordTab.style.display = 'block';
                btnWord.className = 'px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition';
            } else {
                textTab.style.display = 'block';
                btnText.className = 'px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition';
            }
        }

        async function importFromWord() {
            const fileInput = document.getElementById('wordFileInput');
            const file = fileInput.files[0];
            const statusDiv = document.getElementById('importStatus');

            if (!file) {
                statusDiv.innerHTML = '<div class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded text-sm">⚠️ Vui lòng chọn file Word (.docx)</div>';
                statusDiv.style.display = 'block';
                return;
            }

            const extension = file.name.toLowerCase().split('.').pop();
            if (extension !== 'docx') {
                statusDiv.innerHTML = '<div class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded text-sm">⚠️ Chỉ chấp nhận file Word (.docx)</div>';
                statusDiv.style.display = 'block';
                return;
            }

            statusDiv.innerHTML = '<div class="bg-blue-100 border border-blue-400 text-blue-700 px-3 py-2 rounded text-sm">⏳ Đang xử lý file...</div>';
            statusDiv.style.display = 'block';

            try {
                const formData = new FormData();
                formData.append('file', file);

                const response = await fetch('/quiz/parse-word', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    let errorMessage = `HTTP ${response.status}: `;
                    try {
                        const errorData = await response.json();
                        errorMessage += errorData.error || errorData.message || 'Lỗi không xác định';
                    } catch (e) {
                        const errorText = await response.text();
                        errorMessage += errorText || 'Lỗi không xác định';
                    }
                    throw new Error(errorMessage);
                }

                const result = await response.json();
                
                // Check if result has the expected structure
                if (!result || (!result.report && !result.validQuestions)) {
                    // Try to handle different response formats
                    if (result.error) {
                        throw new Error(result.error);
                    }
                    throw new Error('Định dạng response không hợp lệ');
                }

                await handleImportResult(result);
            } catch (error) {
                statusDiv.innerHTML = `<div class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded text-sm">❌ Lỗi: ${error.message}</div>`;
                console.error('Import Word error:', error);
            }
        }

        async function importFromText() {
            const textInput = document.getElementById('textImportInput');
            const text = textInput.value.trim();
            const statusDiv = document.getElementById('importStatus');

            if (!text) {
                statusDiv.innerHTML = '<div class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded text-sm">⚠️ Vui lòng nhập hoặc dán nội dung câu hỏi</div>';
                statusDiv.style.display = 'block';
                return;
            }

            statusDiv.innerHTML = '<div class="bg-blue-100 border border-blue-400 text-blue-700 px-3 py-2 rounded text-sm">⏳ Đang xử lý văn bản...</div>';
            statusDiv.style.display = 'block';

            try {
                const response = await fetch('/quiz/parse-text', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ text: text })
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(`HTTP ${response.status}: ${errorText}`);
                }

                const result = await response.json();
                await handleImportResult(result);
            } catch (error) {
                statusDiv.innerHTML = `<div class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded text-sm">❌ Lỗi: ${error.message}</div>`;
            }
        }

        async function handleImportResult(result) {
            const statusDiv = document.getElementById('importStatus');

            // Validate result structure
            if (!result || !result.report) {
                statusDiv.innerHTML = '<div class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded text-sm">❌ Dữ liệu response không hợp lệ</div>';
                return;
            }

            let statusHtml = `<div class="bg-blue-100 border border-blue-400 text-blue-700 px-3 py-2 rounded text-sm">
                <strong>📊 Kết quả import:</strong><br>
                - Tổng số câu hỏi: ${result.report.totalQuestions || 0}<br>
                - Câu hỏi hợp lệ: ${result.report.validCount || 0}<br>
                - Câu hỏi lỗi: ${result.report.errorCount || 0}
            </div>`;

            if (result.report.errorCount > 0 && result.report.errors && result.report.errors.length > 0) {
                statusHtml += `<div class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded text-sm mt-2">
                    <strong>⚠️ Lỗi:</strong><br>
                    ${result.report.errors.map(e => `Câu ${e.questionNumber || 'N/A'}: ${e.errorReason || e.error || 'Lỗi không xác định'}`).join('<br>')}
                </div>`;
            }

            if (result.validQuestions && result.validQuestions.length > 0) {
                statusHtml += `<div class="bg-blue-100 border border-blue-400 text-blue-700 px-3 py-2 rounded text-sm mt-2">
                    ⏳ Đang thêm ${result.validQuestions.length} câu hỏi vào đề thi...
                </div>`;
                statusDiv.innerHTML = statusHtml;

                // Auto-create questions in database
                try {
                    const createResponse = await fetch('/Admin/Questions/ImportQuestions', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            examId: examId,
                            questions: result.validQuestions
                        })
                    });

                    if (!createResponse.ok) {
                        const errorText = await createResponse.text();
                        throw new Error(`HTTP ${createResponse.status}: ${errorText}`);
                    }

                    const createResult = await createResponse.json();
                    
                    if (createResult.success) {
                        statusHtml = `<div class="bg-green-100 border border-green-400 text-green-700 px-3 py-2 rounded text-sm">
                            ✅ Đã thêm thành công ${createResult.addedCount} câu hỏi vào đề thi!<br>
                            <button onclick="location.reload()" class="mt-2 px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition">
                                Tải lại trang
                            </button>
                        </div>`;
                        statusDiv.innerHTML = statusHtml;

                        // Auto reload after 2 seconds
                        setTimeout(() => {
                            location.reload();
                        }, 2000);
                    } else {
                        throw new Error(createResult.message || 'Không thể thêm câu hỏi');
                    }
                } catch (error) {
                    statusHtml += `<div class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded text-sm mt-2">
                        ❌ Lỗi khi thêm câu hỏi: ${error.message}
                    </div>`;
                    statusDiv.innerHTML = statusHtml;
                }
            } else {
                statusDiv.innerHTML = statusHtml;
            }
        }

        // Close modal when clicking outside
        document.getElementById('importModal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeImportModal();
            }
        });
    </script>
}
