@model QuizlyWebsite.Models.TbMenu

@{
    ViewData["Title"] = "Chỉnh Sửa Menu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="mb-8">
    <a asp-action="Index" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">Chỉnh Sửa Menu</h2>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8 max-w-2xl">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        
        <div class="mb-6">
            <label asp-for="Title" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Tiêu Đề</label>
            <input asp-for="Title" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
            <span asp-validation-for="Title" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Url" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">URL</label>
            <input asp-for="Url" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
            <span asp-validation-for="Url" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="ParentId" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Menu Cha</label>
            <select asp-for="ParentId" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" asp-items="ViewBag.ParentId">
                <option value="">-- Không có menu cha --</option>
            </select>
            <span asp-validation-for="ParentId" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Order" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Thứ Tự</label>
            <input asp-for="Order" type="number" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
            <span asp-validation-for="Order" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Location" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">Vị Trí</label>
            <input asp-for="Location" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" />
            <span asp-validation-for="Location" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label class="flex items-center gap-2">
                <input type="checkbox" name="IsActive" value="true" @(Model.IsActive == true ? "checked" : "") class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary" />
                <span class="text-sm font-semibold text-[#0d141b] dark:text-slate-50">Hoạt động</span>
            </label>
            <input type="hidden" name="IsActive" value="false" />
        </div>

        <div class="flex gap-3">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                Cập Nhật
            </button>
            <a asp-action="Index" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
                Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

