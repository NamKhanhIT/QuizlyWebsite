@model List<QuizlyWebsite.Models.TbLesson>
@{
    ViewData["Title"] = "Approve Lessons";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>Pending Lessons Review</h2>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-check-circle fa-3x mb-3"></i>
            <h4>No Pending Lessons</h4>
            <p>All lessons have been reviewed!</p>
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Course</th>
                    <th>Creator</th>
                    <th>Submitted</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lesson in Model)
                {
                    <tr>
                        <td>
                            <strong>@lesson.Title</strong>
                        </td>
                        <td>@lesson.Course?.Title</td>
                        <td>
                            @if (lesson.Course?.CreatedByNavigation != null)
                            {
                                <small>@lesson.Course.CreatedByNavigation.FullName</small>
                            }
                        </td>
                        <td>@lesson.CreatedAt?.ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#contentModal@lesson.Id">
                                    <i class="fas fa-eye"></i> View
                                </button>
                                <form method="post" action="@Url.Action("ApproveLesson")" style="display:inline;">
                                    <input type="hidden" name="id" value="@lesson.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="fas fa-check"></i>
                                    </button>
                                </form>
                                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal@lesson.Id">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <!-- View Content Modal -->
                    <div class="modal fade" id="contentModal@lesson.Id" tabindex="-1">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">@lesson.Title</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    @Html.Raw(lesson.Content)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Reject Modal -->
                    <div class="modal fade" id="rejectModal@lesson.Id" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Reject Lesson</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form method="post" action="@Url.Action("RejectLesson")">
                                    <input type="hidden" name="id" value="@lesson.Id" />
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label for="reason" class="form-label">Rejection Reason *</label>
                                            <textarea class="form-control" name="reason" rows="4" required></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Reject</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    }
</div>


