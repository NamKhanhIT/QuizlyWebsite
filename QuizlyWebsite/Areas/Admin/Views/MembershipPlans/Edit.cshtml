@model QuizlyWebsite.Models.TbMembershipPlan

@{
    ViewData["Title"] = "Chỉnh Sửa Gói Thành Viên";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="mb-8">
    <a asp-action="Index" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">Chỉnh Sửa Gói Thành Viên</h2>
</div>

<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6 animate-fade-in">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined">check_circle</span>
            <p class="text-sm font-semibold">@TempData["Success"]</p>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6 animate-fade-in">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined">error</span>
            <p class="text-sm font-semibold">@TempData["Error"]</p>
        </div>
    </div>
}

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8 max-w-2xl">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-4 bg-danger/10 border border-danger/30 rounded-lg p-4"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="mb-6">
            <label asp-for="Title" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Tiêu Đề <span class="text-danger">*</span>
            </label>
            <input asp-for="Title" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" required />
            <span asp-validation-for="Title" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Price" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Giá (VND) <span class="text-danger">*</span>
            </label>
            <input asp-for="Price" type="number" step="0.01" min="0.01" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" required />
            <span asp-validation-for="Price" class="text-danger text-sm"></span>
        </div>

        <div class="mb-6">
            <label asp-for="DurationDays" class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                Thời Hạn (Ngày) <span class="text-danger">*</span>
            </label>
            <input asp-for="DurationDays" type="number" min="1" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition" required />
            <span asp-validation-for="DurationDays" class="text-danger text-sm"></span>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition font-semibold">
                Cập Nhật
            </button>
            <a asp-action="Index" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
                Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

