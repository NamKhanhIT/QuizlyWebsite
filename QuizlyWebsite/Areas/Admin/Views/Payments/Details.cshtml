@model QuizlyWebsite.Models.TbPayment

@{
    ViewData["Title"] = "Chi Tiết Thanh Toán";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="mb-8">
    <a asp-action="Index" class="text-primary hover:underline flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay Lại
    </a>
    <h2 class="text-3xl font-bold">Chi Tiết Thanh Toán</h2>
</div>

<!-- Payment Status Header -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8 mb-8">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
            <div class="w-16 h-16 bg-gradient-to-br from-green-400 to-green-600 rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-white text-2xl">
                    @(Model.Status == "Completed" || Model.Status == "Success" ? "check_circle" : "schedule")
                </span>
            </div>
            <div>
                <h3 class="text-2xl font-bold text-[#0d141b] dark:text-slate-50">
                    @((Model.Amount?.ToString("N0") ?? "0") + " " + (Model.Currency ?? "VND"))
                </h3>
                <p class="text-gray-600 dark:text-gray-400">
                    Giao dịch #@Model.Id
                </p>
            </div>
        </div>
        <div class="text-right">
            <span class="text-lg font-semibold px-4 py-2 rounded-full @(Model.Status == "Completed" || Model.Status == "Success" ? "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200" : Model.Status == "Pending" ? "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200" : "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200")">
                @(Model.Status == "Completed" || Model.Status == "Success" ? "Thành công" : Model.Status == "Pending" ? "Đang xử lý" : "Thất bại")
            </span>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                @(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
            </p>
        </div>
    </div>
</div>

<!-- Chi tiết giao dịch -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
        <h4 class="text-lg font-semibold mb-4 text-[#0d141b] dark:text-slate-50 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">person</span>
            Thông Tin Người Dùng
        </h4>
        <dl class="space-y-3">
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Email</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50">@Model.User?.Email</dd>
            </div>
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Họ Tên</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50">@(Model.User?.FullName ?? "N/A")</dd>
            </div>
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">ID Người Dùng</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50 font-mono">@Model.UserId</dd>
            </div>
        </dl>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
        <h4 class="text-lg font-semibold mb-4 text-[#0d141b] dark:text-slate-50 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">library_books</span>
            Thông Tin Đề Thi
        </h4>
        <dl class="space-y-3">
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Tên Đề Thi</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50">@(Model.Exam?.Title ?? "N/A")</dd>
            </div>
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Môn Học</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50">@(Model.Exam?.Subject?.Title ?? "N/A")</dd>
            </div>
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">ID Đề Thi</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50 font-mono">@(Model.ExamId ?? 0)</dd>
            </div>
        </dl>
    </div>
</div>

<!-- Chi tiết thanh toán -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <h4 class="text-lg font-semibold mb-4 text-[#0d141b] dark:text-slate-50 flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">receipt</span>
        Chi Tiết Thanh Toán
    </h4>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <dl class="space-y-3">
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Số Tiền</dt>
                <dd class="text-lg font-semibold text-[#0d141b] dark:text-slate-50">
                    @((Model.Amount?.ToString("N0") ?? "0") + " " + (Model.Currency ?? "VND"))
                </dd>
            </div>
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Nhà Cung Cấp</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50">@(Model.Provider ?? "N/A")</dd>
            </div>
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Mã Giao Dịch</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50 font-mono">@(Model.ProviderTransId ?? "N/A")</dd>
            </div>
        </dl>
        <dl class="space-y-3">
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Trạng Thái</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50">
                    <span class="text-xs font-semibold px-3 py-1 rounded-full @(Model.Status == "Completed" || Model.Status == "Success" ? "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200" : Model.Status == "Pending" ? "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200" : "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200")">
                        @(Model.Status ?? "N/A")
                    </span>
                </dd>
            </div>
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">Ngày Tạo</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50">@(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd>
            </div>
            <div class="flex justify-between items-center">
                <dt class="text-sm font-medium text-gray-600 dark:text-gray-400">ID Giao Dịch</dt>
                <dd class="text-sm text-[#0d141b] dark:text-slate-50 font-mono">@Model.Id</dd>
            </div>
        </dl>
    </div>
</div>

<!-- Action buttons -->
<div class="flex gap-3 mt-8 justify-center">
    <a asp-action="Index" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold">
        <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
        Quay Lại
    </a>
</div>

