@model List<QuizlyWebsite.Models.TbMembershipPlan>

@{
    ViewData["Title"] = "Gói Hội Viên";
}

<div class="px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40 py-10">
    <div class="text-center mb-12">
        <h1 class="text-4xl font-black text-[#0d141b] dark:text-slate-50 mb-4">Gói Hội Viên Premium</h1>
        <p class="text-[#4c739a] dark:text-slate-400">Nâng cấp để truy cập toàn bộ bộ đề và tính năng độc quyền</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        @foreach (var plan in Model)
        {
            <div class="bg-white dark:bg-gray-800 rounded-xl border-2 border-gray-200 dark:border-gray-700 p-8 text-center hover:border-primary transition card-hover">
                <h3 class="text-2xl font-bold text-[#0d141b] dark:text-slate-50 mb-2">@plan.Title</h3>
                <p class="text-[#4c739a] dark:text-slate-400 text-sm mb-6">@plan.DurationDays ngày truy cập</p>
                
                <div class="mb-6">
                    <p class="text-4xl font-black text-primary">@plan.Price?.ToString("C") ?? "0 VND"</p>
                    <p class="text-xs text-[#4c739a] dark:text-slate-400 mt-1">/gói</p>
                </div>

                <button class="w-full bg-primary text-white font-bold py-3 rounded-lg hover:bg-primary-dark transition mb-6">
                    Nâng Cấp Ngay
                </button>

                <div class="text-left space-y-3 text-sm">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-success text-sm">check_circle</span>
                        <span>Truy cập toàn bộ bộ đề</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-success text-sm">check_circle</span>
                        <span>Không quảng cáo</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-success text-sm">check_circle</span>
                        <span>Thống kê chi tiết</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-success text-sm">check_circle</span>
                        <span>Tạo bộ đề riêng</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
