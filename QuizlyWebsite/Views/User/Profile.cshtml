    function removeQuestionModal(index) {
        const question = document.querySelector(`[data-question-index-modal="${index}"]`);
        if (question) {
            question.remove();
            updateQuestionNumbersModal();
        }
    }

    function updateQuestionNumbersModal() {
        const questions = document.querySelectorAll('[data-question-index-modal]');
        questions.forEach((q, index) => {
            const number = index + 1;
            q.querySelector('.font-semibold').textContent = `Câu hỏi ${number}`;
            
            const inputs = q.querySelectorAll('input, textarea');
            inputs.forEach(input => {
                if (input.name) {
                    input.name = input.name.replace(/Questions\[\d+\]/, `Questions[${index}]`);
                }
            });
        });
        questionCountModal = questions.length;
    }

    function handleCreateExam(event) {
        const questions = document.querySelectorAll('[data-question-index-modal]');
        if (questions.length === 0) {
            event.preventDefault();
            alert('Vui lòng thêm ít nhất 1 câu hỏi!');
            return false;
        }

        let allValid = true;
        questions.forEach((q) => {
            const correctOption = q.querySelector('input[type="radio"]:checked');
            if (!correctOption) {
                allValid = false;
            }
        });

        if (!allValid) {
            event.preventDefault();
            alert('Vui lòng chọn đáp án đúng cho tất cả các câu hỏi!');
            return false;
        }

        return true;
    }

    // Add first question when modal opens
    function showCreateExamModal() {
        document.getElementById('createExamModal').classList.remove('hidden');
        // Reset and add first question
        questionCountModal = 0;
        document.getElementById('questionsContainerModal').innerHTML = '';
        addQuestionModal();
        
        // Add form submit listener
        const form = document.getElementById('examFormModal');
        if (form) {
            form.onsubmit = handleCreateExam;
        }
    }

    // Import functions for user
    function showImportModalUser() {
        document.getElementById('importModalUser').classList.remove('hidden');
        showImportTabUser('text');
    }

    function hideImportModalUser() {
        document.getElementById('importModalUser').classList.add('hidden');
        document.getElementById('importStatusUser').style.display = 'none';
        document.getElementById('textImportInputUser').value = '';
        document.getElementById('wordFileInputUser').value = '';
    }

    function showImportTabUser(tab) {
        const wordTab = document.getElementById('wordImportTabUser');
        const textTab = document.getElementById('textImportTabUser');
        const btnWord = document.getElementById('btnWordTabUser');
        const btnText = document.getElementById('btnTextTabUser');
        
        if (tab === 'word') {
            wordTab.style.display = 'block';
            textTab.style.display = 'none';
            btnWord.classList.add('border-primary', 'text-primary');
            btnWord.classList.remove('border-transparent', 'text-gray-500');
            btnText.classList.add('border-transparent', 'text-gray-500');
            btnText.classList.remove('border-primary', 'text-primary');
        } else {
            wordTab.style.display = 'none';
            textTab.style.display = 'block';
            btnText.classList.add('border-primary', 'text-primary');
            btnText.classList.remove('border-transparent', 'text-gray-500');
            btnWord.classList.add('border-transparent', 'text-gray-500');
            btnWord.classList.remove('border-primary', 'text-primary');
        }
    }

    async function importFromTextUser() {
        const textInput = document.getElementById('textImportInputUser');
        const text = textInput.value.trim();
        const statusDiv = document.getElementById('importStatusUser');
        
        if (!text) {
            statusDiv.innerHTML = '<div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4">⚠️ Vui lòng nhập hoặc dán nội dung đề thi</div>';
            statusDiv.style.display = 'block';
            return;
        }
        
        statusDiv.innerHTML = '<div class="bg-info/10 border border-info/30 text-info rounded-lg p-4">⏳ Đang xử lý văn bản...</div>';
        statusDiv.style.display = 'block';
        
        try {
            const response = await fetch('/quiz/parse-questions-text', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ text: text })
            });
            
            const result = await response.json();
            handleImportResultUser(result);
        } catch (error) {
            statusDiv.innerHTML = `<div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4">❌ Lỗi: ${error.message}</div>`;
        }
    }

    async function importFromWordUser() {
        const fileInput = document.getElementById('wordFileInputUser');
        const file = fileInput.files[0];
        const statusDiv = document.getElementById('importStatusUser');
        
        if (!file) {
            statusDiv.innerHTML = '<div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4">⚠️ Vui lòng chọn file Word (.docx)</div>';
            statusDiv.style.display = 'block';
            return;
        }
        
        statusDiv.innerHTML = '<div class="bg-info/10 border border-info/30 text-info rounded-lg p-4">⏳ Đang xử lý file...</div>';
        statusDiv.style.display = 'block';
        
        try {
            const formData = new FormData();
            formData.append('file', file);
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            formData.append('__RequestVerificationToken', token);
            
            const response = await fetch('/quiz/parse-questions-word', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            handleImportResultUser(result);
        } catch (error) {
            statusDiv.innerHTML = `<div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4">❌ Lỗi: ${error.message}</div>`;
        }
    }

    function handleImportResultUser(result) {
        const statusDiv = document.getElementById('importStatusUser');
        
        if (result.success && result.questions && result.questions.length > 0) {
            // Add imported questions to form
            result.questions.forEach((q, index) => {
                addQuestionFromImport(q);
            });
            
            statusDiv.innerHTML = `<div class="bg-success/10 border border-success/30 text-success rounded-lg p-4">
                <strong>✅ Đã import thành công ${result.questions.length} câu hỏi!</strong><br>
                <small>Các câu hỏi đã được thêm vào form. Bạn có thể chỉnh sửa trước khi gửi.</small>
            </div>`;
            
            // Close modal after 2 seconds
            setTimeout(() => {
                hideImportModalUser();
            }, 2000);
        } else {
            statusDiv.innerHTML = `<div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4">
                ❌ ${result.message || 'Không thể import câu hỏi'}<br>
                ${result.errors ? result.errors.map(e => `- ${e}`).join('<br>') : ''}
            </div>`;
        }
    }

    function addQuestionFromImport(q) {
        questionCountModal++;
        const container = document.getElementById('questionsContainerModal');
        
        const questionHtml = `
            <div class="bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg p-4" data-question-index-modal="${questionCountModal}">
                <div class="flex justify-between items-center mb-3">
                    <span class="font-semibold text-primary">Câu hỏi ${questionCountModal} (Đã import)</span>
                    <button type="button" onclick="removeQuestionModal(${questionCountModal})" class="px-3 py-1 bg-red-500 text-white rounded text-sm hover:bg-red-600">
                        Xóa
                    </button>
                </div>
                
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nội dung câu hỏi *</label>
                        <textarea name="Questions[${questionCountModal - 1}].Content" required placeholder="Nhập nội dung câu hỏi..." class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" rows="2">${escapeHtml(q.question || '')}</textarea>
                    </div>
                    
                    <div class="space-y-2">
                        <div class="flex items-center gap-2">
                            <input type="radio" name="Questions[${questionCountModal - 1}].CorrectOption" value="A" ${(q.correctOption || '').toUpperCase() === 'A' ? 'checked' : ''} required>
                            <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án A *</label>
                        </div>
                        <input type="text" name="Questions[${questionCountModal - 1}].OptionA" required placeholder="Nhập đáp án A" value="${escapeHtml(q.optionA || '')}" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                    </div>
                    
                    <div class="space-y-2">
                        <div class="flex items-center gap-2">
                            <input type="radio" name="Questions[${questionCountModal - 1}].CorrectOption" value="B" ${(q.correctOption || '').toUpperCase() === 'B' ? 'checked' : ''} required>
                            <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án B *</label>
                        </div>
                        <input type="text" name="Questions[${questionCountModal - 1}].OptionB" required placeholder="Nhập đáp án B" value="${escapeHtml(q.optionB || '')}" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                    </div>
                    
                    <div class="space-y-2">
                        <div class="flex items-center gap-2">
                            <input type="radio" name="Questions[${questionCountModal - 1}].CorrectOption" value="C" ${(q.correctOption || '').toUpperCase() === 'C' ? 'checked' : ''} required>
                            <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án C *</label>
                        </div>
                        <input type="text" name="Questions[${questionCountModal - 1}].OptionC" required placeholder="Nhập đáp án C" value="${escapeHtml(q.optionC || '')}" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                    </div>
                    
                    <div class="space-y-2">
                        <div class="flex items-center gap-2">
                            <input type="radio" name="Questions[${questionCountModal - 1}].CorrectOption" value="D" ${(q.correctOption || '').toUpperCase() === 'D' ? 'checked' : ''} required>
                            <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án D *</label>
                        </div>
                        <input type="text" name="Questions[${questionCountModal - 1}].OptionD" required placeholder="Nhập đáp án D" value="${escapeHtml(q.optionD || '')}" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Điểm số</label>
                        <input type="number" name="Questions[${questionCountModal - 1}].Marks" min="0" step="0.5" value="1" placeholder="1.0" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                    </div>
                </div>
            </div>
        `;
        
        container.insertAdjacentHTML('beforeend', questionHtml);
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Close import modal when clicking outside
    document.getElementById('importModalUser')?.addEventListener('click', function(e) {
        if (e.target === this) {
            hideImportModalUser();
        }
    });

    function toggleMobileSidebar() {
        const sidebar = document.getElementById('mobileSidebar');
        sidebar.classList.toggle('hidden');
    }

    // Close mobile sidebar when clicking outside
    document.addEventListener('click', function(event) {
        const sidebar = document.getElementById('mobileSidebar');
        const menuButton = event.target.closest('button[onclick="toggleMobileSidebar()"]');
        
        if (window.innerWidth < 1024 && !sidebar.contains(event.target) && !menuButton) {
            sidebar.classList.add('hidden');
        }
    });

    // Load theme on page load
    if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.add('dark');
    }

    // Close modal when clicking outside
    document.getElementById('createExamModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeCreateExamModal();
        }
    });

    document.getElementById('avatarCropModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeAvatarCropModal();
        }
    });
</script>

<!-- Cancel Subscription Modal -->
<div id="cancelSubscriptionModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl max-w-md w-full max-h-[90vh] overflow-y-auto">
        <div class="p-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">Hủy gói hội viên</h3>
                <button type="button" onclick="closeCancelSubscriptionModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            
            <div class="mb-4 p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
                <p class="text-sm text-yellow-800 dark:text-yellow-200">
                    <strong>⚠️ Lưu ý:</strong> Khi hủy gói, bạn sẽ mất toàn bộ quyền lợi. Số tiền hoàn lại sẽ được tính theo số ngày còn lại và chuyển vào tài khoản ngân hàng bạn cung cấp.
                </p>
            </div>

            @if (hasActiveSubscription && activeSubscription != null)
            {
                var totalDays = (activeSubscription.EndDate - activeSubscription.StartDate).TotalDays;
                var remainingDays = (activeSubscription.EndDate - DateTime.UtcNow).TotalDays;
                var currentPlan = activeSubscription.Plan as QuizlyWebsite.Models.TbMembershipPlan;
                var originalPrice = currentPlan?.Price ?? 0;
                var refundAmount = remainingDays > 0 && totalDays > 0 ? originalPrice * (decimal)(remainingDays / totalDays) : 0;
                refundAmount = Math.Round(refundAmount, 2);
                
                <div class="mb-4 p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
                    <p class="text-sm text-blue-800 dark:text-blue-200 mb-2">
                        <strong>Thông tin hoàn tiền:</strong>
                    </p>
                    <p class="text-sm text-blue-700 dark:text-blue-300">
                        Số ngày còn lại: <strong>@remainingDays.ToString("F0") ngày</strong><br>
                        Số tiền hoàn lại: <strong>@refundAmount.ToString("N0") VND</strong>
                    </p>
                </div>
            }

            <form method="post" action="@Url.Action("CancelSubscription", "Subscription")" id="cancelSubscriptionForm">
                @Html.AntiForgeryToken()
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Tên chủ tài khoản <span class="text-red-500">*</span>
                        </label>
                        <input type="text" name="AccountHolderName" required 
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent"
                               placeholder="Nhập tên chủ tài khoản">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Số tài khoản ngân hàng <span class="text-red-500">*</span>
                        </label>
                        <input type="text" name="AccountNumber" required 
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent"
                               placeholder="Nhập số tài khoản">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Tên ngân hàng <span class="text-red-500">*</span>
                        </label>
                        <input type="text" name="BankName" required 
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent"
                               placeholder="Ví dụ: Vietcombank, Techcombank, BIDV...">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Chi nhánh ngân hàng
                        </label>
                        <input type="text" name="BankBranch" 
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent"
                               placeholder="Nhập chi nhánh (tùy chọn)">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Số điện thoại liên hệ <span class="text-red-500">*</span>
                        </label>
                        <input type="tel" name="PhoneNumber" required 
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent"
                               placeholder="Nhập số điện thoại">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Ghi chú
                        </label>
                        <textarea name="Notes" rows="3" 
                                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent"
                                  placeholder="Ghi chú thêm (nếu có)"></textarea>
                    </div>
                </div>

                <div class="flex gap-3 mt-6">
                    <button type="button" onclick="closeCancelSubscriptionModal()" 
                            class="flex-1 px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg font-semibold hover:bg-gray-300 dark:hover:bg-gray-600 transition">
                        Hủy
                    </button>
                    <button type="submit" 
                            class="flex-1 px-4 py-2 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition">
                        Xác nhận hủy gói
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.css">
    <style>
        #cancelSubscriptionModal {
            animation: fadeIn 0.3s ease;
        }
        
        @@keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.js"></script>
    <script>
        function showCancelSubscriptionModal() {
            document.getElementById('cancelSubscriptionModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeCancelSubscriptionModal() {
            document.getElementById('cancelSubscriptionModal').classList.add('hidden');
            document.body.style.overflow = '';
            // Reset form
            document.getElementById('cancelSubscriptionForm').reset();
        }

        // Close modal when clicking outside
        document.getElementById('cancelSubscriptionModal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeCancelSubscriptionModal();
            }
        });

        // Close modal with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeCancelSubscriptionModal();
            }
        });
    </script>
}
