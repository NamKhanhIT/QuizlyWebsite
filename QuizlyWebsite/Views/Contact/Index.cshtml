@{
    ViewData["Title"] = "Liên Hệ";
}

<main class="bg-neutral-bg font-sans text-neutral-text antialiased min-h-screen">
    <!-- Hero Section -->
    <div class="bg-primary-gradient relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 relative z-10 text-center">
            <h1 class="text-3xl md:text-5xl font-heading font-bold text-white mb-4">Liên hệ với chúng tôi</h1>
            <p class="text-blue-100 text-lg md:text-xl max-w-2xl mx-auto">Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn. Hãy gửi câu hỏi hoặc phản hồi của bạn cho Quizly ngay hôm nay.</p>
        </div>
        <div class="absolute bottom-0 left-0 w-full h-16 bg-neutral-bg rounded-t-[50%] scale-x-150 translate-y-8"></div>
    </div>
    
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 -mt-8 relative z-20">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Contact Info Cards -->
            <div class="lg:col-span-1 space-y-6">
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-800 hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center text-primary mb-4">
                        <span class="material-symbols-outlined text-3xl">mail</span>
                    </div>
                    <h3 class="font-heading font-semibold text-lg text-gray-900 dark:text-white mb-2">Email hỗ trợ</h3>
                    <p class="text-neutral-light dark:text-slate-400 text-sm mb-4">Gửi email cho chúng tôi bất cứ lúc nào, chúng tôi sẽ phản hồi trong vòng 24h.</p>
                    <a class="text-primary font-medium hover:underline" href="mailto:support@quizly.vn">support@quizly.vn</a>
                </div>
                
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-800 hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-xl bg-green-50 dark:bg-green-900/20 flex items-center justify-center text-success mb-4">
                        <span class="material-symbols-outlined text-3xl">call</span>
                    </div>
                    <h3 class="font-heading font-semibold text-lg text-gray-900 dark:text-white mb-2">Hotline</h3>
                    <p class="text-neutral-light dark:text-slate-400 text-sm mb-4">Tổng đài hỗ trợ trực tuyến từ 8:00 - 17:30 (Thứ 2 - Thứ 6).</p>
                    <a class="text-primary font-medium hover:underline" href="tel:19001234">1900 1234</a>
                </div>
                
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-800 hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-xl bg-yellow-50 dark:bg-yellow-900/20 flex items-center justify-center text-accent mb-4">
                        <span class="material-symbols-outlined text-3xl">location_on</span>
                    </div>
                    <h3 class="font-heading font-semibold text-lg text-gray-900 dark:text-white mb-2">Văn phòng</h3>
                    <p class="text-neutral-light dark:text-slate-400 text-sm mb-4">Ghé thăm văn phòng của chúng tôi để được tư vấn trực tiếp.</p>
                    <p class="text-gray-900 dark:text-white font-medium text-sm">182 Lê Duẩn, phường Trường Vinh, tỉnh Nghệ An.</p>
                </div>
            </div>
            
            <!-- Contact Form -->
            <div class="lg:col-span-2">
                <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-800 p-8">
                    <h2 class="font-heading font-bold text-2xl text-gray-900 dark:text-white mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary material-symbols-filled" style="font-variation-settings: 'FILL' 1;">send</span>
                        Gửi tin nhắn cho chúng tôi
                    </h2>
                    
                    @if (TempData["Success"] != null)
                    {
                        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4 mb-6">
                            <p class="text-green-800 dark:text-green-200">@TempData["Success"]</p>
                        </div>
                    }
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <p class="text-red-800 dark:text-red-200">@error.ErrorMessage</p>
                            }
                        </div>
                    }
                    
                    <form method="post" action="@Url.Action("Index", "Contact")" class="space-y-6">
                        @Html.AntiForgeryToken()
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-gray-300" for="name">Họ và tên</label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[20px]">person</span>
                                    <input class="w-full pl-10 pr-4 py-3 rounded-xl border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:border-primary focus:ring-primary transition-colors text-sm text-gray-900 dark:text-white" id="name" name="name" placeholder="Nhập họ tên của bạn" type="text" required/>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-gray-300" for="email">Email</label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[20px]">alternate_email</span>
                                    <input class="w-full pl-10 pr-4 py-3 rounded-xl border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:border-primary focus:ring-primary transition-colors text-sm text-gray-900 dark:text-white" id="email" name="email" placeholder="Nhập email của bạn" type="email" required/>
                                </div>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-gray-300" for="phone">Số điện thoại</label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[20px]">smartphone</span>
                                    <input class="w-full pl-10 pr-4 py-3 rounded-xl border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:border-primary focus:ring-primary transition-colors text-sm text-gray-900 dark:text-white" id="phone" name="phone" placeholder="Số điện thoại liên hệ" type="tel"/>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label class="text-sm font-medium text-gray-700 dark:text-gray-300" for="subject">Chủ đề</label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[20px]">topic</span>
                                    <select class="w-full pl-10 pr-10 py-3 rounded-xl border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:border-primary focus:ring-primary transition-colors text-sm appearance-none cursor-pointer text-gray-900 dark:text-white" id="subject" name="subject" required>
                                        <option disabled selected value="">Chọn chủ đề cần hỗ trợ</option>
                                        <option value="course">Tư vấn khóa học</option>
                                        <option value="exam">Vấn đề về đề thi</option>
                                        <option value="technical">Lỗi kỹ thuật</option>
                                        <option value="partnership">Hợp tác doanh nghiệp</option>
                                        <option value="other">Khác</option>
                                    </select>
                                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none text-[20px]">expand_more</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-gray-300" for="message">Nội dung tin nhắn</label>
                            <textarea class="w-full p-4 rounded-xl border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-slate-800 focus:bg-white dark:focus:bg-slate-900 focus:border-primary focus:ring-primary transition-colors text-sm text-gray-900 dark:text-white resize-none" id="message" name="message" placeholder="Hãy mô tả chi tiết vấn đề bạn cần hỗ trợ..." rows="5" required></textarea>
                        </div>
                        
                        <div class="flex items-center justify-between pt-2">
                            <div class="flex items-start gap-2 max-w-[60%]">
                                <input class="mt-1 rounded border-gray-300 dark:border-gray-700 text-primary focus:ring-primary" id="privacy" name="privacy" type="checkbox" required/>
                                <label class="text-xs text-neutral-light dark:text-slate-400" for="privacy">Tôi đồng ý với <a class="text-primary hover:underline" href="#">Chính sách bảo mật</a> và cho phép Quizly liên hệ lại.</label>
                            </div>
                            <button class="bg-primary-gradient text-white px-8 py-3 rounded-xl font-semibold shadow-lg shadow-blue-500/30 hover:shadow-xl hover:shadow-blue-500/40 transition-all transform hover:-translate-y-1 flex items-center gap-2" type="submit">
                                <span>Gửi tin nhắn</span>
                                <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <!-- FAQ Section -->
        <div class="mt-16 text-center">
            <h2 class="font-heading font-bold text-2xl text-gray-900 dark:text-white mb-8">Câu hỏi thường gặp</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <a class="group p-6 bg-white dark:bg-slate-900 rounded-xl border border-gray-100 dark:border-gray-800 hover:border-primary/30 hover:shadow-md transition-all" href="#">
                    <h4 class="font-bold text-gray-900 dark:text-white group-hover:text-primary mb-2 transition-colors">Làm sao để đăng ký khóa học?</h4>
                    <p class="text-sm text-neutral-light dark:text-slate-400">Hướng dẫn chi tiết quy trình đăng ký và thanh toán.</p>
                </a>
                <a class="group p-6 bg-white dark:bg-slate-900 rounded-xl border border-gray-100 dark:border-gray-800 hover:border-primary/30 hover:shadow-md transition-all" href="#">
                    <h4 class="font-bold text-gray-900 dark:text-white group-hover:text-primary mb-2 transition-colors">Tôi quên mật khẩu?</h4>
                    <p class="text-sm text-neutral-light dark:text-slate-400">Cách lấy lại mật khẩu tài khoản nhanh chóng.</p>
                </a>
                <a class="group p-6 bg-white dark:bg-slate-900 rounded-xl border border-gray-100 dark:border-gray-800 hover:border-primary/30 hover:shadow-md transition-all" href="#">
                    <h4 class="font-bold text-gray-900 dark:text-white group-hover:text-primary mb-2 transition-colors">Chính sách hoàn tiền</h4>
                    <p class="text-sm text-neutral-light dark:text-slate-400">Tìm hiểu về điều kiện và quy trình hoàn học phí.</p>
                </a>
            </div>
        </div>
    </main>
</main>

<style>
    .material-symbols-filled {
        font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .bg-primary-gradient {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    }
    .font-heading {
        font-family: "Poppins", "Inter", sans-serif;
    }
</style>
