@model List<TestimonialViewModel>
@{
    ViewData["Title"] = "Trắc Nghiệm Thông Minh";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trắc Nghiệm Thông Minh</title>
    <link rel="stylesheet" href="~/css/homepage.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>
    <div id="canvas-container"></div>

    <div class="content">
        <!-- Hero Section -->
        <section class="hero">
            <div class="floating-cards">
                <div class="floating-card">
                    <div style="font-size: 2rem;">🧠</div>
                    <div style="margin-top: 0.5rem; font-size: 0.9rem;">Câu hỏi thú vị</div>
                </div>
                <div class="floating-card">
                    <div style="font-size: 2rem;">🏆</div>
                    <div style="margin-top: 0.5rem; font-size: 0.9rem;">Thử thách</div>
                </div>
                <div class="floating-card">
                    <div style="font-size: 2rem;">⭐</div>
                    <div style="margin-top: 0.5rem; font-size: 0.9rem;">Huy hiệu</div>
                </div>
            </div>

            <div class="hero-content">
                <h1>Trắc Nghiệm Thông Minh, Học Tập Hiệu Quả</h1>
                <p>Tham gia vào thế giới của những câu hỏi vui nhộn và thách thức. Chơi, học, và cạnh tranh!</p>

                <div class="cta-buttons">
                    <a href="/quiz/list" class="btn btn-primary">🚀 Khám Phá Bộ Đề</a>
                    <a href="#features" class="btn btn-secondary">✨ Tìm Hiểu Thêm</a>
                </div>

                <div class="categories">
                    <div class="category-card">
                        <div class="category-icon">🔬</div>
                        <h3>Khoa Học</h3>
                    </div>
                    <div class="category-card">
                        <div class="category-icon">📚</div>
                        <h3>Lịch Sử</h3>
                    </div>
                    <div class="category-card">
                        <div class="category-icon">🌍</div>
                        <h3>Địa Lý</h3>
                    </div>
                    <div class="category-card">
                        <div class="category-icon">💬</div>
                        <h3>Ngôn Ngữ</h3>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="features" id="features">
            <h2 class="section-title">✨ Khám Phá Những Tính Năng Tuyệt Vời</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">🌐</div>
                    <h3>Chủ Đề Rộng Rãi</h3>
                    <p>Khám phá các bộ đề từ khoa học, lịch sử đến văn hóa đại chúng và hơn thế nữa.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">⚡</div>
                    <h3>Phản Hồi Tức Thời</h3>
                    <p>Nhận kết quả của bạn ngay lập tức sau khi hoàn thành bộ đề và học hỏi từ sai lầm.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">👥</div>
                    <h3>Cạnh Tranh Với Bạn Bè</h3>
                    <p>Thách đấu bạn bè của bạn để thắng điểm và xem ai có điểm cao nhất trên bảng xếp hạng.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🏅</div>
                    <h3>Thành Tựu & Huy Hiệu</h3>
                    <p>Kiếm được huy hiệu và thành tựu khi bạn tiến bộ và hoàn thành thách thức.</p>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="stats">
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-number">5000+</div>
                    <div class="stat-label">Bộ Đề Thi</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">50K+</div>
                    <div class="stat-label">Người Dùng Hoạt Động</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">1M+</div>
                    <div class="stat-label">Câu Hỏi</div>
                </div>
            </div>
        </section>

        <!-- How It Works Section -->
        <section class="how-it-works">
            <h2 class="section-title">🚀 Cách Thức Hoạt Động</h2>
            <div class="steps-container">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <div class="step-icon">📝</div>
                    <h3>Đăng Ký Tài Khoản</h3>
                    <p>Tạo tài khoản miễn phí chỉ trong vài giây. Không cần thẻ tín dụng!</p>
                </div>
                <div class="step-arrow">→</div>
                <div class="step-card">
                    <div class="step-number">2</div>
                    <div class="step-icon">🎯</div>
                    <h3>Chọn Chủ Đề</h3>
                    <p>Khám phá hàng nghìn bộ đề từ nhiều lĩnh vực khác nhau phù hợp với bạn.</p>
                </div>
                <div class="step-arrow">→</div>
                <div class="step-card">
                    <div class="step-number">3</div>
                    <div class="step-icon">⚡</div>
                    <h3>Làm Bài & Học Tập</h3>
                    <p>Trả lời câu hỏi, nhận điểm, và cải thiện kiến thức của bạn mỗi ngày.</p>
                </div>
                <div class="step-arrow">→</div>
                <div class="step-card">
                    <div class="step-number">4</div>
                    <div class="step-icon">🏆</div>
                    <h3>Nhận Thành Tựu</h3>
                    <p>Kiếm huy hiệu, leo bảng xếp hạng và trở thành cao thủ!</p>
                </div>
            </div>
        </section>

        <!-- About Us Section -->
        <section class="about-section">
            <div class="about-container">
                <div class="about-content">
                    <h2>💡 Về Chúng Tôi</h2>
                    <p class="about-intro">Chúng tôi tin rằng học tập nên là một trải nghiệm thú vị và dễ tiếp cận cho mọi người.</p>
                    <p>Nền tảng trắc nghiệm của chúng tôi được xây dựng với sứ mệnh giúp học sinh, sinh viên và người đi làm có thể học tập mọi lúc, mọi nơi một cách hiệu quả nhất.</p>
                    <div class="about-features">
                        <div class="about-feature-item">
                            <span class="feature-check">✓</span>
                            <span>Hơn 1 triệu câu hỏi chất lượng cao</span>
                        </div>
                        <div class="about-feature-item">
                            <span class="feature-check">✓</span>
                            <span>Được tin dùng bởi 50,000+ người học</span>
                        </div>
                        <div class="about-feature-item">
                            <span class="feature-check">✓</span>
                            <span>Cập nhật nội dung liên tục hàng tuần</span>
                        </div>
                        <div class="about-feature-item">
                            <span class="feature-check">✓</span>
                            <span>Hỗ trợ đa nền tảng: Web, Mobile, Tablet</span>
                        </div>
                    </div>
                </div>
                <div class="about-visual">
                    <div class="visual-card">
                        <div class="visual-stat">
                            <div class="visual-number">5+</div>
                            <div class="visual-label">Năm Kinh Nghiệm</div>
                        </div>
                    </div>
                    <div class="visual-card">
                        <div class="visual-stat">
                            <div class="visual-number">98%</div>
                            <div class="visual-label">Hài Lòng</div>
                        </div>
                    </div>
                    <div class="visual-card">
                        <div class="visual-stat">
                            <div class="visual-number">24/7</div>
                            <div class="visual-label">Hỗ Trợ</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Testimonials Section -->
        <section class="testimonials">
            <h2 class="section-title">💬 Người Dùng Nói Gì Về Chúng Tôi</h2>
            <div class="testimonials-grid">
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var testimonial in Model)
                    {
                        <div class="testimonial-card">
                            <div class="testimonial-rating">
                                @for (int i = 0; i < testimonial.Rating; i++)
                                {
                                    <span>⭐</span>
                                }
                            </div>
                            <p class="testimonial-text">"@testimonial.Comment"</p>
                            <div class="testimonial-author">
                                <div class="author-avatar">
                                    @if (!string.IsNullOrEmpty(testimonial.AvatarUrl))
                                    {
                                        <img src="@testimonial.AvatarUrl" alt="@testimonial.FullName" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <span style="font-size: 2rem;">👤</span>
                                    }
                                </div>
                                <div class="author-info">
                                    <div class="author-name">@testimonial.FullName</div>
                                    <div class="author-title">@testimonial.UserRole</div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Fallback testimonials nếu không có dữ liệu -->
                    <div class="testimonial-card">
                        <div class="testimonial-rating">⭐⭐⭐⭐⭐</div>
                        <p class="testimonial-text">"Đây là nền tảng học tập tốt nhất mà tôi từng sử dụng. Giao diện đẹp, câu hỏi chất lượng và rất dễ sử dụng!"</p>
                        <div class="testimonial-author">
                            <div class="author-avatar">👨‍🎓</div>
                            <div class="author-info">
                                <div class="author-name">Nguyễn Văn A</div>
                                <div class="author-title">Sinh viên Đại học</div>
                            </div>
                        </div>
                    </div>
                    <div class="testimonial-card">
                        <div class="testimonial-rating">⭐⭐⭐⭐⭐</div>
                        <p class="testimonial-text">"Tôi đã cải thiện điểm thi của mình rất nhiều nhờ luyện tập thường xuyên trên website này. Cảm ơn đội ngũ!"</p>
                        <div class="testimonial-author">
                            <div class="author-avatar">👩‍💼</div>
                            <div class="author-info">
                                <div class="author-name">Trần Thị B</div>
                                <div class="author-title">Giáo viên THPT</div>
                            </div>
                        </div>
                    </div>
                    <div class="testimonial-card">
                        <div class="testimonial-rating">⭐⭐⭐⭐⭐</div>
                        <p class="testimonial-text">"Chức năng thi đấu với bạn bè rất thú vị! Con tôi rất thích học và không còn thấy nhàm chán nữa."</p>
                        <div class="testimonial-author">
                            <div class="author-avatar">👨‍👩‍👧</div>
                            <div class="author-info">
                                <div class="author-name">Phạm Văn C</div>
                                <div class="author-title">Phụ huynh</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="faq-section">
            <h2 class="section-title">❓ Câu Hỏi Thường Gặp</h2>
            <div class="faq-container">
                <div class="faq-item">
                    <div class="faq-question">
                        <span>Tôi có phải trả phí để sử dụng không?</span>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        Không! Nền tảng của chúng tôi hoàn toàn miễn phí. Bạn có thể truy cập hàng nghìn bộ đề mà không cần trả bất kỳ khoản phí nào. Nhưng nếu muốn trải nghiệm thêm các tính năng cao cấp, bạn có thể nâng cấp lên gói có sẵn của Website nhé!.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span>Tôi có thể sử dụng trên điện thoại không?</span>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        Có! Website của chúng tôi được tối ưu hóa cho tất cả các thiết bị bao gồm điện thoại, máy tính bảng và máy tính để bàn.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span>Làm thế nào để theo dõi tiến độ học tập?</span>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        Sau khi đăng nhập, bạn có thể xem chi tiết lịch sử làm bài, điểm số, thành tích và biểu đồ tiến độ trong trang cá nhân của mình.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span>Tôi có thể tạo bộ đề của riêng mình không?</span>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        Có! Người dùng có thể tạo bộ đề riêng và chia sẻ với bạn bè hoặc cộng đồng. Tính năng này có sẵn trong tài khoản của bạn.
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-section">
            <h2>🎯 Sẵn Sàng Khám Phá Thiên Tài Của Bạn?</h2>
            <p>Tham gia hàng ngàn người dùng và bắt đầu hành trình trắc nghiệm của bạn ngay hôm nay. Hoàn toàn miễn phí để bắt đầu!</p>
            <a href="/register" class="btn btn-primary">🎓 Bắt Đầu Miễn Phí</a>
        </section>
    </div>

    <script src="~/js/homepage.js"></script>
</body>
</html>
