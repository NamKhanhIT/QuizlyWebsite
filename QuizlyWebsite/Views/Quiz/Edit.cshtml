@model TbExam
@{
    ViewData["Title"] = "Edit Exam";
}

<style>
    .edit-container {
        max-width: 800px;
        margin: 40px auto;
        padding: 20px;
    }

    .edit-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 40px 30px;
        border-radius: 12px;
        margin-bottom: 30px;
        text-align: center;
    }

    .edit-header h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
    }

    .edit-header p {
        margin: 10px 0 0 0;
        opacity: 0.9;
        font-size: 1rem;
    }

    .form-section {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 30px;
        margin-bottom: 20px;
    }

    .form-section h3 {
        margin-top: 0;
        margin-bottom: 20px;
        color: #333;
        font-size: 1.3rem;
        border-bottom: 2px solid #667eea;
        padding-bottom: 10px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
        font-size: 0.95rem;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 1rem;
        font-family: inherit;
        transition: border-color 0.3s, box-shadow 0.3s;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .form-group textarea {
        resize: vertical;
        min-height: 100px;
    }

    .help-text {
        display: block;
        margin-top: 6px;
        font-size: 0.85rem;
        color: #6b7280;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .info-box {
        background: #f0f4ff;
        border-left: 4px solid #667eea;
        padding: 15px;
        border-radius: 6px;
        margin-bottom: 20px;
        color: #333;
    }

    .info-box strong {
        color: #667eea;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }

    .btn {
        padding: 12px 30px;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-save {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(102, 126, 234, 0.4);
    }

    .btn-cancel {
        background: #e5e7eb;
        color: #333;
    }

    .btn-cancel:hover {
        background: #d1d5db;
    }

    .error-message {
        background: #fee;
        border: 1px solid #fcc;
        color: #c33;
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 20px;
    }

    .validation-error {
        color: #dc2626;
        font-size: 0.85rem;
        margin-top: 4px;
    }

    @@media (max-width: 768px) {
        .edit-container {
            margin: 20px auto;
            padding: 10px;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="edit-container">
    <div class="edit-header">
        <h1>✏️ Edit Exam</h1>
        <p>Update your exam details and configuration</p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="error-message">
            @ViewBag.ErrorMessage
        </div>
    }

    <form method="post" action="@Url.Action("Edit", "Quiz", new { id = Model.Id })" class="edit-form">
        @Html.AntiForgeryToken()

        <!-- Basic Information Section -->
        <div class="form-section">
            <h3>📋 Basic Information</h3>

            <div class="form-group">
                <label for="Title">Exam Title *</label>
                <input type="text" id="Title" name="Title" value="@Model.Title" required placeholder="Enter exam title">
                <span class="help-text">Give your exam a clear, descriptive title</span>
            </div>

            <div class="form-group">
                <label for="SubjectId">Subject *</label>
                <select id="SubjectId" name="SubjectId" required>
                    <option value="">-- Select a Subject --</option>
                    @foreach (var subject in (List<TbSubject>)ViewData["Subjects"])
                    {
                        <option value="@subject.Id" selected="@(Model.SubjectId == subject.Id)">@subject.Title</option>
                    }
                </select>
                <span class="help-text">Select the academic subject for this exam</span>
            </div>
        </div>

        <!-- Exam Configuration Section -->
        <div class="form-section">
            <h3>⚙️ Exam Configuration</h3>

            <div class="form-row">
                <div class="form-group">
                    <label for="Duration">Duration (minutes) *</label>
                    <input type="number" id="Duration" name="Duration" value="@Model.Duration" min="5" max="300" required placeholder="60">
                    <span class="help-text">Time limit in minutes (5-300)</span>
                </div>
            </div>

            <div class="info-box">
                <strong>ℹ️ Info:</strong> Your exam will remain <strong>pending approval</strong> until an administrator reviews it. 
                Any changes will be saved but may require re-approval.
            </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
            <a href="@Url.Action("MyExams", "Quiz")" class="btn btn-cancel">
                ✕ Cancel
            </a>
            <button type="submit" class="btn btn-save">
                ✓ Save Changes
            </button>
        </div>
    </form>
</div>
