@model TbExam
@{
    ViewData["Title"] = "Sửa đề thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var subjects = ViewData["Subjects"] as List<TbSubject>;
    var categories = ViewData["Categories"] as List<TbCategory> ?? new List<TbCategory>();
    var existingQuestions = ViewData["Questions"] as List<TbQuestion> ?? new List<TbQuestion>();
    var currentSubject = Model.Subject;
    var currentCategory = currentSubject?.Category;
}


<div class="create-exam-container">
    <!-- Hero Section -->
    <div class="exam-hero">
        <h1>✏️ Sửa đề thi</h1>
        <p>Cập nhật thông tin và câu hỏi cho đề thi của bạn</p>
    </div>

        <!-- Information Alert -->
        <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 mb-6">
            <p class="text-sm text-blue-800 dark:text-blue-200">
                <span class="font-semibold">ℹ️ Lưu ý quan trọng:</span>
                Sau khi cập nhật, đề thi sẽ cần được quản trị viên duyệt lại nếu đã được duyệt trước đó.
            </p>
        </div>

        <!-- Form -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 sm:p-8">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6">
                    <p class="text-sm font-semibold text-red-800 dark:text-red-200 mb-2">⚠️ Lỗi xác thực:</p>
                    <ul class="list-disc list-inside text-sm text-red-700 dark:text-red-300">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

        <form method="post" action="@Url.Action("Edit", "Quiz", new { id = Model.Id })" id="examForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />
            
            <!-- Basic Information -->
            <div class="mb-8">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">📋 Thông tin cơ bản</h3>

                <div class="mb-6">
                    <label for="Title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Tên đề thi *</label>
                    <input type="text" id="Title" name="Title" value="@Model.Title" placeholder="Ví dụ: Đề thi C# nâng cao" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent" />
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Đặt tên rõ ràng, mô tả cho đề thi của bạn</p>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Danh mục *</label>
                    <div class="flex items-center gap-2 mb-2">
                        <input type="checkbox" id="useNewCategory" onchange="toggleCategoryInput()" class="w-4 h-4">
                        <input type="hidden" id="useNewCategoryValue" name="UseNewCategory" value="false">
                        <label for="useNewCategory" class="text-sm text-gray-600 dark:text-gray-400">Tạo danh mục mới</label>
                    </div>
                    <div id="categorySelectWrapper">
                        <select id="CategoryId" name="CategoryId" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent">
                            <option value="">-- Chọn danh mục --</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id" selected="@(currentCategory != null && category.Id == currentCategory.Id)">@category.Title</option>
                            }
                        </select>
                    </div>
                    <div class="hidden mt-2" id="newCategoryInput">
                        <input type="text" id="NewCategoryTitle" name="NewCategoryTitle" placeholder="Nhập tên danh mục mới" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" />
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Chọn danh mục có sẵn hoặc tạo danh mục mới</p>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Môn học *</label>
                    <div class="flex items-center gap-2 mb-2">
                        <input type="checkbox" id="useNewSubject" onchange="toggleSubjectInput()" class="w-4 h-4">
                        <input type="hidden" id="useNewSubjectValue" name="UseNewSubject" value="false">
                        <label for="useNewSubject" class="text-sm text-gray-600 dark:text-gray-400">Tạo môn học mới</label>
                    </div>
                    <div id="subjectSelectWrapper">
                        <select id="SubjectId" name="SubjectId" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent">
                            <option value="">-- Chọn môn học --</option>
                            @foreach (var subject in subjects)
                            {
                                <option value="@subject.Id" selected="@(Model.SubjectId == subject.Id)">@subject.Title</option>
                            }
                        </select>
                    </div>
                    <div class="hidden mt-2 space-y-2" id="newSubjectInput">
                        <input type="text" id="NewSubjectTitle" name="NewSubjectTitle" placeholder="Nhập tên môn học mới" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" />
                        <textarea id="NewSubjectDescription" name="NewSubjectDescription" rows="2" placeholder="Mô tả môn học (tùy chọn)" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white"></textarea>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Chọn môn học có sẵn hoặc tạo môn học mới</p>
                </div>
            </div>

            <!-- Configuration -->
            <div class="mb-8">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">⚙️ Cấu hình đề thi</h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="Duration" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Thời gian (phút) *</label>
                        <input type="number" id="Duration" name="Duration" value="@Model.Duration" min="5" max="300" placeholder="Ví dụ: 60" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent" />
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Thời gian làm bài (tối thiểu 5 phút, tối đa 300 phút)</p>
                    </div>

                    <div>
                        <label for="Difficulty" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Độ khó *</label>
                        <select id="Difficulty" name="Difficulty" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent">
                            <option value="Dễ" selected="@(Model.Difficulty == "Dễ")">Dễ</option>
                            <option value="Trung bình" selected="@(Model.Difficulty == "Trung bình" || string.IsNullOrEmpty(Model.Difficulty))">Trung bình</option>
                            <option value="Khó" selected="@(Model.Difficulty == "Khó")">Khó</option>
                        </select>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Chọn mức độ khó của đề thi</p>
                    </div>
                </div>
            </div>

            <!-- Questions Section -->
            <div class="mb-8">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">❓ Câu hỏi</h3>
                
                <div id="questionsContainer" class="space-y-4">
                    <!-- Existing questions -->
                    @for (int i = 0; i < existingQuestions.Count; i++)
                    {
                        var q = existingQuestions[i];
                        <div class="bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg p-4" data-question-id="@q.Id" data-question-index="@i">
                            <div class="flex justify-between items-center mb-3">
                                <span class="font-semibold text-primary">
                                    Câu hỏi @(i + 1)
                                    <span class="px-2 py-1 text-xs bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400 rounded-full ml-2">Đã lưu</span>
                                </span>
                                <button type="button" class="px-3 py-1 bg-red-500 text-white rounded text-sm hover:bg-red-600" onclick="removeQuestion(@i, @q.Id)">
                                    🗑️ Xóa
                                </button>
                            </div>
                            
                            <input type="hidden" name="Questions[@i].Id" value="@q.Id" />
                            
                            <div class="mb-3">
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nội dung câu hỏi *</label>
                                <textarea name="Questions[@i].Content" required placeholder="Nhập nội dung câu hỏi..." class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" rows="2">@q.Content</textarea>
                            </div>
                            
                            <div class="space-y-2 mb-3">
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án A *</label>
                                <div class="flex items-center gap-2">
                                    <input type="radio" name="Questions[@i].CorrectOption" value="A" required @(q.CorrectOption == "A" ? "checked" : "") class="w-4 h-4">
                                    <input type="text" name="Questions[@i].OptionA" value="@q.OptionA" required placeholder="Nhập đáp án A" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                                </div>
                            </div>
                            
                            <div class="space-y-2 mb-3">
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án B *</label>
                                <div class="flex items-center gap-2">
                                    <input type="radio" name="Questions[@i].CorrectOption" value="B" required @(q.CorrectOption == "B" ? "checked" : "") class="w-4 h-4">
                                    <input type="text" name="Questions[@i].OptionB" value="@q.OptionB" required placeholder="Nhập đáp án B" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                                </div>
                            </div>
                            
                            <div class="space-y-2 mb-3">
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án C *</label>
                                <div class="flex items-center gap-2">
                                    <input type="radio" name="Questions[@i].CorrectOption" value="C" required @(q.CorrectOption == "C" ? "checked" : "") class="w-4 h-4">
                                    <input type="text" name="Questions[@i].OptionC" value="@q.OptionC" required placeholder="Nhập đáp án C" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                                </div>
                            </div>
                            
                            <div class="space-y-2 mb-3">
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án D *</label>
                                <div class="flex items-center gap-2">
                                    <input type="radio" name="Questions[@i].CorrectOption" value="D" required @(q.CorrectOption == "D" ? "checked" : "") class="w-4 h-4">
                                    <input type="text" name="Questions[@i].OptionD" value="@q.OptionD" required placeholder="Nhập đáp án D" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                                </div>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Điểm số</label>
                                <input type="number" name="Questions[@i].Marks" min="0" step="0.5" value="@(q.Marks ?? 1)" placeholder="1.0" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Điểm số cho câu hỏi này (mặc định: 1 điểm)</p>
                            </div>
                        </div>
                    }
                </div>

                <button type="button" class="mt-4 px-4 py-2 bg-green-500 text-white rounded-lg font-medium hover:bg-green-600 transition" onclick="addQuestion()">
                    + Thêm câu hỏi
                </button>

                <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
                    Thêm ít nhất 1 câu hỏi cho đề thi. Mỗi câu hỏi cần có 4 đáp án và đáp án đúng.
                </p>
            </div>

            <!-- Info Box -->
            <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 mb-6">
                <p class="text-sm text-blue-800 dark:text-blue-200">
                    <span class="font-semibold">📌 Lưu ý:</span>
                    Sau khi cập nhật, đề thi sẽ ở trạng thái "Chờ duyệt" nếu đã được duyệt trước đó. Các thay đổi sẽ được lưu.
                </p>
            </div>

            <!-- Form Actions -->
            <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                <button type="submit" class="flex-1 px-6 py-2 bg-primary text-white rounded-lg font-medium hover:bg-primary-dark transition">
                    ✓ Lưu thay đổi
                </button>
                <a href="@Url.Action("Index", "Profile", new { tab = "my-exams" })" class="px-6 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg font-medium hover:bg-gray-300 dark:hover:bg-gray-600 transition">
                    Hủy
                </a>
            </div>
        </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let questionCount = @existingQuestions.Count;

        function toggleCategoryInput() {
            const checkbox = document.getElementById('useNewCategory');
            const hiddenInput = document.getElementById('useNewCategoryValue');
            const selectWrapper = document.getElementById('categorySelectWrapper');
            const select = document.getElementById('CategoryId');
            const input = document.getElementById('newCategoryInput');
            const newCategoryTitle = document.getElementById('NewCategoryTitle');
            
            if (checkbox.checked) {
                selectWrapper.classList.add('hidden');
                select.removeAttribute('required');
                select.value = '';
                input.classList.remove('hidden');
                newCategoryTitle.setAttribute('required', 'required');
                hiddenInput.value = 'true';
            } else {
                selectWrapper.classList.remove('hidden');
                select.setAttribute('required', 'required');
                input.classList.add('hidden');
                newCategoryTitle.removeAttribute('required');
                newCategoryTitle.value = '';
                hiddenInput.value = 'false';
            }
        }

        function toggleSubjectInput() {
            const checkbox = document.getElementById('useNewSubject');
            const hiddenInput = document.getElementById('useNewSubjectValue');
            const selectWrapper = document.getElementById('subjectSelectWrapper');
            const select = document.getElementById('SubjectId');
            const input = document.getElementById('newSubjectInput');
            const newSubjectTitle = document.getElementById('NewSubjectTitle');
            const newSubjectDescription = document.getElementById('NewSubjectDescription');
            
            if (checkbox.checked) {
                selectWrapper.classList.add('hidden');
                select.removeAttribute('required');
                select.value = '';
                input.classList.remove('hidden');
                newSubjectTitle.setAttribute('required', 'required');
                newSubjectDescription.removeAttribute('required');
                hiddenInput.value = 'true';
            } else {
                selectWrapper.classList.remove('hidden');
                select.setAttribute('required', 'required');
                input.classList.add('hidden');
                newSubjectTitle.removeAttribute('required');
                newSubjectTitle.value = '';
                newSubjectDescription.value = '';
                newSubjectDescription.removeAttribute('required');
                hiddenInput.value = 'false';
            }
        }

        function addQuestion() {
            const container = document.getElementById('questionsContainer');
            const index = questionCount; // Use 0-based index
            questionCount++;
            
            const questionHtml = `
                <div class="bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg p-4" data-question-id="0" data-question-index="${index}">
                    <div class="flex justify-between items-center mb-3">
                        <span class="font-semibold text-primary">
                            Câu hỏi ${questionCount}
                            <span class="px-2 py-1 text-xs bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-400 rounded-full ml-2">Mới</span>
                        </span>
                        <button type="button" class="px-3 py-1 bg-red-500 text-white rounded text-sm hover:bg-red-600" onclick="removeQuestion(${index}, 0)">
                            🗑️ Xóa
                        </button>
                    </div>
                    
                    <input type="hidden" name="Questions[${index}].Id" value="0" />
                    
                    <div class="mb-3">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nội dung câu hỏi *</label>
                        <textarea name="Questions[${index}].Content" required placeholder="Nhập nội dung câu hỏi..." class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" rows="2"></textarea>
                    </div>
                    
                    <div class="space-y-2 mb-3">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án A *</label>
                        <div class="flex items-center gap-2">
                            <input type="radio" name="Questions[${index}].CorrectOption" value="A" required class="w-4 h-4">
                            <input type="text" name="Questions[${index}].OptionA" required placeholder="Nhập đáp án A" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                        </div>
                    </div>
                    
                    <div class="space-y-2 mb-3">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án B *</label>
                        <div class="flex items-center gap-2">
                            <input type="radio" name="Questions[${index}].CorrectOption" value="B" required class="w-4 h-4">
                            <input type="text" name="Questions[${index}].OptionB" required placeholder="Nhập đáp án B" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                        </div>
                    </div>
                    
                    <div class="space-y-2 mb-3">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án C *</label>
                        <div class="flex items-center gap-2">
                            <input type="radio" name="Questions[${index}].CorrectOption" value="C" required class="w-4 h-4">
                            <input type="text" name="Questions[${index}].OptionC" required placeholder="Nhập đáp án C" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                        </div>
                    </div>
                    
                    <div class="space-y-2 mb-3">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Đáp án D *</label>
                        <div class="flex items-center gap-2">
                            <input type="radio" name="Questions[${index}].CorrectOption" value="D" required class="w-4 h-4">
                            <input type="text" name="Questions[${index}].OptionD" required placeholder="Nhập đáp án D" class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Điểm số</label>
                        <input type="number" name="Questions[${index}].Marks" min="0" step="0.5" value="1" placeholder="1.0" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Điểm số cho câu hỏi này (mặc định: 1 điểm)</p>
                    </div>
                </div>
            `;
            
            container.insertAdjacentHTML('beforeend', questionHtml);
            
            // Scroll to new question
            const newQuestion = container.lastElementChild;
            if (newQuestion) {
                newQuestion.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        function removeQuestion(index, questionId) {
            if (!confirm('Bạn có chắc chắn muốn xóa câu hỏi này?')) {
                return;
            }
            
            const question = document.querySelector(`[data-question-index="${index}"]`);
            if (question) {
                // If it's an existing question, mark it for deletion
                if (questionId > 0) {
                    const deleteInput = document.createElement('input');
                    deleteInput.type = 'hidden';
                    deleteInput.name = `QuestionsToDelete[${questionId}]`;
                    deleteInput.value = 'true';
                    question.appendChild(deleteInput);
                    question.classList.add('deleting');
                    setTimeout(() => {
                        question.style.display = 'none';
                        updateQuestionNumbers();
                    }, 300);
                } else {
                    question.classList.add('deleting');
                    setTimeout(() => {
                        question.remove();
                        updateQuestionNumbers();
                    }, 300);
                }
            }
        }

        function updateQuestionNumbers() {
            const questions = document.querySelectorAll('[data-question-index]:not([style*="display: none"])');
            questions.forEach((q, index) => {
                const number = index + 1;
                const headerSpan = q.querySelector('.font-semibold');
                if (headerSpan) {
                    const questionId = parseInt(q.getAttribute('data-question-id') || '0');
                    const badge = questionId > 0 
                        ? '<span class="px-2 py-1 text-xs bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400 rounded-full ml-2">Đã lưu</span>' 
                        : '<span class="px-2 py-1 text-xs bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-400 rounded-full ml-2">Mới</span>';
                    headerSpan.innerHTML = `Câu hỏi ${number} ${badge}`;
                }
                
                q.setAttribute('data-question-index', index);
                
                const inputs = q.querySelectorAll('input, textarea');
                inputs.forEach(input => {
                    if (input.name) {
                        input.name = input.name.replace(/Questions\[\d+\]/, `Questions[${index}]`);
                    }
                });
                
                const removeBtn = q.querySelector('button[onclick*="removeQuestion"]');
                if (removeBtn) {
                    const questionId = parseInt(q.getAttribute('data-question-id') || '0');
                    removeBtn.setAttribute('onclick', `removeQuestion(${index}, ${questionId})`);
                }
            });
            questionCount = questions.length;
        }

        // Form validation
        document.getElementById('examForm').addEventListener('submit', function(e) {
            // Validate category/subject fields
            const useNewCategory = document.getElementById('useNewCategory').checked;
            const useNewSubject = document.getElementById('useNewSubject').checked;
            
            if (useNewCategory) {
                const newCategoryTitle = document.getElementById('NewCategoryTitle').value.trim();
                if (!newCategoryTitle) {
                    e.preventDefault();
                    alert('⚠️ Vui lòng nhập tên danh mục mới!');
                    document.getElementById('NewCategoryTitle').focus();
                    return false;
                }
            } else {
                const categoryId = document.getElementById('CategoryId').value;
                if (!categoryId) {
                    e.preventDefault();
                    alert('⚠️ Vui lòng chọn danh mục!');
                    document.getElementById('CategoryId').focus();
                    return false;
                }
            }
            
            if (useNewSubject) {
                const newSubjectTitle = document.getElementById('NewSubjectTitle').value.trim();
                if (!newSubjectTitle) {
                    e.preventDefault();
                    alert('⚠️ Vui lòng nhập tên môn học mới!');
                    document.getElementById('NewSubjectTitle').focus();
                    return false;
                }
                // Description is optional, no validation needed
            } else {
                const subjectId = document.getElementById('SubjectId').value;
                if (!subjectId) {
                    e.preventDefault();
                    alert('⚠️ Vui lòng chọn môn học!');
                    document.getElementById('SubjectId').focus();
                    return false;
                }
            }

            // Validate questions
            const questions = document.querySelectorAll('[data-question-index]:not([style*="display: none"])');
            if (questions.length === 0) {
                e.preventDefault();
                alert('⚠️ Vui lòng thêm ít nhất 1 câu hỏi!');
                return false;
            }

            // Validate each question has a correct answer selected
            let allValid = true;
            let invalidQuestions = [];
            questions.forEach((q, index) => {
                const correctOption = q.querySelector('input[type="radio"]:checked');
                const content = q.querySelector('textarea[name*="Content"]')?.value?.trim();
                const optionA = q.querySelector('input[name*="OptionA"]')?.value?.trim();
                const optionB = q.querySelector('input[name*="OptionB"]')?.value?.trim();
                const optionC = q.querySelector('input[name*="OptionC"]')?.value?.trim();
                const optionD = q.querySelector('input[name*="OptionD"]')?.value?.trim();
                
                if (!correctOption || !content || !optionA || !optionB || !optionC || !optionD) {
                    allValid = false;
                    invalidQuestions.push(index + 1);
                }
            });

            if (!allValid) {
                e.preventDefault();
                if (invalidQuestions.length > 0) {
                    alert(`⚠️ Vui lòng điền đầy đủ thông tin và chọn đáp án đúng cho các câu hỏi: ${invalidQuestions.join(', ')}`);
                } else {
                    alert('⚠️ Vui lòng chọn đáp án đúng cho tất cả các câu hỏi!');
                }
                return false;
            }
        });
    </script>
}
