@model QuizlyWebsite.Models.TbExam
@inject QuizlyWebsite.Services.IAccessControlService AccessControl
@inject QuizlyWebsite.Services.ISubscriptionService Subscription

@{
    ViewData["Title"] = Model.Title;
    var userId = ViewContext.HttpContext.Session.GetInt32("UserId");
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var canAccessPaidExam = ViewBag.CanAccessPaidExam as bool? ?? true;
    var isPaidExam = Model.IsPaid == true;
}

<div class="relative flex h-auto min-h-screen w-full flex-col bg-background-light dark:bg-background-dark group/design-root overflow-x-hidden">
    <div class="flex min-h-screen">
        <!-- SideNavBar -->
        <aside class="w-80 border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 flex-col justify-between hidden lg:flex">
            <div class="flex h-full flex-col justify-between p-4">
                <div class="flex flex-col gap-4">
                    <div class="flex items-center gap-3 p-3">
                        <a href="/" class="flex items-center gap-2">
                            <div class="text-primary text-2xl">
                                <span class="material-symbols-outlined">school</span>
                            </div>
                            <h1 class="text-slate-900 dark:text-slate-50 text-base font-bold leading-normal">Quizly</h1>
                        </a>
                    </div>
                    <div class="flex items-center gap-3 px-3 py-2">
                        <span class="material-symbols-outlined text-slate-600 dark:text-slate-300">quiz</span>
                        <p class="text-slate-900 dark:text-slate-50 text-sm font-medium leading-normal">@Model.Title</p>
                    </div>
                </div>
                <div class="flex flex-col gap-4">
                    <div class="flex flex-col gap-1">
                        <a href="@Url.Action("Index", "Profile")" class="flex items-center gap-3 px-3 py-2 cursor-pointer rounded-md hover:bg-slate-100 dark:hover:bg-slate-800">
                            <span class="material-symbols-outlined text-slate-600 dark:text-slate-300">settings</span>
                            <p class="text-slate-600 dark:text-slate-300 text-sm font-medium leading-normal">Settings</p>
                        </a>
                        <a href="/logout" class="flex items-center gap-3 px-3 py-2 cursor-pointer rounded-md hover:bg-slate-100 dark:hover:bg-slate-800">
                            <span class="material-symbols-outlined text-slate-600 dark:text-slate-300">logout</span>
                            <p class="text-slate-600 dark:text-slate-300 text-sm font-medium leading-normal">Logout</p>
                        </a>
                    </div>
                </div>
            </div>
        </aside>
        
        <!-- Main Content -->
        <main class="flex-1 p-4 sm:p-6 lg:p-10">
            <div class="layout-content-container flex flex-col mx-auto max-w-4xl flex-1">
                <!-- PageHeading -->
                <div class="flex flex-wrap justify-between gap-3 p-4">
                    <p class="text-slate-900 dark:text-slate-50 tracking-tight text-3xl font-bold leading-tight min-w-72">@Model.Title</p>
                </div>
                
                <!-- Exam Info Card -->
                <div class="p-4 bg-white dark:bg-slate-900 rounded-xl shadow-sm mb-6">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="flex items-center gap-3 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
                            <span class="material-symbols-outlined text-primary text-2xl">help</span>
                            <div>
                                <p class="text-sm text-slate-500 dark:text-slate-400">Câu hỏi</p>
                                <p class="font-semibold text-slate-900 dark:text-slate-50">@Model.QuestionCount</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
                            <span class="material-symbols-outlined text-primary text-2xl">schedule</span>
                            <div>
                                <p class="text-sm text-slate-500 dark:text-slate-400">Thời gian</p>
                                <p class="font-semibold text-slate-900 dark:text-slate-50">@Model.Duration phút</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
                            <span class="material-symbols-outlined text-primary text-2xl">category</span>
                            <div>
                                <p class="text-sm text-slate-500 dark:text-slate-400">Môn học</p>
                                <p class="font-semibold text-slate-900 dark:text-slate-50">@(Model.Subject?.Title ?? "N/A")</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
                            <span class="material-symbols-outlined text-primary text-2xl">trending_up</span>
                            <div>
                                <p class="text-sm text-slate-500 dark:text-slate-400">Độ khó</p>
                                <p class="font-semibold text-slate-900 dark:text-slate-50">@Model.Difficulty</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Exam Info -->
                <div class="p-4 bg-white dark:bg-slate-900 rounded-xl shadow-sm mb-6">
                    <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-4">Thông Tin Đề Thi</h2>
                    <div class="space-y-2 text-slate-600 dark:text-slate-400">
                        <p><strong class="text-slate-900 dark:text-slate-50">Tiêu đề:</strong> @Model.Title</p>
                        <p><strong class="text-slate-900 dark:text-slate-50">Môn học:</strong> @(Model.Subject?.Title ?? "N/A")</p>
                        <p><strong class="text-slate-900 dark:text-slate-50">Độ khó:</strong> @Model.Difficulty</p>
                        @if (Model.AvgRating.HasValue)
                        {
                            <p><strong class="text-slate-900 dark:text-slate-50">Đánh giá:</strong> @string.Format("{0:F1}", Model.AvgRating.Value) / 5.0</p>
                        }
                    </div>
                </div>
                
                <!-- Reviews Section -->
                @if (Model.TbExamReviews?.Any() == true)
                {
                    <div class="p-4 bg-white dark:bg-slate-900 rounded-xl shadow-sm mb-6">
                        <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-4">Đánh Giá Từ Người Dùng</h2>
                        <div class="space-y-4">
                            @foreach (var review in Model.TbExamReviews.Take(5))
                            {
                                <div class="pb-4 border-b border-slate-200 dark:border-slate-700 last:border-b-0">
                                    <div class="flex items-start justify-between mb-2">
                                        <div>
                                            <p class="font-semibold text-slate-900 dark:text-slate-50">@(review.User?.FullName ?? "Ẩn danh")</p>
                                            <p class="text-xs text-slate-500 dark:text-slate-400">@review.CreatedAt?.ToString("dd/MM/yyyy")</p>
                                        </div>
                                        <div class="flex gap-1">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                @if (i < (review.Rating ?? 0))
                                                {
                                                    <span class="text-yellow-400">★</span>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-300 dark:text-slate-600">★</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <p class="text-slate-600 dark:text-slate-400">@review.Comment</p>
                                </div>
                            }
                        </div>
                    </div>
                }
                
                <!-- Start Button -->
                <div class="p-4 bg-white dark:bg-slate-900 rounded-xl shadow-sm">
                    @if (!isAuthenticated)
                    {
                        <a href="/login" class="flex w-full cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-6 bg-primary text-white text-base font-bold leading-normal shadow-lg shadow-primary/30 hover:bg-opacity-90 transition-all">
                            <span class="material-symbols-outlined align-middle mr-2">login</span>
                            <span class="truncate">Đăng Nhập Để Làm Bài</span>
                        </a>
                    }
                    else if (isPaidExam && !canAccessPaidExam)
                    {
                        <div class="space-y-3">
                            <div class="p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
                                <p class="text-sm text-yellow-800 dark:text-yellow-200 font-semibold mb-2">
                                    <span class="material-symbols-outlined align-middle mr-1">lock</span>
                                    Đề thi trả phí
                                </p>
                                <p class="text-sm text-yellow-700 dark:text-yellow-300">
                                    Bạn cần đăng ký gói trả phí để làm đề thi này.
                                </p>
                            </div>
                            <a href="@Url.Action("Pricing", "Subscription")" class="flex w-full cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-6 bg-gradient-to-r from-purple-500 to-pink-500 text-white text-base font-bold leading-normal shadow-lg hover:from-purple-600 hover:to-pink-600 transition-all">
                                <span class="material-symbols-outlined align-middle mr-2">workspace_premium</span>
                                <span class="truncate">Đăng Ký Gói Trả Phí</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Start", "Quiz", new { id = Model.Id })" class="flex w-full cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-6 bg-primary text-white text-base font-bold leading-normal shadow-lg shadow-primary/30 hover:bg-opacity-90 transition-all">
                            <span class="material-symbols-outlined align-middle mr-2">play_arrow</span>
                            <span class="truncate">Bắt Đầu Làm Bài</span>
                        </a>
                    }
                </div>
            </div>
        </main>
    </div>
</div>
