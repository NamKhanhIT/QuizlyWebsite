@model QuizlyWebsite.Models.TbExam

@{
    ViewData["Title"] = Model.Title;
}

<div class="px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40 py-10">
    <!-- Breadcrumb -->
    <nav class="flex gap-2 mb-8 text-sm">
        <a href="/" class="text-primary hover:underline">Trang chủ</a>
        <span class="text-gray-400">/</span>
        <a href="/quiz/list" class="text-primary hover:underline">Bộ đề</a>
        <span class="text-gray-400">/</span>
        <span class="text-gray-600 dark:text-gray-400">@Model.Title</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2">
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8">
                <!-- Title -->
                <h1 class="text-4xl font-black text-[#0d141b] dark:text-slate-50 mb-4">@Model.Title</h1>

                <!-- Meta Info -->
                <div class="flex flex-wrap gap-4 mb-6 pb-6 border-b border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-2 text-[#4c739a] dark:text-slate-400">
                        <span class="material-symbols-outlined">category</span>
                        <span>@Model.Subject.Title</span>
                    </div>
                    <div class="flex items-center gap-2 text-[#4c739a] dark:text-slate-400">
                        <span class="material-symbols-outlined">help</span>
                        <span>@Model.QuestionCount câu hỏi</span>
                    </div>
                    <div class="flex items-center gap-2 text-[#4c739a] dark:text-slate-400">
                        <span class="material-symbols-outlined">schedule</span>
                        <span>@Model.Duration phút</span>
                    </div>
                    <div>
                        @{
                            var diffColor = Model.Difficulty == "Dễ" ? "bg-success/20 text-success" : 
                                           Model.Difficulty == "Trung bình" ? "bg-warning/20 text-warning" :
                                           "bg-danger/20 text-danger";
                        }
                        <span class="text-xs font-semibold px-3 py-1 rounded @diffColor">@Model.Difficulty</span>
                    </div>
                </div>

                <!-- Features -->
                <div class="grid grid-cols-2 gap-4 mb-8">
                    <div class="flex items-center gap-3 p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                        <span class="material-symbols-outlined text-primary text-2xl">verified</span>
                        <div>
                            <p class="text-sm text-[#4c739a] dark:text-slate-400">Được Xác Minh</p>
                            <p class="font-semibold">@Model.TotalReviews</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                        <span class="material-symbols-outlined text-primary text-2xl">star</span>
                        <div>
                            <p class="text-sm text-[#4c739a] dark:text-slate-400">Đánh Giá</p>
                            <p class="font-semibold">@(string.Format("{0:F1}", Model.AvgRating ?? 0)) / 5</p>
                        </div>
                    </div>
                </div>

                <!-- Reviews Section -->
                <div class="mt-12">
                    <h2 class="text-2xl font-bold mb-6">Đánh Giá Từ Người Dùng</h2>
                    @if (Model.TbExamReviews.Any())
                    {
                        @foreach (var review in Model.TbExamReviews.Take(5))
                        {
                            <div class="mb-4 pb-4 border-b border-gray-200 dark:border-gray-700 last:border-b-0">
                                <div class="flex items-start justify-between mb-2">
                                    <div>
                                        <p class="font-semibold text-[#0d141b] dark:text-slate-50">@(review.User?.FullName ?? "Ẩn danh")</p>
                                        <p class="text-xs text-[#4c739a] dark:text-slate-400">@review.CreatedAt?.ToString("dd/MM/yyyy")</p>
                                    </div>
                                    <div class="flex gap-1">
                                        @for (int i = 0; i < (review.Rating ?? 0); i++)
                                        {
                                            <span class="text-yellow-400">★</span>
                                        }
                                    </div>
                                </div>
                                <p class="text-[#4c739a] dark:text-slate-400">@review.Comment</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-[#4c739a] dark:text-slate-400">Chưa có đánh giá nào</p>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8 sticky top-24">
                <!-- Price -->
                <div class="mb-6">
                    @if (Model.IsPremium == true)
                    {
                        <p class="text-sm text-[#4c739a] dark:text-slate-400 mb-2">Giá:</p>
                        <p class="text-3xl font-black text-primary">@Model.Price?.ToString("C") ?? "Miễn Phí"</p>
                    }
                    else
                    {
                        <p class="text-3xl font-black text-success">Miễn Phí</p>
                    }
                </div>

                <!-- Start Button -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/quiz/start/@Model.Id" class="w-full bg-primary text-white font-bold py-3 rounded-lg hover:bg-primary-dark transition block text-center mb-3 btn-glow">
                        <span class="material-symbols-outlined align-middle mr-2">play_arrow</span>
                        Bắt Đầu Làm Bài
                    </a>
                }
                else
                {
                    <a href="/login" class="w-full bg-primary text-white font-bold py-3 rounded-lg hover:bg-primary-dark transition block text-center mb-3">
                        <span class="material-symbols-outlined align-middle mr-2">login</span>
                        Đăng Nhập Để Làm Bài
                    </a>
                }

                <!-- Share Button -->
                <button class="w-full border border-gray-300 dark:border-gray-600 text-[#0d141b] dark:text-slate-50 font-semibold py-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition">
                    <span class="material-symbols-outlined align-middle mr-2">share</span>
                    Chia Sẻ
                </button>

                <!-- Info Box -->
                <div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
                    <p class="text-sm text-[#4c739a] dark:text-slate-400 mb-3">
                        <span class="material-symbols-outlined align-middle text-primary">info</span>
                        Thông Tin Bộ Đề
                    </p>
                    <ul class="text-sm space-y-2">
                        <li class="flex justify-between">
                            <span class="text-[#4c739a] dark:text-slate-400">Câu hỏi:</span>
                            <span class="font-semibold">@Model.QuestionCount</span>
                        </li>
                        <li class="flex justify-between">
                            <span class="text-[#4c739a] dark:text-slate-400">Thời gian:</span>
                            <span class="font-semibold">@Model.Duration phút</span>
                        </li>
                        <li class="flex justify-between">
                            <span class="text-[#4c739a] dark:text-slate-400">Độ khó:</span>
                            <span class="font-semibold">@Model.Difficulty</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
