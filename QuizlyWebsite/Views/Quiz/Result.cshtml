@model QuizlyWebsite.Models.TbExamResult

@{
    ViewData["Title"] = "Kết Quả Bài Thi";
}

<div class="px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40 py-10">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6 max-w-4xl mx-auto">
            <p class="font-semibold">@TempData["SuccessMessage"]</p>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-4 mb-6 max-w-4xl mx-auto">
            <p class="font-semibold">@TempData["ErrorMessage"]</p>
        </div>
    }
    
    <!-- Result Header -->
    <div class="bg-gradient-to-r from-primary/20 to-blue-100 dark:from-primary/30 dark:to-blue-900/30 rounded-xl p-8 md:p-12 text-center mb-8">
        <div class="mb-6">
            @{
                var isCancelled = Model.Status == "Cancelled";
                var isPassed = !isCancelled && Model.Score >= 5; // Thang điểm 10, đạt từ 5.0 trở lên
                var resultColor = isCancelled ? "text-red-600" : (isPassed ? "text-success" : "text-danger");
                var resultIcon = isCancelled ? "block" : (isPassed ? "check_circle" : "cancel");
                var resultText = isCancelled ? "Bị Hủy" : (isPassed ? "Đạt" : "Không Đạt");
            }
            <span class="material-symbols-outlined text-6xl @resultColor">@resultIcon</span>
        </div>
        
        <h1 class="text-4xl font-black text-[#0d141b] dark:text-slate-50 mb-2">@resultText</h1>
        
        @if (isCancelled)
        {
            <div class="bg-red-50 dark:bg-red-900/20 border-2 border-red-300 dark:border-red-700 rounded-lg p-4 mb-4 max-w-md mx-auto">
                <p class="text-sm font-bold text-red-700 dark:text-red-300 text-center">
                    ⚠️ Bài thi đã bị hủy do vi phạm quá 3 lần (chuyển tab/thoát màn hình)
                </p>
            </div>
        }
        <p class="text-xl text-[#4c739a] dark:text-slate-400 mb-4">@Model.Exam.Title</p>

        <!-- Score Display -->
        <div class="grid grid-cols-3 gap-4 max-w-md mx-auto">
            <div class="bg-white dark:bg-gray-800 rounded-lg p-4">
                <p class="text-3xl font-black text-primary">@(Model.Score?.ToString("F1") ?? "0.0")</p>
                <p class="text-xs text-[#4c739a] dark:text-slate-400">Điểm</p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-lg p-4">
                <p class="text-3xl font-black text-success">@Model.CorrectAnswers</p>
                <p class="text-xs text-[#4c739a] dark:text-slate-400">Đúng</p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-lg p-4">
                <p class="text-3xl font-black text-danger">@(Model.TotalQuestions - Model.CorrectAnswers)</p>
                <p class="text-xs text-[#4c739a] dark:text-slate-400">Sai</p>
            </div>
        </div>

        <!-- Time Info -->
        <div class="mt-6 text-sm text-[#4c739a] dark:text-slate-400">
            <p>Thực hiện từ @Model.StartedAt?.ToString("HH:mm:ss") đến @Model.FinishedAt?.ToString("HH:mm:ss")</p>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex gap-4 justify-center mb-12">
        <a href="/quiz/detail/@Model.ExamId" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition">
            <span class="material-symbols-outlined align-middle mr-2">refresh</span> Làm Lại
        </a>
        <a href="/quiz/list" class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-[#0d141b] dark:text-slate-50 rounded-lg font-semibold hover:bg-gray-300 dark:hover:bg-gray-600 transition">
            <span class="material-symbols-outlined align-middle mr-2">arrow_back</span> Danh Sách Bộ Đề
        </a>
    </div>

    <!-- Violations Section (if cancelled) -->
    @if (Model.Status == "Cancelled" && Model.Session?.TbExamViolations != null && Model.Session.TbExamViolations.Any())
    {
        <div class="max-w-4xl mx-auto mb-8">
            <h2 class="text-2xl font-bold text-[#0d141b] dark:text-slate-50 mb-6">Lịch Sử Vi Phạm</h2>
            <div class="bg-red-50 dark:bg-red-900/20 border-2 border-red-300 dark:border-red-700 rounded-lg p-6">
                <div class="mb-4">
                    <p class="text-lg font-bold text-red-700 dark:text-red-300 mb-2">
                        Tổng số lần vi phạm: <span class="text-2xl">@Model.Session.TbExamViolations.Count</span>
                    </p>
                    <p class="text-sm text-red-600 dark:text-red-400">
                        Mỗi lần vi phạm bị trừ 0.5 điểm. Sau 3 lần vi phạm, bài thi sẽ bị hủy.
                    </p>
                </div>
                <div class="space-y-3">
                    @foreach (var violation in Model.Session.TbExamViolations.OrderBy(v => v.ViolationTime))
                    {
                        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 border border-red-200 dark:border-red-800">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <span class="material-symbols-outlined text-red-500">warning</span>
                                    <div>
                                        <p class="font-semibold text-gray-900 dark:text-white">
                                            @violation.ViolationType
                                        </p>
                                        <p class="text-sm text-gray-600 dark:text-gray-400">
                                            @violation.ViolationTime?.ToString("dd/MM/yyyy HH:mm:ss")
                                        </p>
                                    </div>
                                </div>
                                <span class="px-3 py-1 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-full text-sm font-semibold">
                                    -0.5 điểm
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Review Section -->
    <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-[#0d141b] dark:text-slate-50 mb-6">Chi Tiết Câu Trả Lời</h2>
        
        @if (!Model.TbExamResultDetails.Any())
        {
            <div class="bg-yellow-50 dark:bg-yellow-900/20 border-2 border-yellow-300 dark:border-yellow-700 rounded-lg p-6 text-center">
                <p class="text-yellow-700 dark:text-yellow-300">
                    Bài thi bị hủy trước khi hoàn thành. Không có câu trả lời nào được ghi nhận.
                </p>
            </div>
        }

        @foreach (var detail in Model.TbExamResultDetails)
        {
            var isCorrect = detail.IsCorrect ?? false;
            <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6 mb-4">
                <!-- Question -->
                <div class="flex items-start gap-4 mb-4">
                    <div class="flex-1">
                        <h3 class="font-bold text-[#0d141b] dark:text-slate-50 mb-2">
                            @Html.Raw(detail.Question.Content)
                        </h3>
                        
                        <!-- Options -->
                        <div class="space-y-2 ml-4">
                            @{
                                var options = new[] { detail.Question.OptionA, detail.Question.OptionB, detail.Question.OptionC, detail.Question.OptionD };
                                var optionLabels = new[] { "A", "B", "C", "D" };
                            }

                            @for (int i = 0; i < options.Length; i++)
                            {
                                var isSelected = detail.SelectedOption?.ToString() == optionLabels[i];
                                var isCorrectOption = detail.Question.CorrectOption?.ToString() == optionLabels[i];
                                var optionClass = "";

                                if (isCorrectOption)
                                    optionClass = "bg-success/20 border-success text-success";
                                else if (isSelected && !isCorrect)
                                    optionClass = "bg-danger/20 border-danger text-danger";
                                else
                                    optionClass = "border-gray-300 dark:border-gray-600";

                                <div class="flex items-center gap-3 p-3 border rounded-lg @optionClass">
                                    <span class="font-semibold">@optionLabels[i]:</span>
                                    <span>@options[i]</span>
                                    @if (isCorrectOption)
                                    {
                                        <span class="material-symbols-outlined text-sm ml-auto">check_circle</span>
                                    }
                                    @if (isSelected && !isCorrect)
                                    {
                                        <span class="material-symbols-outlined text-sm ml-auto">cancel</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Status Badge -->
                    <div class="flex-shrink-0">
                        @if (isCorrect)
                        {
                            <div class="flex flex-col items-center gap-2 bg-success/20 text-success rounded-lg p-3">
                                <span class="material-symbols-outlined">check_circle</span>
                                <span class="text-xs font-semibold">Đúng</span>
                            </div>
                        }
                        else
                        {
                            <div class="flex flex-col items-center gap-2 bg-danger/20 text-danger rounded-lg p-3">
                                <span class="material-symbols-outlined">cancel</span>
                                <span class="text-xs font-semibold">Sai</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Review & Rating Section -->
    <div class="max-w-4xl mx-auto mt-12">
        <h2 class="text-2xl font-bold text-[#0d141b] dark:text-slate-50 mb-6">
            <span class="material-symbols-outlined align-middle mr-2">rate_review</span>
            Đánh Giá Đề Thi
        </h2>

        <!-- User's Review Form -->
        @if (ViewBag.UserId != null)
        {
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 mb-8">
                <h3 class="text-lg font-semibold text-[#0d141b] dark:text-slate-50 mb-4">
                    @(ViewBag.UserReview != null ? "Chỉnh Sửa Đánh Giá Của Bạn" : "Đánh Giá Đề Thi")
                </h3>
                
                <form method="post" action="/quiz/submit-review" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examId" value="@Model.ExamId" />
                    
                    <!-- Rating Stars -->
                    <div>
                        <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                            Điểm Đánh Giá <span class="text-danger">*</span>
                        </label>
                        <div class="flex gap-2" id="ratingContainer">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <button type="button" class="rating-star text-3xl text-gray-300 hover:text-yellow-400 transition" 
                                        data-rating="@i" aria-label="@i sao">
                                    <span class="material-symbols-outlined">star</span>
                                </button>
                            }
                        </div>
                        <input type="hidden" name="rating" id="ratingInput" value="@(ViewBag.UserReview?.Rating ?? 0)" required />
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" id="ratingText">Chọn số sao đánh giá</p>
                    </div>

                    <!-- Comment -->
                    <div>
                        <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                            Nhận Xét (tùy chọn)
                        </label>
                        <textarea name="comment" id="commentInput" rows="4" 
                                  placeholder="Chia sẻ ý kiến của bạn về đề thi này..."
                                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition resize-none">@(ViewBag.UserReview?.Comment ?? "")</textarea>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Tối đa 800 ký tự</p>
                    </div>

                    <!-- Submit Button -->
                    <div class="flex gap-3">
                        <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition">
                            <span class="material-symbols-outlined align-middle mr-2">send</span>
                            @(ViewBag.UserReview != null ? "Cập Nhật Đánh Giá" : "Gửi Đánh Giá")
                        </button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <div class="bg-yellow-50 dark:bg-yellow-900/20 border-2 border-yellow-300 dark:border-yellow-700 rounded-lg p-6 text-center mb-8">
                <p class="text-yellow-700 dark:text-yellow-300">
                    <a href="/auth/login" class="text-primary hover:underline font-semibold">Đăng nhập</a> để đánh giá đề thi này.
                </p>
            </div>
        }

        <!-- Other Users' Reviews -->
        @if (ViewBag.OtherReviews != null && ((List<QuizlyWebsite.Models.TbExamReview>)ViewBag.OtherReviews).Any())
        {
            <div class="mt-8">
                <h3 class="text-xl font-semibold text-[#0d141b] dark:text-slate-50 mb-4">
                    Đánh Giá Từ Người Dùng Khác (@(((List<QuizlyWebsite.Models.TbExamReview>)ViewBag.OtherReviews).Count))
                </h3>
                <div class="space-y-4">
                    @foreach (var review in (List<QuizlyWebsite.Models.TbExamReview>)ViewBag.OtherReviews)
                    {
                        <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
                            <div class="flex items-start justify-between mb-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-primary/20 rounded-full flex items-center justify-center">
                                        <span class="material-symbols-outlined text-primary">person</span>
                                    </div>
                                    <div>
                                        <p class="font-semibold text-[#0d141b] dark:text-slate-50">
                                            @(review.User?.FullName ?? "Người dùng ẩn danh")
                                        </p>
                                        <p class="text-xs text-gray-500 dark:text-gray-400">
                                            @(review.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "")
                                        </p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-lg @(i <= (review.Rating ?? 0) ? "text-yellow-400" : "text-gray-300")">
                                            star
                                        </span>
                                    }
                                    <span class="ml-2 text-sm font-semibold text-[#0d141b] dark:text-slate-50">
                                        @(review.Rating ?? 0)/5
                                    </span>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="text-[#0d141b] dark:text-slate-50 mt-3">
                                    @review.Comment
                                </p>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-lg p-6 text-center">
                <p class="text-gray-500 dark:text-gray-400">
                    Chưa có đánh giá nào từ người dùng khác.
                </p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Rating star selection
        document.addEventListener('DOMContentLoaded', function() {
            const stars = document.querySelectorAll('.rating-star');
            const ratingInput = document.getElementById('ratingInput');
            const ratingText = document.getElementById('ratingText');
            
            // Initialize with existing rating
            const currentRating = parseInt(ratingInput.value) || 0;
            if (currentRating > 0) {
                updateStarDisplay(currentRating);
            }

            stars.forEach((star, index) => {
                star.addEventListener('click', function() {
                    const rating = index + 1;
                    ratingInput.value = rating;
                    updateStarDisplay(rating);
                });

                star.addEventListener('mouseenter', function() {
                    const rating = index + 1;
                    updateStarDisplay(rating, true);
                });
            });

            const ratingContainer = document.getElementById('ratingContainer');
            if (ratingContainer) {
                ratingContainer.addEventListener('mouseleave', function() {
                    const currentRating = parseInt(ratingInput.value) || 0;
                    updateStarDisplay(currentRating);
                });
            }

            function updateStarDisplay(rating, isHover = false) {
                stars.forEach((star, index) => {
                    const starIcon = star.querySelector('.material-symbols-outlined');
                    if (index < rating) {
                        starIcon.textContent = 'star';
                        starIcon.classList.add('text-yellow-400');
                        starIcon.classList.remove('text-gray-300');
                    } else {
                        starIcon.textContent = 'star';
                        starIcon.classList.add('text-gray-300');
                        starIcon.classList.remove('text-yellow-400');
                    }
                });

                const ratingLabels = ['', 'Rất tệ', 'Tệ', 'Bình thường', 'Tốt', 'Rất tốt'];
                if (rating > 0 && rating <= 5) {
                    ratingText.textContent = ratingLabels[rating];
                } else {
                    ratingText.textContent = 'Chọn số sao đánh giá';
                }
            }

            // Comment character limit
            const commentInput = document.getElementById('commentInput');
            if (commentInput) {
                commentInput.addEventListener('input', function() {
                    if (this.value.length > 800) {
                        this.value = this.value.substring(0, 800);
                    }
                });
            }
        });
    </script>
}
