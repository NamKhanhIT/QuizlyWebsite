@model QuizlyWebsite.Models.TbCourse
@inject QuizlyWebsite.Services.IAccessControlService AccessControl
@inject QuizlyWebsite.Services.ISubscriptionService SubscriptionService

@{
    ViewData["Title"] = Model.Title;
    var userId = ViewContext.HttpContext.Session.GetInt32("UserId") ?? 0;
    var userHasAccess = ViewBag.UserHasAccess as bool? ?? false;
    var lessons = Model.TbLessons?.OrderBy(l => l.Id).ToList() ?? new List<QuizlyWebsite.Models.TbLesson>();
    var isPremium = await SubscriptionService.IsPremiumPlanAsync(userId);
}

<main class="min-h-screen bg-background-light dark:bg-background-dark">
    <!-- Cover Banner -->
    <div class="h-64 bg-gradient-to-r from-primary to-primary-dark relative">
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-end pb-8">
            <div>
                <h1 class="text-4xl font-bold text-white mb-2">@Model.Title</h1>
                <div class="flex items-center gap-4 text-white/90">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">person</span>
                        <span>@Model.CreatedByNavigation?.FullName</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">menu_book</span>
                        <span>@lessons.Count bài học</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Description -->
                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Mô tả khóa học</h2>
                    <p class="text-gray-600 dark:text-gray-400 leading-relaxed">@(Model.Description ?? "Chưa có mô tả")</p>
                </div>

                <!-- Objectives -->
                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Mục tiêu khóa học</h2>
                    <ul class="space-y-2">
                        <li class="flex items-start gap-3 text-gray-600 dark:text-gray-400">
                            <span class="material-symbols-outlined text-primary mt-0.5">check_circle</span>
                            <span>Nắm vững kiến thức cơ bản</span>
                        </li>
                        <li class="flex items-start gap-3 text-gray-600 dark:text-gray-400">
                            <span class="material-symbols-outlined text-primary mt-0.5">check_circle</span>
                            <span>Áp dụng vào thực tế</span>
                        </li>
                        <li class="flex items-start gap-3 text-gray-600 dark:text-gray-400">
                            <span class="material-symbols-outlined text-primary mt-0.5">check_circle</span>
                            <span>Phát triển kỹ năng chuyên sâu</span>
                        </li>
                    </ul>
                </div>

                <!-- Curriculum -->
                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Chương trình học</h2>
                    <div class="space-y-2">
                        @for (int i = 0; i < lessons.Count; i++)
                        {
                            var lesson = lessons[i];
                            var lessonIndex = i + 1;
                            var canAccessLesson = await AccessControl.CanAccessLessonAsync(userId, lesson);
                            var isPreview = lesson.IsPreview == true;
                            var isLocked = !canAccessLesson && !isPreview;

                            <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
                                <button onclick="toggleLesson(@lesson.Id)" class="w-full flex items-center justify-between p-4 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                                    <div class="flex items-center gap-3">
                                        @if (isLocked)
                                        {
                                            <span class="material-symbols-outlined text-gray-400">lock</span>
                                        }
                                        else if (isPreview || canAccessLesson)
                                        {
                                            <span class="material-symbols-outlined text-primary">play_circle</span>
                                        }
                                        <span class="font-medium text-gray-900 dark:text-white">Bài @lessonIndex: @lesson.Title</span>
                                        @if (isPreview)
                                        {
                                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">Preview</span>
                                        }
                                    </div>
                                    <span class="material-symbols-outlined text-gray-400" id="icon-@lesson.Id">chevron_right</span>
                                </button>
                                <div id="content-@lesson.Id" class="hidden px-4 pb-4">
                                    <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">@(lesson.Content?.Length > 150 ? lesson.Content.Substring(0, 150) + "..." : lesson.Content)</p>
                                    @if (isLocked && !isPreview)
                                    {
                                        <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-3 mb-3">
                                            <p class="text-sm text-yellow-800 dark:text-yellow-200">🔒 Bài học này yêu cầu gói Premium</p>
                                        </div>
                                        <a href="/subscription" class="inline-block px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark transition btn-glow">Nâng cấp ngay</a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Learn", "Lesson", new { courseId = Model.Id, lessonId = lesson.Id })" class="inline-block px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark transition btn-glow">Bắt đầu học</a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Enroll Card -->
                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm sticky top-24">
                    @if (Model.IsPaid == true && !userHasAccess)
                    {
                        <div class="text-center mb-4">
                            <span class="text-3xl font-bold text-primary">Liên hệ</span>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">Để biết giá chi tiết</p>
                        </div>
                        <button class="w-full px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition btn-glow mb-4">
                            Đăng ký khóa học
                        </button>
                    }
                    else if (userHasAccess)
                    {
                        <div class="text-center mb-4">
                            <span class="text-2xl font-bold text-success">Đã đăng ký</span>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">Bạn có thể truy cập tất cả bài học</p>
                        </div>
                        @if (lessons.Any())
                        {
                            var firstLesson = lessons.First();
                            <a href="@Url.Action("Learn", "Lesson", new { courseId = Model.Id, lessonId = firstLesson.Id })" class="block w-full px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition text-center btn-glow">
                                Tiếp tục học
                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-center mb-4">
                            <span class="text-3xl font-bold text-success">Miễn phí</span>
                        </div>
                        @if (lessons.Any())
                        {
                            var firstLesson = lessons.First();
                            <a href="@Url.Action("Learn", "Lesson", new { courseId = Model.Id, lessonId = firstLesson.Id })" class="block w-full px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition text-center btn-glow">
                                Bắt đầu học ngay
                            </a>
                        }
                    }

                    <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700 space-y-3">
                        <div class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400">
                            <span class="material-symbols-outlined text-primary">menu_book</span>
                            <span>@lessons.Count bài học</span>
                        </div>
                        <div class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400">
                            <span class="material-symbols-outlined text-primary">schedule</span>
                            <span>Học mọi lúc</span>
                        </div>
                        <div class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400">
                            <span class="material-symbols-outlined text-primary">devices</span>
                            <span>Truy cập trên mọi thiết bị</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    function toggleLesson(lessonId) {
        const content = document.getElementById('content-' + lessonId);
        const icon = document.getElementById('icon-' + lessonId);
        
        if (content.classList.contains('hidden')) {
            content.classList.remove('hidden');
            icon.style.transform = 'rotate(90deg)';
        } else {
            content.classList.add('hidden');
            icon.style.transform = 'rotate(0deg)';
        }
    }
</script>
