<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - Quizly</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#2b8cee",
                        "primary-dark": "#1a5cbb",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101922",
                        "success": "#22c55e",
                        "danger": "#ef4444",
                        "warning": "#f59e0b"
                    },
                    fontFamily: {
                        "display": ["Lexend", "sans-serif"]
                    },
                    borderRadius: { "DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px" },
                    animation: {
                        "pulse-soft": "pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite",
                        "bounce-light": "bounce 1s infinite",
                        "fade-in": "fadeIn 0.3s ease-in",
                        "slide-up": "slideUp 0.4s ease-out"
                    },
                    keyframes: {
                        fadeIn: {
                            "0%": { opacity: "0" },
                            "100%": { opacity: "1" }
                        },
                        slideUp: {
                            "0%": { transform: "translateY(10px)", opacity: "0" },
                            "100%": { transform: "translateY(0)", opacity: "1" }
                        }
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .btn-glow {
            transition: all 0.3s ease;
        }
        .btn-glow:hover {
            box-shadow: 0 0 20px rgba(43, 140, 238, 0.4);
        }
        .card-hover {
            transition: all 0.3s ease;
        }
        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }
    </style>
    <link rel="stylesheet" href="~/css/animations.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#0d141b] dark:text-slate-50">
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-40 border-b border-solid border-[#e7edf3] dark:border-gray-700 bg-white dark:bg-gray-900 backdrop-blur-sm">
        <div class="px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40">
            <div class="flex items-center justify-between py-4">
                <!-- Logo -->
                <a href="/" class="flex items-center gap-2">
                    <div class="text-primary text-2xl">
                        <span class="material-symbols-outlined">data_usage</span>
                    </div>
                    <h2 class="text-[#0d141b] dark:text-slate-50 text-lg font-bold">Quizly</h2>
                </a>

                <!-- Desktop Menu -->
                <div class="hidden md:flex flex-1 justify-center gap-6 mx-8">
                    <a class="nav-link text-[#0d141b] dark:text-slate-50 text-sm font-medium hover:text-primary transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-primary font-semibold" : "")" href="/">Trang chủ</a>
                    <a class="nav-link text-[#0d141b] dark:text-slate-50 text-sm font-medium hover:text-primary transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Quiz" ? "text-primary font-semibold" : "")" href="/quiz/list">Đề thi</a>
                    <a class="nav-link text-[#0d141b] dark:text-slate-50 text-sm font-medium hover:text-primary transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Course" ? "text-primary font-semibold" : "")" href="/courses">Khóa học</a>
                    <a class="nav-link text-[#0d141b] dark:text-slate-50 text-sm font-medium hover:text-primary transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subscription" ? "text-primary font-semibold" : "")" href="/subscription">Gói trả phí</a>
                    <a class="nav-link text-[#0d141b] dark:text-slate-50 text-sm font-medium hover:text-primary transition-colors @(ViewContext.RouteData.Values["controller"]?.ToString() == "Blog" ? "text-primary font-semibold" : "")" href="/blog">Blogs/News</a>
                    <a class="nav-link text-[#0d141b] dark:text-slate-50 text-sm font-medium hover:text-primary transition-colors" href="/leaderboard">Bảng xếp hạng</a>
                    <a class="nav-link text-[#0d141b] dark:text-slate-50 text-sm font-medium hover:text-primary transition-colors" href="/contact">Liên hệ</a>
                </div>

                <!-- Right Actions -->
                <div class="flex gap-2 items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="relative group">
                            <button class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800">
                                <span class="material-symbols-outlined text-sm">account_circle</span>
                                <span class="text-sm font-medium hidden md:inline">@User.Identity.Name</span>
                            </button>
                            <div class="hidden group-hover:block absolute right-0 w-48 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700">
                                <a href="/user/profile" class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700">Hồ sơ</a>
                                <a href="/user/membership" class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700">Gói hội viên</a>
                                <a href="/user/purchase-history" class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700">Lịch sử mua</a>
                                <hr class="my-1 border-gray-200 dark:border-gray-700" />
                                <a href="/logout" class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 text-danger">Đăng xuất</a>
                            </div>
                        </div>
                        @if (User.IsInRole("Admin"))
                        {
                            <a href="/admin" class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-warning text-white text-sm font-bold">
                                <span class="material-symbols-outlined text-sm">settings</span>
                            </a>
                        }
                    }
                    else
                    {
                        <a href="/login" class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-[#e7edf3] dark:bg-background-dark dark:hover:bg-gray-700 text-[#0d141b] dark:text-slate-50 text-sm font-bold">
                            <span class="truncate">Đăng nhập</span>
                        </a>
                        <a href="/register" class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-primary text-slate-50 text-sm font-bold btn-glow">
                            <span class="truncate">Đăng ký</span>
                        </a>
                    }
                </div>

                <!-- Mobile Menu Button -->
                <button class="md:hidden text-[#0d141b] dark:text-slate-50">
                    <span class="material-symbols-outlined">menu</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="flex flex-col min-h-screen">
        <main class="flex-1">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="w-full py-12 border-t border-[#cfdbe7] dark:border-gray-700 bg-background-light dark:bg-gray-900 mt-16">
            <div class="px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                    <!-- Company Info -->
                    <div class="flex flex-col gap-4">
                        <div class="flex items-center gap-2">
                            <div class="text-primary text-2xl">
                                <span class="material-symbols-outlined">data_usage</span>
                            </div>
                            <h2 class="text-[#0d141b] dark:text-slate-50 text-lg font-bold">Quizly</h2>
                        </div>
                        <p class="text-[#4c739a] dark:text-slate-400 text-sm">Nền tảng thi trắc nghiệm trực tuyến hàng đầu</p>
                    </div>

                    <!-- Quick Links -->
                    <div class="flex flex-col gap-3">
                        <h3 class="text-[#0d141b] dark:text-slate-50 font-bold text-sm">Liên kết nhanh</h3>
                        <a href="/" class="text-[#4c739a] dark:text-slate-400 text-sm hover:text-primary">Trang chủ</a>
                        <a href="/quiz/list" class="text-[#4c739a] dark:text-slate-400 text-sm hover:text-primary">Bộ đề</a>
                        <a href="/blog" class="text-[#4c739a] dark:text-slate-400 text-sm hover:text-primary">Blog</a>
                    </div>

                    <!-- Support -->
                    <div class="flex flex-col gap-3">
                        <h3 class="text-[#0d141b] dark:text-slate-50 font-bold text-sm">Hỗ trợ</h3>
                        <a href="#" class="text-[#4c739a] dark:text-slate-400 text-sm hover:text-primary">Câu hỏi thường gặp</a>
                        <a href="#" class="text-[#4c739a] dark:text-slate-400 text-sm hover:text-primary">Liên hệ</a>
                        <a href="#" class="text-[#4c739a] dark:text-slate-400 text-sm hover:text-primary">Điều khoản</a>
                    </div>

                    <!-- Follow Us -->
                    <div class="flex flex-col gap-3">
                        <h3 class="text-[#0d141b] dark:text-slate-50 font-bold text-sm">Theo dõi</h3>
                        <div class="flex gap-3">
                            <a href="#" class="text-[#4c739a] dark:text-slate-400 hover:text-primary"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="text-[#4c739a] dark:text-slate-400 hover:text-primary"><i class="bi bi-twitter"></i></a>
                            <a href="#" class="text-[#4c739a] dark:text-slate-400 hover:text-primary"><i class="bi bi-linkedin"></i></a>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-8 border-t border-[#cfdbe7] dark:border-gray-700">
                    <p class="text-sm text-[#4c739a] dark:text-slate-400">© 2024 Quizly. All rights reserved.</p>
                    <div class="flex gap-6 text-sm">
                        <a href="#" class="text-[#4c739a] dark:text-slate-400 hover:text-primary">Privacy Policy</a>
                        <a href="#" class="text-[#4c739a] dark:text-slate-400 hover:text-primary">Terms of Service</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/interactions.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
