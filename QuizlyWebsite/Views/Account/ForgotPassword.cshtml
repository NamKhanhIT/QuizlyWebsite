@{
    ViewData["Title"] = "Quên Mật Khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary/10 to-blue-100/10 dark:from-primary/5 dark:to-blue-900/5 px-4">
    <div class="w-full max-w-md">
        <!-- Card -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-xl p-8">
            <!-- Header -->
            <div class="text-center mb-8">
                <h1 class="text-3xl font-black text-primary mb-2">Quên Mật Khẩu</h1>
                <p class="text-[#4c739a] dark:text-slate-400">Nhập email của bạn để nhận link khôi phục mật khẩu</p>
            </div>

            <!-- Success Message -->
            @if (TempData["Success"] != null)
            {
                <div class="bg-success/10 border border-success/30 text-success rounded-lg p-4 mb-6">
                    <p class="text-sm font-semibold">@TempData["Success"]</p>
                </div>
            }

            <!-- Form -->
            <form method="post" action="/forgot-password">
                <!-- Error Messages -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
                {
                    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-3 mb-6">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <p class="text-sm">@error.ErrorMessage</p>
                            }
                        }
                    </div>
                }

                <!-- Email -->
                <div class="mb-6">
                    <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                        <span class="material-symbols-outlined align-middle mr-1 text-primary">email</span>
                        Email
                    </label>
                    <input type="email" name="email" placeholder="Nhập email của bạn" 
                        class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                        required>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="w-full bg-primary text-white font-bold py-3 rounded-lg hover:bg-primary-dark transition transform hover:scale-105 duration-200 shadow-lg hover:shadow-xl">
                    <span class="material-symbols-outlined align-middle mr-2">send</span>
                    Gửi Link Khôi Phục
                </button>
            </form>

            <!-- Back to Login -->
            <div class="text-center mt-6">
                <a href="/login" class="text-sm text-primary hover:underline flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-sm">arrow_back</span>
                    Quay lại đăng nhập
                </a>
            </div>
        </div>

        <!-- Footer Info -->
        <div class="text-center mt-6 text-sm text-[#4c739a] dark:text-slate-400">
            <p>Quizly © 2024 - Nền tảng thi trực tuyến hàng đầu</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add some smooth animations
        document.querySelectorAll('input').forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.classList.add('active');
            });
            input.addEventListener('blur', function() {
                this.parentElement.classList.remove('active');
            });
        });
    </script>
}
