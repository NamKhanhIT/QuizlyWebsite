@{
    ViewData["Title"] = "Đăng Nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary/10 to-blue-100/10 dark:from-primary/5 dark:to-blue-900/5 px-4">
    <div class="w-full max-w-md">
        <!-- Card -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-xl p-8">
            <!-- Header -->
            <div class="text-center mb-8">
                <h1 class="text-4xl font-black text-primary mb-2">Quizly</h1>
                <p class="text-[#4c739a] dark:text-slate-400">Đăng nhập vào tài khoản của bạn</p>
            </div>

            <!-- Form -->
            <form method="post" action="/login">
                <!-- Error Messages -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
                {
                    <div class="bg-danger/10 border border-danger/30 text-danger rounded-lg p-3 mb-6">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <p class="text-sm">@error.ErrorMessage</p>
                            }
                        }
                    </div>
                }

                <!-- Username -->
                <div class="mb-6">
                    <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                        <span class="material-symbols-outlined align-middle mr-1 text-primary">person</span>
                        Tên Đăng Nhập
                    </label>
                    <input type="text" name="username" placeholder="Nhập tên đăng nhập" 
                        class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                        required>
                </div>

                <!-- Password -->
                <div class="mb-6">
                    <label class="block text-sm font-semibold text-[#0d141b] dark:text-slate-50 mb-2">
                        <span class="material-symbols-outlined align-middle mr-1 text-primary">lock</span>
                        Mật Khẩu
                    </label>
                    <input type="password" name="password" placeholder="Nhập mật khẩu" 
                        class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:text-slate-50 transition"
                        required>
                </div>

                <!-- Remember Me -->
                <div class="mb-6">
                    <label class="flex items-center gap-2 text-sm text-[#4c739a] dark:text-slate-400">
                        <input type="checkbox" name="rememberMe" class="w-4 h-4 rounded">
                        Ghi nhớ tôi
                    </label>
                </div>

                <!-- Login Button -->
                <button type="submit" class="w-full bg-primary text-white font-bold py-3 rounded-lg hover:bg-primary-dark transition transform hover:scale-105 duration-200 shadow-lg hover:shadow-xl">
                    <span class="material-symbols-outlined align-middle mr-2">login</span>
                    Đăng Nhập
                </button>
            </form>

            <!-- Divider -->
            <div class="my-6 flex items-center">
                <div class="flex-1 border-t border-gray-300 dark:border-gray-600"></div>
                <span class="px-3 text-sm text-[#4c739a] dark:text-slate-400">hoặc</span>
                <div class="flex-1 border-t border-gray-300 dark:border-gray-600"></div>
            </div>

            <!-- Register Link -->
            <a href="/account/register" class="block w-full border-2 border-primary text-primary font-bold py-3 rounded-lg hover:bg-primary/10 transition text-center">
                <span class="material-symbols-outlined align-middle mr-2">person_add</span>
                Đăng Ký Tài Khoản Mới
            </a>

            <!-- Forgot Password Link -->
            <div class="text-center mt-4">
                <a href="#" class="text-sm text-primary hover:underline">Quên mật khẩu?</a>
            </div>
        </div>

        <!-- Footer Info -->
        <div class="text-center mt-6 text-sm text-[#4c739a] dark:text-slate-400">
            <p>Quizly © 2024 - Nền tảng thi trực tuyến hàng đầu</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add some smooth animations
        document.querySelectorAll('input').forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.classList.add('active');
            });
            input.addEventListener('blur', function() {
                this.parentElement.classList.remove('active');
            });
        });
    </script>
}
